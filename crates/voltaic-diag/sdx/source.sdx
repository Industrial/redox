export type Span = (usize, usize)

export const VERSION : u32 = 1

export data Origin = Origin { export span : Span, export src_line : usize, export src_col : usize, export gen_col : usize }
  deriving (Debug, Clone, Copy, PartialEq, Eq)

instance Origin
  export map_col : &self -> usize -> usize
  map_col self gen_col = self.src_col + .saturating_sub self.gen_col gen_col

export data SourceMap = SourceMap { export source_path : String, origins : Vec<Option<Origin>> }
  deriving (Debug, Clone, Default, PartialEq, Eq)

instance SourceMap
  export new : impl Into<String> -> Vec<Option<Origin>> -> Self
  new source_path origins = SourceMap { source_path = .into source_path, origins }

  export len : &self -> usize
  len self = .len self.origins

  export is_empty : &self -> bool
  is_empty self = .is_empty self.origins

  export origin : &self -> usize -> Option<&Origin>
  origin self gen_line =
    at = (.checked_sub 1 gen_line)?
    slot = (.get at self.origins)?
    .as_ref slot

  export resolve : &self -> usize -> usize -> Option<(usize, usize)>
  resolve self gen_line gen_col = do .map
    found <- .origin gen_line self
    (found.src_line, .map_col gen_col found)

  export synthetic_lines : &self -> Vec<usize>
  synthetic_lines self = self.origins
    |> .iter
    |> .enumerate
    |> .filter (\pair -> .is_none pair.1)
    |> .map (\pair -> pair.0 + 1)
    |> .collect

export render_map : &SourceMap -> String
render_map map =
  rows : Vec<String> = 1 ..= .len map
    |> .map (\n -> case .origin n map of
    Some o -> format! \-> "#{n} #{o.src_line} #{o.src_col} #{o.gen_col}\n"
    None -> format! \-> "#{n} -\n")
    |> .collect
  format! \-> "voltaic-map #{VERSION} #{map.source_path}\n#{(.concat rows)}"

export parse_map : &str -> Result<SourceMap, String>
parse_map text =
  mut lines = .lines text
  header = (.ok_or "the map is empty" (.next lines))?
  mut parts = .split ' ' header
  if .next parts != Some "voltaic-map"
    return Err (.to_string "not a Voltaic source map: the header does not begin `voltaic-map`")
  raw = (.ok_or "the map header has no version" (.next parts))?
  parsed_version : Result<u32, _> = .parse raw
  version = (.map_err (\_ -> .to_string "the map header's version is not a number") parsed_version)?
  if version != VERSION
    return Err (format! \-> "this map is version #{version}; this Voltaic writes version #{VERSION}")
  collected : Vec<&str> = .collect parts
  source_path = .join " " collected
  if .is_empty source_path
    return Err (.to_string "the map header names no source file")
  mut origins = Vec::new ()
  for pair in .enumerate lines
    i = pair.0
    line = pair.1
    if .is_empty line
      continue
    fields : Vec<&str> = line |> .split ' ' |> .collect
    expected = i + 1
    gen_line : usize = (fields
      |> .first
      |> .and_then (\f -> .ok (.parse f))
      |> .ok_or (format! \-> "record #{expected} does not begin with a line number"))?
    if gen_line != expected
      return Err (format! \-> "record #{expected} claims to be line #{gen_line}; the records must be in order with no gaps")
    case .as_slice fields of
      [_, "-"] -> .push None origins
      [_, src_line, src_col, gen_col] ->
        parsed_src_line : Result<usize, _> = .parse src_line
        parsed_src_col : Result<usize, _> = .parse src_col
        parsed_gen_col : Result<usize, _> = .parse gen_col
        origin = Origin { span = (0, 0), src_line = (.map_err (\_ -> format! \-> "record #{expected}'s source line is not a number") parsed_src_line)?, src_col = (.map_err (\_ -> format! \-> "record #{expected}'s source column is not a number") parsed_src_col)?, gen_col = (.map_err (\_ -> format! \-> "record #{expected}'s generated column is not a number") parsed_gen_col)? }
        if origin.src_line == 0 || origin.src_col == 0 || origin.gen_col == 0
          return Err (format! \-> "record #{expected} has a zero line or column; both are 1-based")
        .push (Some origin) origins
      _ ->
        return Err (format! \-> "record #{expected} has #{(.len fields)} fields; expected 2 (`n -`) or 4 (`n src_line src_col gen_col`)")
  Ok $ SourceMap::new source_path origins

#[cfg(test)]
sample_origin : Origin
sample_origin = Origin { span = (10, 15), src_line = 2, src_col = 3, gen_col = 5 }

#[cfg(test)]
sample_map : SourceMap
sample_map = SourceMap::new "a.sdx" (vec! \-> Some (Origin { span = (0, 5), src_line = 1, src_col = 1, gen_col = 1 }) \-> None \-> Some (Origin { span = (10, 15), src_line = 2, src_col = 3, gen_col = 5 }))

#[cfg(test)]
sample : SourceMap
sample = SourceMap::new "examples/phase1.sdx" (vec! \-> Some (Origin { span = (0, 0), src_line = 1, src_col = 1, gen_col = 4 }) \-> None \-> Some (Origin { span = (0, 0), src_line = 2, src_col = 3, gen_col = 5 }))

test "shifts a column by the indentation difference"
  assert_eq! \-> .map_col 5 (sample_origin ()) \-> 3 \-> "the first character"
  assert_eq! \-> .map_col 9 (sample_origin ()) \-> 7 \-> "four characters in"

test "floors at the construct's first column"
  assert_eq! \-> .map_col 1 (sample_origin ()) \-> 3
  assert_eq! \-> .map_col 4 (sample_origin ()) \-> 3

test "resolves a mapped line"
  assert_eq! \-> .resolve 3 7 (sample_map ()) \-> Some (2, 5)

test "declines a synthetic line"
  assert_eq! \-> .resolve 2 1 (sample_map ()) \-> None

test "declines a line past the end"
  assert_eq! \-> .resolve 99 1 (sample_map ()) \-> None

test "declines line zero"
  assert_eq! \-> .resolve 0 1 (sample_map ()) \-> None

test "reports its synthetic lines"
  assert_eq! \-> .synthetic_lines (sample_map ()) \-> vec! \-> 2
  assert_eq! \-> .len (sample_map ()) \-> 3

test "round trips"
  text = render_map $ &sample ()
  assert_eq! \-> .expect "should parse" (parse_map (&text)) \-> sample ()

test "rejects a foreign file"
  err = .expect_err "should fail" $ parse_map "{\"version\":3}\n"
  assert! \-> .contains "does not begin" err \-> "#{err}"

test "rejects a future version"
  err = .expect_err "should fail" $ parse_map "voltaic-map 99 a.sdx\n"
  assert! \-> .contains "version 99" err \-> "#{err}"

test "rejects a header with no source"
  err = .expect_err "should fail" $ parse_map "voltaic-map 1\n"
  assert! \-> .contains "names no source" err \-> "#{err}"

test "rejects records out of order"
  err = .expect_err "should fail" $ parse_map "voltaic-map 1 a.sdx\n1 1 1 1\n3 2 1 1\n"
  assert! \-> .contains "must be in order" err \-> "#{err}"

test "rejects a malformed record"
  err = .expect_err "should fail" $ parse_map "voltaic-map 1 a.sdx\n1 2 3\n"
  assert! \-> .contains "3 fields" err \-> "#{err}"

test "rejects a zero column"
  err = .expect_err "should fail" $ parse_map "voltaic-map 1 a.sdx\n1 1 0 1\n"
  assert! \-> .contains "1-based" err \-> "#{err}"

test "parses a map with no records"
  map = .expect "should parse" $ parse_map "voltaic-map 1 a.sdx\n"
  assert! \-> .is_empty map
  assert_eq! \-> map.source_path \-> "a.sdx"
