-- A string literal must survive into the generated Rust meaning what it meant
-- here. Two cases the run corpus caught the emitter getting wrong:
--
--   - `\#` is Voltaic's one escape that Rust does not have (it escapes the `#`
--     that would open an interpolation). The raw text was reaching rustc,
--     which rejects `\#`.
--   - a literal passed to `print` becomes a `println!` *format string*, so a
--     brace in it was being read as a placeholder naming a variable.
--
-- Interpolation itself is a later plan; until then `#{...}` is literal text,
-- and this case pins that it is literal text that *compiles*.
main : ()
main =
  println! \-> "a\tb"  -- a real tab, decoded by Voltaic and re-encoded
  println! \-> "brace: \#{"  -- prints `brace: #{`
  println! \-> "see {this}"  -- prints `see {this}`, not a format placeholder
  println! \-> "100% of {n} done"  -- both hazards at once
  ()
