import std::process::ExitCode

module build_command
module fmt_command
module run
module watch_command

main : ExitCode
main =
  args : Vec<String> = std::env::args () |> .skip 1 |> .collect
  case run::run (&args) of
    Ok () -> ExitCode::SUCCESS
    Err message ->
      eprintln! \-> "#{message}"
      ExitCode::FAILURE
