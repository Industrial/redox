  -- A leading comment, on its own line.

  -- | A doc comment, and below it an attribute.
  #[inline]
  n = 0
  -- A local binding's type takes **one** colon; `::` is the ascription
  -- operator and the separator a `const` item uses.
  mut total : i32 = 1
  total += 2
  print "x"  -- a trailing comment
  {- a fenced comment -}
  if n > 0 && Some v = o
    print "both"
  else if n < 0
    print "negative"
  else
    print "zero"
  while n < 3
    total += 1
  until n > 5 && n % 2 == 0
    total += 1
  'outer loop
    for d in 1 .. 9
      total += 1
      if d > 2
        break 'outer
      continue 'outer
  for c in 1 .. 4
    print c
  guard Some v = o else
    return 0
  assert total > 0
  kind = case o of
    Some 1 or Some 2 -> "small"
    Some v | v > 9 -> "big"
    _ -> "none"
  nested = 'search
    for c in 1 .. 20
      break 'search c
    0
  plain =
    inner = n * 2
    inner + 1
  branch =
    if n > 0
      "pos"
    else
      "neg"
  print kind
  print nested
  print plain
  print branch
  with drawn = o
  total
