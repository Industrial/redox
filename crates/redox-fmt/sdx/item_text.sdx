-- | A `class` declaration and its members.
export(crate) module class_text
-- | One equation, or a guard ladder, with its `where`.
export(crate) module clause_text
-- | A `const` or `static` item.
export(crate) module const_text
-- | One `data` alternative — `Click`, `Meters f64`, `Square { side : f64 }`.
export(crate) module constructor_text
-- | A `data` or `newtype` declaration, with its `deriving` clause.
export(crate) module data_text
-- | An `errors` declaration — a table of variants and their messages.
export(crate) module errors_text
-- | A function — its signature line, then one line per equation.
export(crate) module fn_text
-- | An `instance` declaration and its members.
export(crate) module instance_text
-- | An item's leading trivia, as complete lines — or nothing.
export(crate) module leading_text
-- | One member of a `class` or `instance`.
export(crate) module member_text
-- | Whether two byte offsets fall on the same source line.
export(crate) module same_line
-- | A function's signature line, verbatim from the source.
export(crate) module signature_line
-- | A visibility marker, with its trailing space — or nothing.
export(crate) module visibility_text

import crate::item_text::class_text::class_text
import crate::item_text::const_text::const_text
import crate::item_text::data_text::data_text
import crate::item_text::errors_text::errors_text
import crate::item_text::fn_text::fn_text
import crate::item_text::instance_text::instance_text
import crate::item_text::leading_text::leading_text
import crate::item_text::visibility_text::visibility_text
import crate::stmt_text::block_text::block_text
import crate::stmt_text::indent_text::indent_text
import redox_ast::Item

-- | One item in canonical Redox, with its leading trivia — plan 34, leaf 2.
-- |
-- | `indent` is the item's depth: 0 at the top of a file, deeper inside a
-- | `module`. Leaf 4's `indent_text` is the only place a level becomes spaces.
-- |
-- | # `export`, not `pub`
-- |
-- | `Visibility::rust_text` gives `pub `, `pub(crate) ` and so on. Redox spells
-- | the same thing `export` and `export(crate)`, which is why
-- | `visibility_text` exists beside it rather than reusing it — the third
-- | printer in this plan to need a Redox spelling where the AST held only the
-- | Rust one.
-- |
-- | # A function's signature is sliced, and that is a recorded defect
-- |
-- | Every item here is printed from the tree except a function's **signature
-- | line**, which is sliced verbatim out of the source. The reason is in §10:
-- | `parser::generalise` rewrites a signature's types in place, replacing each
-- | type variable with its uppercase Rust spelling, so the AST no longer knows
-- | the author wrote `Ord t => Option<t> -> t` rather than
-- | `Ord T => Option<T> -> T`. Printing from it would rewrite every generic
-- | signature in the corpus into Rust's convention, which is the opposite of
-- | doc 18 §5.3's surface.
-- |
-- | Criterion 7 exists for exactly this, so the slice is correct rather than a
-- | shortcut — but it does mean the formatter cannot normalise a signature's
-- | spacing, and the fix is a change to the AST, not to this file.
export item_text : &Item -> usize -> &str -> String
item_text item indent source =
  mut out = leading_text item indent
  .push_str (&indent_text indent) out
  -- Bound, where the Rust wrote `out.push_str(&match item { … })`. The
  -- `case` then has to be piped into the push rather than dotted onto it,
  -- for the reason `format.sdx` records: a binding whose value is a block
  -- swallows a following statement that opens with `.name`.
  body = case item of
    Item::Fn decl -> fn_text decl indent source
    Item::Data decl -> data_text decl indent source
    Item::Type decl -> format! \-> "#{(visibility_text (&decl.visibility))}type #{decl.name.text} = #{decl.ty.text}"
    Item::Class decl -> class_text decl indent source
    Item::Instance decl -> instance_text decl indent source
    Item::Errors decl -> errors_text decl indent
    Item::Test decl -> format! \-> "test #{decl.description}\n#{(block_text (&decl.body) (indent + 1) source)}"
    Item::Import decl ->
      alias = decl.alias
        |> .as_ref
        |> .map_or (String::new ()) (\name -> format! \-> " as #{name.text}")
      format! \-> "#{(visibility_text (&decl.visibility))}import #{decl.path}#{alias}"
    Item::Module decl ->
      header = format! \-> "#{(visibility_text (&decl.visibility))}module #{decl.name.text}"
      case &decl.items of
        None -> header
        Some items ->
          printed : Vec<String> = items
            |> .iter
            |> .map (\inner -> item_text inner (indent + 1) source)
            |> .collect
          format! \-> "#{header}\n#{(.join "\n" printed)}"
    Item::Const decl -> const_text decl source
    Item::InlineRust decl ->
      body : String = decl.code
        |> .lines
        |> .map (\line ->
        if .is_empty (.trim line)
          String::from "\n"
        else
          format! \-> "#{(indent_text (indent + 1))}#{line}\n")
        |> .collect
      format! \-> "rust \"\"\"\n#{body}#{(indent_text indent)}\"\"\""
    Item::Extern decl ->
      body : String = decl.decls
        |> .iter
        |> .map (\d -> format! \-> "#{(indent_text (indent + 1))}#{(.trim source[d.span.0..d.span.1])}\n")
        |> .collect
      format! \-> "extern #{decl.abi}\n#{(.trim_end body)}"
  out |> .push_str (&body)
  out
