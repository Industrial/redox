import redox_ast::Expr

-- | How tightly this expression binds, or `None` if the question does not apply
-- | to it.
-- |
-- | `None` is not "loosest" — it means *this leaf declines to reason about the
-- | form*, and every caller treats a decline as "keep the parentheses". That
-- | asymmetry is the whole safety argument for §3 row 3: the only normalisation
-- | in plan 34 that can change what a program means is dropping a parenthesis,
-- | so the default has to be not to.
-- |
-- | # Which forms get a number
-- |
-- | - A binary expression binds at its operator's power, which is
-- |   `BinaryOp::power` — **the** precedence table, now on the operator rather
-- |   than in the parser so that the parser and this leaf cannot drift apart.
-- | - Application, postfix and the bracketed literals bind tighter than any
-- |   binary operator, so they get `u8::MAX`: a parenthesis around one of them
-- |   is never needed to hold a binary expression together.
-- |
-- | # Which forms decline
-- |
-- | Lambdas, `if` and `case` as expressions, and ascriptions. Each of those
-- | *ends* at a place that depends on what follows it — a lambda body extends as
-- | far right as it can, an ascription's type swallows what comes next — so a
-- | surrounding parenthesis is doing real work even when a precedence table
-- | would say otherwise.
-- |
-- | # Sections, records and comprehensions are **not** in that list
-- |
-- | This comment used to say sections decline, and it was wrong for long enough
-- | to mislead a reader: plan 57's orientation quoted it as the behaviour and
-- | had to be corrected against line 72 below, which gives all three
-- | `Some(u8::MAX)`.
-- |
-- | They are self-delimiting. A section's parentheses are part of **its own**
-- | syntax — `(+ 1)` parses straight to `Expr::Section` with no `Paren` node
-- | around it — so `can_drop_paren` is never asked whether a bare section's
-- | brackets may go, and `u8::MAX` only ever answers for one nested inside
-- | *another* parenthesis, where dropping the outer pair is right. The same
-- | holds for `{…}` and a comprehension's `[…]`.
export(crate) power_of : &Expr -> Option<u8>
power_of expr = case expr of
  Expr::Binary { op, .. } -> Some (.power op)
  -- Plan 90: the same answer, from the node rather than the operator. A user
  -- operator's left power is `Fixity::powers`', which is always even and so
  -- never collides with a built-in rung — see that function's interleave
  -- table.
  Expr::UserBinary { fixity, precedence, .. } ->
    powers = .powers (*precedence) (*fixity)
    Some powers.0
  Expr::Call { is_dollar = true, .. } -> Some 0
  Expr::Call { .. } -> Some u8::MAX
  Expr::MacroCall { .. } or Expr::RustHatch { .. } -> Some u8::MAX
  Expr::Field { .. } or Expr::Index { .. } or Expr::Unary { .. } or Expr::Try { .. } or Expr::MethodRef { .. } -> Some u8::MAX
  Expr::Path { .. } or Expr::Ident _ or Expr::SelfField { .. } or Expr::SelfType { .. } -> Some u8::MAX
  Expr::StrLit { .. } or Expr::StrInterp { .. } or Expr::RawLit { .. } or Expr::Num { .. } or Expr::Bool { .. } or Expr::Char { .. } -> Some u8::MAX
  Expr::Tuple { .. } or Expr::List { .. } or Expr::ArrayRepeat { .. } or Expr::Unit { .. } -> Some u8::MAX
  Expr::Paren { inner, .. } -> power_of inner
  Expr::Record { .. } or Expr::Comprehension { .. } or Expr::Section { .. } -> Some u8::MAX
  Expr::Lambda { .. } or Expr::Ascribe { .. } or Expr::If { .. } or Expr::Block { .. } or Expr::Case { .. } or Expr::AsyncBlock { .. } or Expr::UnsafeBlock { .. } or Expr::TryBlock { .. } or Expr::BindBlock { .. } -> None
  Expr::Binding _ or Expr::Item { .. } or Expr::Return { .. } or Expr::Draw { .. } or Expr::Await { .. } or Expr::Assign { .. } or Expr::Over { .. } -> None
  Expr::Guard { .. } or Expr::While { .. } or Expr::For { .. } or Expr::Loop { .. } or Expr::Break { .. } or Expr::Continue { .. } -> None
