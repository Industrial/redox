import crate::ParseError
import crate::parse::parser::walk_item_for_tails::walk_item_for_tails
import redox_ast::Program

-- | Report `RDX0044` for every `return` in a draw arrow's tail — doc 03 §7.6,
-- | plan 30.
-- |
-- | A **whole-program pass**, run once after parsing, rather than a check
-- | inside the block parser. `return_in_tail` already recurses into the blocks
-- | a statement owns, so running it per block would report a nested tail's
-- | `return` twice: once from the inner block's own call and once from the
-- | outer block descending into it. One entry point per function body is the
-- | shape that cannot double-report.
-- |
-- | It walks every item that holds statements — a function's clauses and their
-- | `where` bindings, a class's and instance's members, a `test` body, and a
-- | `module`'s items, recursively. `Data`, `Type`, `Errors`, `Import` and
-- | `Const` hold no statement blocks, so they are skipped by construction
-- | rather than by a wildcard.
export(crate) check_callback_tails : &Program -> Vec<ParseError>
check_callback_tails program =
  mut found = Vec::new ()
  for item in &program.items
    walk_item_for_tails item (&mut found)
  found
