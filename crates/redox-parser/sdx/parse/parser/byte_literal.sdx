-- | A `b'x'` literal's Rust text, from the decoded byte — plan 23.
-- |
-- | The lexer decodes `b'x'` to `120`, so re-emitting it means choosing a
-- | spelling. A printable ASCII byte takes its character; anything else takes
-- | `b'\xNN'`, which is the only form that round-trips every byte and is what
-- | rustc itself prints.
-- |
-- | `\xNN` is used rather than `\n` and friends even where a named escape
-- | exists, because one rule for every non-printable byte cannot disagree with
-- | itself, and `b'\x0A'` and `b'\n'` are the same byte to rustc.
export(crate) byte_literal : u8 -> String
byte_literal value = case value of
  b'\\' -> .to_string "b'\\\\'"
  b'\'' -> .to_string "b'\\''"
  0x20..=0x7E -> format! \-> "b'#{char::from value}'"
  _ -> format! \-> "b'\\x#{value:02X}'"
