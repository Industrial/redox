import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::capture_type::capture_type
import crate::parse::parser::field_decl::field_decl
import crate::parse::parser::starts_a_field_type::starts_a_field_type
import crate::parse::parser::type_stop::TypeStop
import redox_ast::ConstructorFields
import redox_lexer::TokenKind

-- | What follows a constructor's name — doc 18 §2.4.
-- |
-- | Braces open a record; a type-leading token opens a tuple; a line break,
-- | `|` or a dedent means the constructor is a unit.
-- |
-- | The tuple case reads its field types by **juxtaposition**, which is doc 18
-- | §2.1's reading everywhere else — so `Key char` needs no notation of its
-- | own, and `Pair i32 i32` falls out. `capture_type` already knows where one
-- | type ends, which is the whole of what makes this work.
export(crate) constructor_fields : &mut Parser -> Result<ConstructorFields, ParseError>
constructor_fields p =
  if .check (&TokenKind::LBrace) p
    .advance p
    mut fields = Vec::new ()
    loop
      .skip_layout p
      if .check (&TokenKind::RBrace) p
        break
      .push (field_decl p)? fields
      .skip_layout p
      if !.check (&TokenKind::Comma) p
        break
      .advance p
    .skip_layout p
    (.expect (&TokenKind::RBrace) "expected `}` to close the record" p)?
    return Ok (ConstructorFields::Record fields)
  mut types = Vec::new ()
  while starts_a_field_type (&(.peek p).kind)
    .push (capture_type p "expected a field type" TypeStop::Atom)? types
  if .is_empty types
    return Ok ConstructorFields::Unit
  Ok $ ConstructorFields::Tuple types
