import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::instance_decl::instance_decl
import redox_ast::DeriveTemplate
import redox_diag::Code
import redox_lexer::{Keyword, TokenKind, Trivia}

-- | `deriving template Forward` and its indented `instance` body — plan 89.
-- |
-- | ```text
-- | deriving template Forward
-- |   instance Display Target
-- |     fmt : &self -> &mut fmt::Formatter -> fmt::Result
-- |     fmt self f = Display::fmt (&self.Field0) f
-- | ```
-- |
-- | **`template` is contextual**, read as an ordinary identifier after the
-- | `deriving` keyword. Reserving it would collide the way `pattern` did at
-- | plan 87 §10.4 — and it does not need to, because `deriving` is already a
-- | keyword and nothing else can follow it at item position.
-- |
-- | # The body is an ordinary `instance`
-- |
-- | Plan 89's §1.2 specified `$Type` and `$field0`, and `$` is the application
-- | operator — so a body containing it does not parse at all. The placeholders
-- | are **reserved upper-case names** instead, `Target` and `Field0`…, which
-- | leaves the body an ordinary [`instance_decl`] parsed here once. Every
-- | existing `instance` path then applies to it unchanged, and the substitution
-- | is textual on the *emitted Rust* rather than a walk over `Expr`'s
-- | forty-six forms.
-- |
-- | The body must mention `Target`, and that is checked: a template whose
-- | `instance` head names a concrete type is not a template, it is an
-- | `instance` written in the wrong place, and `RDX0122` says so.
export(crate) derive_template : &mut Parser -> Vec<Trivia> -> usize -> Result<DeriveTemplate, ParseError>
derive_template p leading start =
  (.expect (&TokenKind::Kw Keyword::Deriving) "expected `deriving`" p)?
  -- The contextual word, read as an ordinary identifier and then **checked**.
  -- Reading it without checking would accept `deriving Forward` at item
  -- position, which is a misindented derive clause — the one mistake this
  -- branch is reachable by — and report it against the `instance` that is not
  -- there instead of against the line the author wrote.
  word = (.ident "expected `template` after `deriving`" p)?
  if word.text != "template"
    return Err $ ParseError::with_help Code::DeriveTemplateShape "expected `template` after `deriving`" "a `deriving` clause belongs indented under its declaration — `newtype Meters = Meters f64` then `deriving (Debug)`. At item position `deriving` begins a template: `deriving template Forward`" word.span
  name = (.ident "expected a name for the deriving template" p)?
  (.newline_with_trailing "expected a line break after the template's name" p)?
  (.expect (&TokenKind::Indent) "expected an indented `instance` as the template's body" p)?
  body = (instance_decl p (Vec::new ()) (.peek_span p).0)?
  .skip_separators p
  (.expect (&TokenKind::Dedent) "expected the template's body to end" p)?
  -- `Target` is what makes it a template. Checked on the head's own text, which
  -- is `TypeApp::head` for the implementing type — the last name in the head
  -- (plan 67 §9 decision 3).
  if body.target.head.text != "Target"
    return Err $ ParseError::with_help Code::DeriveTemplateShape "a deriving template's `instance` must be for `Target`" "`Target` is the placeholder the declaration's own type name is substituted for — `instance Display Target`. An `instance` for a concrete type is not a template and belongs at module scope" body.target.head.span
  Ok (DeriveTemplate { name, body, span = (start, (.prev_span p).1), leading })
