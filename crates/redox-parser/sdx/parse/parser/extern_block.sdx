import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::parse_spine::parse_spine
import crate::parse::parser::signature_only::signature_only
import redox_ast::{ExternBlock, ForeignFn}
import redox_lexer::{Keyword, TokenKind, Trivia}

-- | `extern "C"` and its indented declarations — plan 45 leaf 3.
-- |
-- | ```text
-- | extern "C"
-- |   abs : i32 -> i32
-- | ```
-- |
-- | Doc 01 §26 names FFI as a requirement and doc 03 §23 item 2 rules out the
-- | escape hatch for it, so this is the one leaf of plan 45 the specification
-- | asks for by name.
-- |
-- | The declarations are **signatures with no equation**, which is doc 18
-- | §2.5's required method exactly — so `signature_only` is reused rather than
-- | reimplemented, and a foreign parameter gets the generated name doc 02
-- | reserves for a row that has none.
-- |
-- | The ABI is any string literal. Redox keeps no list of ABIs and checks
-- | nothing about it: an ABI Rust does not know is rustc's to reject, which is
-- | AGENTS.md's every-check-rustc-makes rule and the reason this function is as
-- | short as it is.
export(crate) extern_block : &mut Parser -> Vec<Trivia> -> usize -> Result<ExternBlock, ParseError>
extern_block p leading start =
  (.expect (&TokenKind::Kw Keyword::Extern) "expected `extern`" p)?
  abi = case &(.peek p).kind of
    TokenKind::Str { raw, .. } -> .clone raw
    _ ->
      return Err (ParseError::expected "expected an ABI string after `extern`, as in `extern \"C\"`" (.peek_span p))
  .advance p
  (.newline_with_trailing "expected a line break after the ABI" p)?
  mut decls = Vec::new ()
  (.expect (&TokenKind::Indent) "expected indented `extern` declarations" p)?
  loop
    .skip_separators p
    if .check (&TokenKind::Dedent) p || .at_eof p
      break
    decl_leading = .peek_leading p
    decl_start = (.peek_span p).0
    name = (.ident "expected a foreign function's name" p)?
    (.expect (&TokenKind::Colon) "expected `:` after the foreign function's name" p)?
    spine = (parse_spine p)?
    span = (decl_start, (.prev_span p).1)
    .push (ForeignFn { name, sig = signature_only (&spine) span, span, leading = decl_leading }) decls
    (.newline_with_trailing "expected a line break after the declaration" p)?
  (.expect (&TokenKind::Dedent) "expected the `extern` block to end" p)?
  Ok (ExternBlock { abi, decls, span = (start, (.prev_span p).1), leading })
