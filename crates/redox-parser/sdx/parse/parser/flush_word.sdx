-- | Append a pending identifier run to `out`, substituted if it is the type
-- | variable — the inner step of `rewritten`.
export(crate) flush_word : &mut String -> &mut String -> &str -> &str -> ()
flush_word out word var subject =
  if .is_empty word
    return ()
  if word == var
    .push_str subject out
  else
    .push_str word out
  .clear word
  ()
