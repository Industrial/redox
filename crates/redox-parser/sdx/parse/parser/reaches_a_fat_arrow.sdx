import crate::parse::parser::Parser
import redox_lexer::{Span, TokenKind}

-- | The span of a `=>` at depth zero before this declaration's head ends.
-- |
-- | Plan 84 (`docs/78 - 84 - The Binder Escape Hatch.md`) leaf 1a. `constraints`
-- | reads the bound clause **speculatively** and rewinds if no `=>` arrives,
-- | which is what lets `class Shape t` and `class Debug t => Shape t` begin
-- | identically. The rewind was silent, so a `=>` the clause could not read was
-- | swallowed into the first parameter's verbatim type and reached the `.xrs`
-- | as `TokenKind::FatArrow`'s own Debug name:
-- |
-- | ```text
-- | shout : Into<String> t => t -> String
-- | ->  fn shout<T>(x: Into<String> T FatArrow T) -> String
-- | ```
-- |
-- | This is how `constraints` tells the two apart. **A rewind with no `=>`
-- | ahead is the ordinary unconstrained declaration; a rewind with one is a
-- | bound clause the author wrote and the parser could not read**, which is
-- | `RDX0120`.
-- |
-- | Written as a sibling of [`reaches_a_draw_arrow`] and with its depth count,
-- | for the same reason: a `=>` inside brackets belongs to something nested.
-- | It returns the span rather than a `bool` because the diagnostic points at
-- | the `=>` the author wrote, which is the one token they can see is being
-- | refused.
-- |
-- | [`reaches_a_draw_arrow`]: crate::parse::parser::reaches_a_draw_arrow::reaches_a_draw_arrow
export(crate) reaches_a_fat_arrow : &Parser -> Option<Span>
reaches_a_fat_arrow p =
  mut depth : i32 = 0
  mut i = 0
  while .peek_at i p is Some tok
    case &tok.kind of
      TokenKind::FatArrow | depth == 0 ->
        return Some tok.span
      TokenKind::LParen or TokenKind::LBracket or TokenKind::LBrace -> depth += 1
      TokenKind::RParen or TokenKind::RBracket or TokenKind::RBrace ->
        depth -= 1
        if depth < 0
          return None
      -- An `=` at depth zero is an equation, so the head is over. A signature
      -- line holds none, and this is the bound that keeps the scan inside the
      -- declaration it was asked about.
      TokenKind::Eq | depth == 0 ->
        return None
      TokenKind::Newline or TokenKind::Indent or TokenKind::Dedent or TokenKind::Eof ->
        return None
      _ -> ()
    i += 1
  None
