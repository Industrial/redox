import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::capture_type::capture_type
import crate::parse::parser::type_stop::TypeStop
import crate::parse::parser::visibility::visibility
import redox_ast::FieldDecl
import redox_lexer::TokenKind

-- | One `name : Type` field of a record constructor — doc 18 §2.4.
-- |
-- | The same `:` as a signature line, a lambda binder and an ascription (plan
-- | 52, which replaced doc 18 §5.2's spaced `::` with one token). One notation
-- | for "this has this type", in every position — and the reason records use
-- | `=` for *values*: `:` introduces a type, `=` introduces a value, in a
-- | declaration and a literal alike.
export(crate) field_decl : &mut Parser -> Result<FieldDecl, ParseError>
field_decl p =
  start = (.peek_span p).0
  -- Plan 48 leaf 2. Read before the visibility marker, as an item's trivia
  -- is: a `--- doc` on a field attaches to the first token of the field, and
  -- that is the marker when there is one.
  leading = .peek_leading p
  -- §9.6: "Per-field and per-variant visibility use the same markers inside
  -- a declaration body."
  --
  -- `marker`, not a rebinding of the imported `visibility`: `RDX1003` reports
  -- a shadow.
  marker = (visibility p)?
  name = (.ident "expected a field name" p)?
  (.expect (&TokenKind::Colon) "expected `:` after the field name" p)?
  ty = (capture_type p "expected a field type" TypeStop::Greedy)?
  Ok (FieldDecl { name, ty, visibility = marker, leading, span = (start, (.prev_span p).1) })
