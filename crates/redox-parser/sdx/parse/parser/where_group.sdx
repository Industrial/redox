import crate::ParseError
import redox_ast::{Expr, Pattern, Stmt, where_cycle}
import redox_diag::Code

-- | Check a `where` group against the three things plan 61 makes it promise.
-- |
-- | A group is a **set of definitions**, which is the row's whole premise and
-- | the reason it can be sorted at all. Each refusal below is a statement of
-- | what the construct *is* rather than a restriction added to it.
-- |
-- | # 1. An entry defines a name
-- |
-- | §11.2's decision, and it corrects §6 of the plan: `Clause.wheres` is a
-- | `Vec<Stmt>` and `where_locals` pushed `self.stmt()`, so a group could hold
-- | `print x`, an assignment binding no name, or anything else a statement can
-- | be. An entry with an **effect** has no defined position in a set, so a sort
-- | that moved it would be reordering side effects — exactly doc 02 §5.2's
-- | worst failure mode, and the one §11.3 invokes to justify refusing the
-- | parameter shadow. Taking it here and refusing it there would be
-- | incoherent.
-- |
-- | This also disposes of the third option nobody proposed in writing: keeping
-- | source order for the whole group whenever any entry is non-binding would
-- | make the sort depend on the *presence of a `print`*, so adding one would
-- | silently change the generated order of everything around it.
-- |
-- | # 2. An entry does not shadow a parameter
-- |
-- | §11.3, measured on a program that compiles today:
-- |
-- | ```text
-- | h base = scaled            fn h(base: u64) -> u64 {
-- |   where                        let scaled = base * 2;   // the parameter
-- |     scaled = base * 2          let base = 100;
-- |     base = 100                 scaled
-- |                            }
-- | ```
-- |
-- | `h 3` is **6**. Treat `base` as an edge and the sort emits `let base =
-- | 100; let scaled = base * 2;` — **200**, valid Rust, no diagnostic. So
-- | §1.2's *"it cannot be wrong about scope, because the group **is** the
-- | scope"* does not survive shadowing: Rust `let`s are sequential, and a
-- | reference's meaning depends on its position. Refusing the shadow is the
-- | alternative to an unsound sort.
-- |
-- | # 3. A parameterless cycle is an error
-- |
-- | §1.4's refusal, and the one place Redox is deliberately stricter than
-- | Haskell: `a = b + 1; b = a + 1` is accepted there and diverges. A binding
-- | in a cycle is parameterless **by construction** since leaf 0 — anything
-- | taking a parameter is a function entry, which emits as a nested `fn` and
-- | is order-independent in Rust — so this needs no arity test, which is what
-- | made leaf 3 free.
export(crate) where_group : &[Stmt] -> &[Pattern] -> Result<(), ParseError>
where_group entries params =
  bound : Vec<String> = .collect (.flat_map Pattern::binders (.iter params))
  for entry in entries
    case &entry.expr of
      Expr::Item { .. } ->
        continue
      Expr::Binding b ->
        for name in .binders b.pattern
          if .contains (&name) bound
            message = format! \-> "`#{name}` is already a parameter of this equation, and a `where` entry may not shadow one"
            return Err (ParseError::with_help Code::WhereGroupShape message "a `where` group is sorted into dependency order, so a name that means the parameter in one entry and the local in another would depend on where the sort put them — rename the local" b.span)
      other ->
        return Err (ParseError::with_help Code::WhereGroupShape "a `where` entry defines a name, so it is a binding or a function declaration and nothing else" "an expression evaluated for its effect belongs in the body: a `where` group is a set of definitions and is emitted in dependency order, so an entry with an effect has no position to be emitted at" (.span other))
  if where_cycle entries is Some names
    joined = .join ", " names
    message = format! \-> "these `where` bindings depend on each other in a cycle: #{joined}"
    blame = entries
      |> .iter
      |> .find (\e -> .is_some_and (\binder -> .contains (&binder) names) (.where_entry_name e))
      |> .map_or (0, 0) (\e -> e.span)
    return Err (ParseError::with_help Code::WhereGroupShape message "Rust `let` bindings are evaluated in order, so a cycle among values has no order to emit. Haskell accepts this and diverges; give one of them a parameter, which makes it a nested function and lets the cycle be recursion" blame)
  Ok ()
