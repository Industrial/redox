import redox_lexer::TokenKind

-- | The source spelling of a token.
-- |
-- | Used to re-emit a captured type (plan 03 §1.1), where the parser keeps text
-- | rather than structure. A sibling of `capture_type` rather than a child
-- | because doc 06 §2.4 caps depth at three levels below `src/`, and because
-- | re-spelling a token is a general operation rather than one the type scan
-- | owns.
export(crate) token_text : &TokenKind -> String
token_text kind = case kind of
  TokenKind::Ident t -> .clone t
  TokenKind::Kw kw -> kw |> .text |> .to_string
  TokenKind::Int t or TokenKind::Float t -> .clone t
  TokenKind::Char c -> format! \-> "#{c:?}"
  TokenKind::Byte b ->
    -- `value` and `ch` bound out, where the Rust wrote `char::from(*b)`
    -- inline: `*` does not open an argument — `starts_argument` has no
    -- `Star` — so a dereference reaches a call through a binding.
    value = *b
    ch = char::from value
    format! \-> "b#{ch:?}"
  TokenKind::Str { raw, .. } -> .clone raw
  TokenKind::Label name -> format! \-> "'#{name}"
  TokenKind::ColonColon -> .to_string "::"
  TokenKind::Lt -> .to_string "<"
  TokenKind::Gt -> .to_string ">"
  TokenKind::Shr -> .to_string ">>"
  TokenKind::Compose -> .to_string ">>>"
  TokenKind::LParen -> .to_string "("
  TokenKind::RParen -> .to_string ")"
  TokenKind::LBracket -> .to_string "["
  TokenKind::RBracket -> .to_string "]"
  TokenKind::LBrace -> .to_string "{"
  TokenKind::RBrace -> .to_string "}"
  TokenKind::Comma -> .to_string ","
  TokenKind::Semi -> .to_string ";"
  TokenKind::Amp -> .to_string "&"
  TokenKind::Star -> .to_string "*"
  TokenKind::Plus -> .to_string "+"
  TokenKind::Arrow -> .to_string "->"
  TokenKind::Colon -> .to_string ":"
  TokenKind::Eq -> .to_string "="
  TokenKind::Bang -> .to_string "!"
  TokenKind::Dot -> .to_string "."
  -- **Plan 84 leaf 1 completes the ladder, and the fallback below is why it
  -- had to.** `other -> format! "#{other:?}"` spells an unlisted token with
  -- its own `Debug` name, which is an identifier-shaped string that reaches
  -- generated Rust and compiles in some positions. Plan 84 leaf 0 measured two
  -- of them escaping into a `.xrs` — `FatArrow` from a malformed bound clause,
  -- and `QuestionSized` from `?Sized`, where the `?` had no arm. The `.xrs` is
  -- a human-facing artifact (doc 02 §10.1), so the fallback is a defect
  -- generator rather than a convenience.
  --
  -- Every operator token now has its spelling, whether or not a type can
  -- contain it: `?` can (`?Sized`), `<<` can (`Foo<<T as Tr>::X>`), and the
  -- rest cost a line each against a class of defect that has already shipped
  -- twice. `respells_every_operator_the_lexer_produces` is the standing proof,
  -- and it asks the **lexer** rather than a second copy of the table.
  TokenKind::Question -> .to_string "?"
  TokenKind::FatArrow -> .to_string "=>"
  TokenKind::DrawArrow -> .to_string "<-"
  TokenKind::ComposeBack -> .to_string "<<<"
  TokenKind::Pipe -> .to_string "|>"
  TokenKind::Coalesce -> .to_string "??"
  TokenKind::CoalesceEq -> .to_string "??="
  TokenKind::DotDotDot -> .to_string "..."
  TokenKind::DotDot -> .to_string ".."
  TokenKind::DotDotEq -> .to_string "..="
  TokenKind::DotParen -> .to_string ".("
  TokenKind::DotPlus -> .to_string ".+"
  TokenKind::DotMinus -> .to_string ".-"
  TokenKind::DotStar -> .to_string ".*"
  TokenKind::DotSlash -> .to_string "./"
  TokenKind::DotPercent -> .to_string ".%"
  TokenKind::AmpColon -> .to_string "&:"
  TokenKind::Backslash -> .to_string "\\"
  TokenKind::Dollar -> .to_string "$"
  TokenKind::At -> .to_string "@"
  TokenKind::AtAt -> .to_string "@@"
  TokenKind::ColonEq -> .to_string ":="
  TokenKind::Minus -> .to_string "-"
  TokenKind::Slash -> .to_string "/"
  TokenKind::Percent -> .to_string "%"
  TokenKind::PlusEq -> .to_string "+="
  TokenKind::MinusEq -> .to_string "-="
  TokenKind::StarEq -> .to_string "*="
  TokenKind::SlashEq -> .to_string "/="
  TokenKind::PercentEq -> .to_string "%="
  TokenKind::EqEq -> .to_string "=="
  TokenKind::Ne -> .to_string "!="
  TokenKind::Le -> .to_string "<="
  TokenKind::Ge -> .to_string ">="
  TokenKind::AndAnd -> .to_string "&&"
  TokenKind::OrOr -> .to_string "||"
  TokenKind::Or -> .to_string "|"
  TokenKind::Caret -> .to_string "^"
  TokenKind::Tilde -> .to_string "~"
  TokenKind::Shl -> .to_string "<<"
  -- Plan 90. A user operator's spelling **is** its text, which is the whole
  -- reason `TokenKind::UserOp` carries a `String` — so this arm is the one
  -- place in the ladder that needs no table. Found by the fuzzer: without it a
  -- declaration's alias target came back as `UserOp("<=>")`, the same
  -- Debug-name leak plan 84 leaf 2 fixed for the forty operators above.
  TokenKind::UserOp text -> .clone text
  other -> format! \-> "#{other:?}"

-- `Keyword` is qualified rather than imported: it is wanted by this test and
-- by nothing at module scope, and an import used only under `#[cfg(test)]` is
-- an `unused_imports` error in an ordinary build.
test "respells the tokens a type can contain"
  assert_eq! \-> token_text (&TokenKind::Ident (.into "Vec")) \-> "Vec"
  assert_eq! \-> token_text (&TokenKind::Lt) \-> "<"
  assert_eq! \-> token_text (&TokenKind::Shr) \-> ">>"
  assert_eq! \-> token_text (&TokenKind::Compose) \-> ">>>"
  assert_eq! \-> token_text (&TokenKind::Amp) \-> "&"
  assert_eq! \-> token_text (&TokenKind::Kw redox_lexer::Keyword::Mut) \-> "mut"
  assert_eq! \-> token_text (&TokenKind::Label (.into "a")) \-> "'a"

-- | Plan 84 leaf 1: **no operator token falls through to the `Debug`
-- | fallback.**
-- |
-- | The oracle is the **lexer**, not a list. `OPERATOR_TABLE` is private to
-- | `redox-lexer`, and copying it here would be a second table free to drift
-- | from the first — which is the shape of the defect this test exists to stop.
-- | So the source below is lexed, and each token's respelling is compared
-- | against **its own span in that source**. A token whose arm is missing
-- | answers with its `Debug` name, which never equals the text it came from.
-- |
-- | Plan 84 leaf 0 is why this is worth a test rather than a careful reading.
-- | Two Debug names had already reached generated `.xrs` files — `FatArrow`
-- | and `QuestionSized` — and both were in a file doc 02 §10.1 calls a
-- | human-facing artifact. One was found by a surface probe and one by reading
-- | the emitted Rust; neither was found by any gate.
test "respells every operator the lexer produces"
  -- Spaced so each spelling lexes as itself: longest-match would read `. .`
  -- as two `Dot`s and `..` as one `DotDot`, and both are wanted here.
  const SOURCE : &str = "... ..= ??= >>> <<< .. .( .+ .- .* ./ .% ?? |> &: :: := -> <- => == != <= >= && || += -= *= /= %= << >> ( ) [ ] { } @@ @ ? : \\\\ $ , . ; = + - * / % < > ! & | ^ ~"
  -- A panic is the right outcome: a source of bare operators that stops
  -- lexing means the lexer changed under this test, and the test cannot
  -- report that any other way.
  #[redox::allow(unwrap)]
  toks = .expect "the operator source should lex" (redox_lexer::lex SOURCE)
  mut checked = 0
  for tok in &toks
    skip = case tok.kind of
      TokenKind::Newline or TokenKind::Indent or TokenKind::Dedent or TokenKind::Eof -> true
      _ -> false
    if skip
      continue
    slice = &SOURCE[tok.span.0 .. tok.span.1]
    spelled = token_text (&tok.kind)
    assert_eq! \-> .as_str spelled \-> slice \-> "#{tok.kind:?} respells as `#{spelled}` but its source is `#{slice}` — an unlisted token answers with its own Debug name, which reaches generated Rust"
    checked += 1
  assert! \-> checked > 50 \-> "only #{checked} operators were checked, so this test is not reading the source it thinks it is"
