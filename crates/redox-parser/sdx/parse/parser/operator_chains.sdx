import crate::parse::parser::Parser
import redox_ast::Ident
import redox_lexer::TokenKind

-- | Whether `spelling` follows again at the cursor — plan 90.
-- |
-- | The non-associative refusal's one question. Asked **after** the right
-- | operand has been parsed, so what sits at the cursor is the second use:
-- | `a <=> b <=> c` has consumed `a <=> b` and is looking at the second `<=>`.
-- |
-- | Only the **same** spelling counts. Two different non-associative operators
-- | in one expression are grouped by their precedences like anything else, and
-- | refusing that would be refusing a program that is not ambiguous.
export(crate) operator_chains : &Parser -> &Ident -> bool
operator_chains p spelling = case &(.peek p).kind of
  TokenKind::UserOp next -> next == &spelling.text
  _ -> false
