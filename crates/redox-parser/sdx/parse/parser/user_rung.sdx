import crate::parse::parser::Parser
import redox_ast::{Fixity, Ident}
import redox_lexer::TokenKind

-- | The rung a user-declared operator occupies at the cursor — plan 90.
-- |
-- | `(spelling, fixity, left, right, target, precedence)`, or `None` when the
-- | next token is not a user operator. The positional tuple is `binary_power`'s own idiom one
-- | field wider, and `parse_expr` names the positions where it reads them.
-- |
-- | # Why this returns `None` for an undeclared operator
-- |
-- | A `UserOp` token the file has not declared is **not** reported here, and
-- | that is deliberate: this function is consulted inside the Pratt loop, which
-- | stops at any token it does not recognise and hands back the expression it
-- | has. So an undeclared operator falls out of the loop like a `)` would, and
-- | whatever is waiting for the expression to end reports an unexpected token.
-- |
-- | That is the wrong diagnostic — `expected a line break` rather than
-- | *"`<+>` is not declared in this file"* — so `undeclared_operator` is
-- | checked where the expression **statement** ends, and `RDX0123` is raised
-- | there. Plan 90 §1.5 promised the boundary would be loud; this is the one
-- | place it could have been quiet instead.
-- |
-- | # The table is the parser's own field
-- |
-- | Read directly from `p.fixities` because this is a child module of
-- | `parse::parser`, which is the access `clause`, `stmt` and `where_locals`
-- | already have. No ambient `thread_local!` guard, unlike the four the emitter
-- | installs — the information is needed *during* parsing, so the parser is
-- | where it can simply be a field.
export(crate) user_rung : &Parser -> Option<(Ident, Fixity, u8, u8, String, u8)>
user_rung p =
  guard &(.peek p).kind is TokenKind::UserOp text else
    return None
  -- `?` rather than a second `guard … else return None`, which clippy's
  -- `question_mark` lint asks for by name.
  declared = (.get (.as_str text) p.fixities)?
  fixity = declared.0
  precedence = declared.1
  powers = .powers precedence fixity
  spelling = Ident { text = .clone text, span = .peek_span p }
  Some (spelling, fixity, powers.0, powers.1, .clone declared.2, precedence)
