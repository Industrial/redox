import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::reserved_word::reserved_word
import redox_ast::Expr
import redox_lexer::TokenKind

-- | `do .method` and its indented block — plan 86.
-- |
-- | ```text
-- | users = do .and_then          pairs = do .flat_map
-- |   u <- find id                  x <- 1 .. 3
-- |   a <- u.address                y <- 1 .. 3
-- |   Ok a                          iter::once (x, y)
-- | ```
-- |
-- | **This spends the reservation `docs/GRAMMAR.md` records twice.** Plan 55
-- | leaf 7 retired the construct `do` spelled — an indented block is an
-- | expression and needs nothing in front of it — and kept the *word*, because
-- | *"`do`'s Haskell meaning is the one still unclaimed"*. This is that
-- | meaning, and `reserved_word`'s `RDX0114` stays for every other use.
-- |
-- | # The modifier is the type-free discrimination
-- |
-- | `docs/DECLINED.md` refuses a *"general monadic comprehension"* because it
-- | *"must choose `flat_map` versus `and_then`"*, and carries the only
-- | reopening venue in the document: **"revisit only if a type-free
-- | discrimination is found."**
-- |
-- | Plan 60 already built one. `<-` is monadic bind read by the **enclosing
-- | block modifier**, with `try` reading it as `?` and `async` as `.await` —
-- | so the discrimination is the author's own syntax and the set it ranges
-- | over was simply closed. Opening it is this row, and doc 03 §2 clause 1 is
-- | satisfied in its own words: *"the user's own syntax selects between them —
-- | never an inference."*
-- |
-- | Redox chooses nothing. It transcribes the method the author named.
export(crate) bind_block : &mut Parser -> usize -> Result<Expr, ParseError>
bind_block p start =
  -- `do` followed by anything that is not a method reference is still the
  -- retired construct, and still `RDX0114`. The lookahead is one token, and it
  -- has to be a *peek*: `reserved_word` consumes the word and the block after
  -- it, which is the cursor movement plan 55 §1.7 earned by reporting one
  -- defect twice and missing the next.
  names_a_method = .is_some_and (\t -> t.kind == TokenKind::Dot) (.peek_at 1 p)
  if !names_a_method
    return Err $ reserved_word p
  .advance p
  .advance p
  method = (.ident "expected a method name after `do .`" p)?
  body = (.statement_block "expected an indented `do` body" p)?
  Ok (Expr::BindBlock { method, body, span = (start, (.prev_span p).1) })
