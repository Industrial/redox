import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::token_text::token_text
import redox_diag::Code
import redox_lexer::{Keyword, TokenKind}

-- | The `given <…>` clause, if one is here — plan 84 leaf 1.
-- |
-- | ```text
-- | pad : given <const N: usize> [u8; N] -> u8
-- | ```
-- |
-- | Doc 03 §14.1 carries a **type** verbatim, so every present and future Rust
-- | type form is reachable for free and nothing can drift. The **binder** was
-- | synthesised instead — doc 18 §2.2's *"lowercase type names are type
-- | variables […] the generic list is the order of their first appearance"* —
-- | and plan 84 leaf 0 measured six shapes synthesis cannot reach. This is
-- | §14.1's argument applied one level up: the parameter list is carried
-- | rather than derived.
-- |
-- | **The text is not inspected**, which is the whole contract. What comes
-- | back is the source between the angle brackets, brackets included, for the
-- | emitter to paste where rustc wants a generic list. A future Rust addition
-- | to that grammar needs no change here, for the same reason a future type
-- | form needs none in `capture_type`.
-- |
-- | # Why it is balanced rather than read to the line's end
-- |
-- | A `given` clause is followed by the spine, on the same line, so its extent
-- | has to be decided by something. The angle brackets are that something, and
-- | counting them is exact here where it would not be in an expression:
-- | `<` and `>` inside a generic list are delimiters, never comparisons, so
-- | there is no ambiguity to resolve. `>>` closes two and `>>>` three, which is
-- | the same arithmetic `capture_type` does and for the same reason — the lexer
-- | emits one token for each.
-- |
-- | An unbalanced clause is [`Code::BoundClauseShape`] rather than a silent
-- | run to the end of the line. Plan 84 §1.3 is why that matters: the defect
-- | this row exists to fix was a malformed binder being *swallowed* instead of
-- | refused, and a new clause that swallows on its own would reintroduce it.
export(crate) given_clause : &mut Parser -> Result<Option<String>, ParseError>
given_clause p =
  if !.check (&TokenKind::Kw (Keyword::Given)) p
    return Ok None
  opened = .peek_span p
  .advance p
  if !.check (&TokenKind::Lt) p
    return Err $ ParseError::with_help Code::BoundClauseShape "expected `<` after `given`" "`given` carries Rust's own generic parameter list, verbatim and in angle brackets: `given <const N: usize>`, `given <T: Display, I: IntoIterator<Item = T>>`" (.peek_span p)
  mut depth : i32 = 0
  mut text = String::new ()
  loop
    kind = &(.peek p).kind
    at_end = case kind of
      TokenKind::Newline or TokenKind::Indent or TokenKind::Dedent or TokenKind::Eof -> true
      _ -> false
    if at_end
      return Err $ ParseError::with_help Code::BoundClauseShape "this `given` clause is not closed" "a `given` clause runs from `<` to the `>` that matches it, on one line, and the spine follows it" opened
    case kind of
      TokenKind::Lt -> depth += 1
      TokenKind::Gt -> depth -= 1
      TokenKind::Shr -> depth -= 2
      TokenKind::Compose -> depth -= 3
      _ -> ()
    if (.peek p).ws_before && !.is_empty text
      .push ' ' text
    .push_str (&token_text kind) text
    .advance p
    if depth <= 0
      break
  Ok (Some text)
