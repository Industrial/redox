import crate::parse::parser::Parser
import redox_lexer::{Keyword, TokenKind}

-- | Whether the cursor is on a declaration keyword — plan 55 leaf 5.
-- |
-- | Doc 18 §2.4's declarations are told apart by their first token, which is a
-- | reserved word, so one comparison settles it with no backtracking and no
-- | ambiguity against a function's signature line — a function begins with a
-- | *name*. `Parser::item` makes the same test one branch at a time; this is
-- | the same set asked as a question, for the one caller that needs to know
-- | *whether* rather than *which*.
-- |
-- | Two keywords are deliberately absent.
-- |
-- | **`test`** is leaf 6's refusal. A nested `#[test]` is not collected by
-- | rustc, so a local one would compile and silently never run; `RDX0112` says
-- | so, and `local_test` runs before this is ever asked.
-- |
-- | **`module`** is out of scope rather than refused. A bodiless `module` loads
-- | a *file*, which is not a thing a block can do, and an inline one would
-- | nest a `mod` inside a function — legal Rust, no corpus demand, and plan
-- | 14's scoping rules would have to say what it means. Left for a row that
-- | wants it.
export(crate) starts_a_declaration : &Parser -> bool
starts_a_declaration p = case (.peek p).kind of
  TokenKind::Kw (Keyword::Data or Keyword::Newtype or Keyword::Union or Keyword::Type or Keyword::Class or Keyword::Instance or Keyword::Errors or Keyword::Import or Keyword::Const or Keyword::Static) -> true
  _ -> false
