import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::atom::atom
import crate::parse::parser::binary_op::binary_op
import crate::parse::parser::opens_a_section::opens_a_section
import crate::parse::parser::parse_expr::parse_expr
import crate::parse::parser::pipeline_section::pipeline_section
import redox_ast::{Expr, Section}
import redox_lexer::TokenKind

-- | Parse a section, if the parenthesis opens one — doc 18 §4.
-- |
-- | Called with the `(` **already consumed**, and returns `None` when what
-- | follows is an ordinary grouping, having left the cursor where it found it.
-- |
-- | Three shapes, told apart with no more than two tokens of lookahead:
-- |
-- | ```text
-- | (.name)     a field selector
-- | (+ 1)       a right section: the operator comes first
-- | (1 +)       a left section: the operator comes last
-- | ```
-- |
-- | `(|> name)` was a fourth — a method reference, a section of the pipeline —
-- | and plan 57 retires it, because a bare `.name` is a method awaiting its
-- | receiver and lowers to the same closure. The arm survives as a refusal
-- | (`RDX0116`), so the spelling names its replacement rather than failing as
-- | *"expected an expression"*.
-- |
-- | The left section is the only one needing a speculative read, and it reads
-- | an **atom** rather than a full expression — which is also what doc 18 §2.1
-- | says an argument is, so the restriction is the one already in the grammar
-- | rather than a new one. `(1 + 2 *)` is not a section, and nothing in §4
-- | suggests it should be.
-- |
-- | `(- 1)` is **never** a section: doc 18 §4 makes it negation always, which
-- | is what retires doc 03 decision 50's `(-1)`-versus-`(- 1)` adjacency rule.
-- | Subtraction has no section; the lambda is `\\x -> x - 1`. The same holds
-- | for `&`, `*` and `!`, which are prefix operators too — see
-- | `opens_a_section`.
export(crate) section : &mut Parser -> usize -> Result<Option<Expr>, ParseError>
section p start =
  mark = .position p
  -- `(.name)` — GHC's record dot.
  --
  -- **A `)` immediately after the name is the discriminator**, and since plan
  -- 57 it is doing real work: a bare `.name` is a method, so `(.age)` closes
  -- and `(.cmp y)` does not. This used to `expect` the `)` and propagate,
  -- which made `(.cmp 1)` a hard `RDX0101` where its three siblings below
  -- rewind; it rewinds too now, and the parenthesis is an ordinary group
  -- around the method application inside it.
  --
  -- The lookahead is an `if` over a `case`, where the Rust wrote
  -- `is_some_and(|t| matches!(…))`: a `case` needs a line of its own, so it
  -- cannot be a one-line lambda body.
  names_a_field = if .peek_at 1 p is Some next
    case next.kind of
      TokenKind::Ident _ -> true
      _ -> false
  else
    false
  if .check (&TokenKind::Dot) p && names_a_field
    .advance p
    -- **Plan 88: a path, not one name.** `(.addr.city)` already parsed before
    -- this row — as a selector of `addr` and then a *method call* on the
    -- closure it produced, emitting `(|__rdx_1| __rdx_1.addr()).city(o)`. Not
    -- Rust, no Redox diagnostic, and `E0282` from rustc. So the loop replaces
    -- a silent misreading rather than adding a new shape.
    --
    -- The continuation test is the same two tokens the entry test used: a `.`
    -- followed by an identifier. A `.` followed by anything else ends the path
    -- and the `)` check below reports it.
    mut path = vec! \-> (.ident "expected a field name after `.`" p)?
    while .check (&TokenKind::Dot) p && (if .peek_at 1 p is Some next
      case next.kind of
        TokenKind::Ident _ -> true
        _ -> false
    else
      false)
      .advance p
      .push (.ident "expected a field name after `.`" p)? path
    if .check (&TokenKind::RParen) p
      .advance p
      return Ok (Some (Expr::Section { section = Section::Field path, span = (start, (.prev_span p).1) }))
    .rewind mark p
    return Ok None
  -- `(|> name)` — retired by plan 57, which builds its replacement. Kept as
  -- an arm rather than deleted, so the spelling names `.name` instead of
  -- reaching `prefix` and failing as *"expected an expression"*.
  if .check (&TokenKind::Pipe) p && .peek_at 1 p is Some token && &token.kind is TokenKind::Ident named
    end = token.span.1
    return Err (pipeline_section named (start, end))
  -- A right section: the operator leads. The four operators that are also
  -- *prefix* operators are excluded, so `(- 1)`, `(&x)`, `(*p)` and
  -- `(!flag)` keep their prefix reading — see `opens_a_section`.
  if opens_a_section (&(.peek p).kind)
    if binary_op p is Some leading_op
      operand = (parse_expr p 0)?
      (.expect (&TokenKind::RParen) "expected `)` to close the section" p)?
      return Ok (Some (Expr::Section { section = Section::Right { op = leading_op, operand = Box::new operand }, span = (start, (.prev_span p).1) }))
    .rewind mark p
  -- A left section: the operator trails, so the operand is read first and
  -- the read is abandoned if no `op )` follows.
  guard atom p is Ok operand else
    .rewind mark p
    return Ok None
  if binary_op p is Some trailing_op && .check (&TokenKind::RParen) p
    .advance p
    return Ok (Some (Expr::Section { section = Section::Left { op = trailing_op, operand = Box::new operand }, span = (start, (.prev_span p).1) }))
  .rewind mark p
  Ok None
