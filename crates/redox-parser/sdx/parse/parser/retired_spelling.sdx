import crate::ParseError
import redox_ast::Ident
import redox_diag::Code

-- | The six names plan 64 retires, and what to write instead.
-- |
-- | ```text
-- | assert! \-> cond     ->  assert! \-> cond
-- | panic! \-> "m"       ->  panic! \-> "m"
-- | println! \-> "#{x         ->  println! \-> "#{x}"}"
-- | todo            ->  todo!
-- | ```
-- |
-- | Each existed **only because macros were unreachable** (§1.5). With `name!
-- | \-> e` spelling the real thing, Rust's own macros are better in every
-- | case: `println!` has a stderr sibling where `print` had none, and `assert!`
-- | is one of a family where `assert` was alone.
-- |
-- | # Why this is a diagnostic rather than a silence
-- |
-- | `print` appears in 29 of 31 examples, so this error message *is* the
-- | migration guide — which plans 52, 57, 59 and 60 each also chose, making it
-- | the milestone's standing answer to a retired spelling.
-- |
-- | And for `assert` the silence would be worse than unhelpful. It was the one
-- | reserved word of the six; retiring the keyword without this check leaves
-- | `assert cond` parsing as a call to an undefined function, which rustc
-- | reports against generated Rust naming a function the author never meant to
-- | call. Plan 45 §1.5 measured the matching hazard in the other direction:
-- | while `assert` was a keyword, `assert! true` *silently* emitted
-- | `assert!(!true)`.
-- |
-- | # Read in prefix position, where a bare name is a value
-- |
-- | The caller is [`macro_call`](super::macro_call::macro_call), after it has
-- | found no `!` glued to the name — so `println!` never reaches here, and
-- | neither does `.print` (a method reference), `x.print` (a field) or
-- | `std::print` (a path, which this does not inspect). What is left is a bare
-- | name standing where a value goes, which is exactly the position all six
-- | retired spellings occupied.
export(crate) retired_spelling : &Ident -> Option<ParseError>
retired_spelling name =
  replacement = case .as_str name.text of
    "assert" -> "`assert! \\-> cond`, or `assert! \\-> a == b` for a comparison"
    "panic" -> "`panic! \\-> \"message\"`"
    "print" -> "`println! \\-> \"\#{x}\"`, or `eprintln!` to write to stderr"
    "todo" -> "`todo!`"
    "unimplemented" -> "`unimplemented!`"
    "unreachable" -> "`unreachable!`"
    _ ->
      return None
  message = format! \-> "`#{name.text}` is not a construct any more — macros are callable, so write #{replacement}"
  Some (ParseError::with_help Code::RetiredSpelling message "`!` marks a macro's name and `\\->` opens each argument, so no bracket is needed: `println! \\-> \"\#{total} rows\"`" name.span)
