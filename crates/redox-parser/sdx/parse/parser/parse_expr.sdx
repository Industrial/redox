import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::operator_chains::operator_chains
import crate::parse::parser::user_rung::user_rung
import crate::parse::parser::application::application
import crate::parse::parser::capture_type::capture_type
import crate::parse::parser::type_stop::TypeStop
import crate::parse::precedence::binary_power::binary_power
import redox_ast::{Expr, Fixity}
import redox_diag::Code
import redox_lexer::TokenKind

-- | Parse an expression by Pratt loop, stopping before any operator whose left
-- | binding power is below `min`.
-- |
-- | Plan 03 (`docs/08 - 03 - Parser Core.md`) leaf 3, with doc 18 §2.1's
-- | application as its primary. The table in
-- | `crate::parse::precedence` is the single place precedence and
-- | associativity live, so adding an operator never means touching this loop.
export(crate) parse_expr : &mut Parser -> u8 -> Result<Expr, ParseError>
parse_expr p min =
  -- Doc 18 §2.1: application binds tighter than every operator, so it is the
  -- primary rather than a rung on the precedence ladder. `application` also
  -- absorbs the postfix loop that used to run here, because an argument is a
  -- postfixed primary and the head is one too.
  mut lhs = (application p)?
  loop
    -- Doc 18 §6's ascription, at the loosest binding power there is: it
    -- applies to the whole expression, so it is tried only at the top level
    -- (`min == 0`) and only after the binary loop has taken everything else.
    -- `1 + 2 : u64` therefore ascribes the sum, not the `2`.
    if min == 0 && .check (&TokenKind::Colon) p
      .advance p
      ty = (capture_type p "expected a type after `:`" TypeStop::Greedy)?
      at = ((.span lhs).0, ty.span.1)
      lhs := Expr::Ascribe { inner = Box::new lhs, ty, span = at }
      continue
    -- Doc 18 §2.1's `$`: grouping that runs to the end of the expression, and
    -- the reason a nested application rarely needs brackets. It **lowers to
    -- nothing at all** — `f $ g x` is the call `f(g(x))` — so the call is
    -- built here and no node of its own is carried.
    --
    -- `is_dollar` records the spelling and nothing else. The lowering ignores
    -- it, because `$` has no lowering; the formatter reads it, because a
    -- formatter that reprinted `f $ x` as `f (x)` would rewrite away the one
    -- construct whose purpose is to avoid that parenthesis.
    --
    -- Binding power 1: looser than every operator, tighter than ascription,
    -- which matches Haskell's `infixr 0` for `$` against an even looser `:`.
    if min <= 1 && .check (&TokenKind::Dollar) p
      .advance p
      arg = (parse_expr p 1)?
      at = ((.span lhs).0, (.span arg).1)
      lhs := Expr::Call { callee = Box::new lhs, args = vec! \-> arg, is_dollar = true, span = at }
      continue
    -- Plan 90's user-declared operators, read **before** the built-in table
    -- because they are not in it: the spelling is data, the fixity is this
    -- file's, and `user_rung` is the one place the two meet.
    --
    -- Returned as the same `(left, right)` pair a built-in rung carries, so the
    -- `< min` test, the recursion and the span arithmetic below are shared
    -- rather than copied. What differs is only the node built, which is why
    -- this is a separate `if` and not a separate loop.
    -- `declared.0` is the spelling, `.1` its fixity, `.2` and `.3` its left
    -- and right powers, `.4` its alias target and `.5` its declared
    -- precedence — the positional idiom `rung.0`/`.1`/`.2` uses below, widened.
    if user_rung p is Some declared
      if declared.2 < min
        return Ok lhs
      spelling = declared.0
      .advance p
      rhs = (parse_expr p declared.3)?
      span = ((.span lhs).0, (.span rhs).1)
      -- `NonAssoc` refuses the **chain**, and this is where it has to be
      -- refused: a Pratt loop's binding powers can only group one way or the
      -- other, so "does not chain" is a diagnostic rather than a precedence.
      -- Checked after the right operand so the error points past it, at the
      -- second use, which is the one that is too many.
      if declared.1 == Fixity::NonAssoc && operator_chains p (&spelling)
        return Err $ ParseError::with_help Code::NonAssociativeOperator (format! \-> "`#{spelling.text}` was declared `infix`, so it does not chain") "write the grouping — `(a #{spelling.text} b) #{spelling.text} c` — or declare it `infixl` or `infixr`" (.peek_span p)
      lhs := Expr::UserBinary { spelling, fixity = declared.1, precedence = declared.5, target = declared.4, lhs = Box::new lhs, rhs = Box::new rhs, span }
      continue
    -- `rung.0` is the operator, `rung.1` its left power and `rung.2` its
    -- right, where the Rust destructured the triple in the `let … else`.
    guard binary_power (&(.peek p).kind) is Some rung else
      -- Plan 90 §1.5's loud boundary, and the one place it could have been
      -- quiet. A `UserOp` the file has not declared is not a rung, so without
      -- this the loop would simply stop and the caller would report *"expected
      -- a line break"* — true, and about the wrong thing. `user_rung`'s doc
      -- comment records why the check cannot live there.
      if &(.peek p).kind is TokenKind::UserOp spelling
        return Err $ ParseError::with_help Code::UndeclaredOperator (format! \-> "`#{spelling}` is not declared in this file") "declare it above its first use — `infixl 6 #{spelling} = Set::union`. An operator's scope is the file, which is plan 14 decision 4's refusal of name resolution" (.peek_span p)
      return Ok lhs
    if rung.1 < min
      return Ok lhs
    .advance p
    rhs = (parse_expr p rung.2)?
    span = ((.span lhs).0, (.span rhs).1)
    lhs := Expr::Binary { op = rung.0, lhs = Box::new lhs, rhs = Box::new rhs, span }
