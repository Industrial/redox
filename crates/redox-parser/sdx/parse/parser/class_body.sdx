import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::class_member::class_member
import crate::parse::parser::method_context::MethodContext
import redox_ast::ClassMember
import redox_lexer::TokenKind

-- | The indented body of a `class` or `instance` — doc 18 §2.5.
-- |
-- | One body parser for both, because the member grammar is the same one: an
-- | associated type, an associated constant, or a method with or without a
-- | body. Rust distinguishes what may appear in a `trait` from what may appear
-- | in an `impl`; Redox does not, and leaves the distinction to rustc, which
-- | is the same division of labour AGENTS.md states for every other check.
-- |
-- | An empty body is legal — `class Marker t` with no members is a marker
-- | trait, and Rust writes it `trait Marker {}`.
export(crate) class_body : &mut Parser -> &MethodContext -> Result<Vec<ClassMember>, ParseError>
class_body p ctx =
  mut members = Vec::new ()
  opens = .check (&TokenKind::Newline) p && .is_some_and (\t -> t.kind == TokenKind::Indent) (.peek_at 1 p)
  if !opens
    return Ok members
  .advance p
  .advance p
  loop
    .skip_separators p
    if .check (&TokenKind::Dedent) p || .at_eof p
      break
    .push (class_member p ctx)? members
  (.expect (&TokenKind::Dedent) "expected the body to end" p)?
  Ok members
