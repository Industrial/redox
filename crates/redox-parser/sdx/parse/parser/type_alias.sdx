import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::capture_type::capture_type
import crate::parse::parser::type_stop::TypeStop
import redox_ast::{TypeAlias, Visibility}
import redox_lexer::{Keyword, TokenKind, Trivia}

-- | `type Handler = Box<dyn Fn(Req) -> Res + Send>` — doc 18 §2.4.
-- |
-- | The one declaration form that is already Rust: the keyword, the `=` and
-- | the type are unchanged. The type is captured verbatim, as every type in
-- | Redox is (doc 03 §14.1) — including the `->` inside `Fn(…) -> …`, which
-- | `capture_type` handles because an `->` after a `)` does not end a type.
-- | That refinement was written for parameter types in plan 03, and it is what
-- | makes doc 18 §2.4's own alias example reachable without a second rule.
export(crate) type_alias : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<TypeAlias, ParseError>
type_alias p leading start visibility =
  (.expect (&TokenKind::Kw Keyword::Type) "expected `type`" p)?
  name = (.ident "expected a name after `type`" p)?
  (.expect (&TokenKind::Eq) "expected `=` after the alias's name" p)?
  ty = (capture_type p "expected a type" TypeStop::Greedy)?
  Ok (TypeAlias { name, ty, visibility, span = (start, (.prev_span p).1), leading })
