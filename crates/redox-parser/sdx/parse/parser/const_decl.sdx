import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::capture_type::capture_type
import crate::parse::parser::parse_expr::parse_expr
import crate::parse::parser::type_stop::TypeStop
import redox_ast::{ConstDecl, Visibility}
import redox_lexer::{Keyword, TokenKind, Trivia}

-- | Parse doc 03 §13.4's module-scope `const` or `static` — plan 16.
-- |
-- | ```text
-- | const MAX : usize = 1024
-- | static COUNT : u32 = 0
-- | export const LIMIT : usize = 8
-- | ```
-- |
-- | The value is **required**. A class's associated constant may be declared
-- | without one — the instance supplies it — but a module-scope binding has
-- | nowhere else for a value to come from, so asking here gives a better
-- | message than rustc's.
export(crate) const_decl : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<ConstDecl, ParseError>
const_decl p leading start visibility =
  is_static = .check (&TokenKind::Kw Keyword::Static) p
  .advance p
  name = (.ident "expected a name after `const`" p)?
  (.expect (&TokenKind::Colon) "expected `:` and a type — doc 03 §13.4 requires one on a module-scope binding" p)?
  ty = (capture_type p "expected the binding's type" TypeStop::Greedy)?
  (.expect (&TokenKind::Eq) "expected `=` and a value — a module-scope binding must be initialised" p)?
  value = (parse_expr p 0)?
  Ok (ConstDecl { name, ty, value, is_static, visibility, span = (start, (.prev_span p).1), leading })
