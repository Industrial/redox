import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::parse_expr::parse_expr
import crate::parse::parser::path_or_ident::path_or_ident
import crate::parse::parser::retired_spelling::retired_spelling
import redox_ast::Expr
import redox_lexer::TokenKind

-- | A name, or a macro invocation if a `!` is glued to it — plan 64.
-- |
-- | ```text
-- | println! \-> "#{a} #{b}"        println!("{} {}", a, b)
-- | write!   \-> f \-> "#{n} rows"   write!(f, "{} rows", n)
-- | todo!                           todo!()
-- |
-- | r = catch_unwind! \->            let r = catch_unwind!({
-- |   a = f x                           let a = f(x);
-- |   a + 1                             a + 1
-- |                                 });
-- | ```
-- |
-- | Three decisions are visible in these twelve lines.
-- |
-- | **`!` is told from negation by adjacency, and nothing else.** `foo!` is a
-- | macro head; `! foo` and `!foo` in prefix position are negation, because
-- | `unary_op` is tried before this function is ever reached. The only
-- | ambiguity left would be an infix position — `a !b` — which is not an
-- | expression in any reading. §6 discloses that this is the rule plan 52
-- | struck from `::`, and that the token budget is the reason it comes back.
-- |
-- | **A path is a macro head too**, because `path_or_ident` already returns
-- | one node for `a::b::c`: `id_effect::effect!` needs no second production.
-- |
-- | **`\->` is the argument's opening bracket.** One arrow per argument, and
-- | the lambda does not survive into the tree — [`Expr::MacroCall`] holds the
-- | argument *expressions*. Deferral is the macro's business (§6, decision 2),
-- | so spelling the argument as a closure is a reading inaccuracy the row
-- | accepts and does not implement.
-- |
-- | The multi-line body needs nothing here: `parse_expr` reached with the
-- | cursor on a `Newline` reads an indented block, which is plan 55 leaf 1's
-- | doing. Plan 64 §11.1 left the question of whether this leaf had to build
-- | that body, and the probe it owed answers no.
export(crate) macro_call : &mut Parser -> Result<Expr, ParseError>
macro_call p =
  head = (path_or_ident p)?
  if !.check (&TokenKind::Bang) p || (.peek p).ws_before
    -- Plan 64 leaf 5. A *bare* name is where all six retired spellings
    -- stood, so this is the one position that has to say so — `println!`
    -- has already been taken by the branch below.
    if &head is Expr::Ident name && retired_spelling name is Some retired
      return Err retired
    return Ok head
  .advance p
  name = case &head of
    Expr::Ident i -> .clone i.text
    Expr::Path { text, .. } -> .clone text
    other ->
      unreachable! \-> "a macro head is a name or a path, not #{other:?}"
  start = (.span head).0
  mut args = Vec::new ()
  while .check (&TokenKind::Backslash) p && .is_some_and (\t -> t.kind == TokenKind::Arrow) (.peek_at 1 p)
    .advance p
    .advance p
    .push (parse_expr p 0)? args
  Ok (Expr::MacroCall { name, args, span = (start, (.prev_span p).1) })
