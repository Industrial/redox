import crate::parse::parser::Parser
import redox_lexer::{Keyword, TokenKind}

-- | Whether the cursor is on a token that can begin a sub-pattern.
-- |
-- | An allow-list rather than a deny-list: a token that ends the construct must
-- | never be read as an argument. Plan 14 removed `*` from `continues_line` for
-- | the same reason, and the rule the two share is written at that set — *a
-- | token that ends a construct should not continue a line.*
export(crate) starts_a_pattern_argument : &Parser -> bool
starts_a_pattern_argument p = case &(.peek p).kind of
  TokenKind::Ident _ or TokenKind::Int _ or TokenKind::Float _ or TokenKind::Char _ or TokenKind::Byte _ or TokenKind::Str { .. } or TokenKind::LParen -> true
  TokenKind::Kw (Keyword::True) or TokenKind::Kw (Keyword::False) or TokenKind::Kw (Keyword::SelfValue) -> true
  _ -> false
