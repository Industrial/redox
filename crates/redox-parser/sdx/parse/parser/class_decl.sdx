import crate::ParseError
import crate::parse::parser::Parser
import crate::parse::parser::class_body::class_body
import crate::parse::parser::class_supers::class_supers
import crate::parse::parser::method_context::MethodContext
import redox_ast::{ClassDecl, Visibility}
import redox_lexer::{Keyword, TokenKind, Trivia}

-- | Parse doc 18 §2.5's `class` — Rust's `trait`.
-- |
-- | ```text
-- | class Debug => Shape         trait Shape: Debug {
-- |   type Unit                      type Unit;
-- |   const SIDES : u32         →   const SIDES: u32;
-- |   area : &self -> f64           fn area(&self) -> f64;
-- |                              }
-- |
-- | class Convert t              trait Convert<T> {
-- |   wrap : t -> Self          →   fn wrap(__rdx_a0: T) -> Self;
-- |                              }
-- | ```
-- |
-- | Rust's trait system is Haskell's class system with different words, so the
-- | words change back: `class` stops meaning doc 01 §17.7's "struct plus impl"
-- | and means `trait`.
-- |
-- | **The names after the class's own are the trait's parameters, and there
-- | may be none.** Until plan 67 there was exactly one and it stood for the
-- | implementing type, which `Self` names already — so a second lowercase name
-- | in a member's type became a *method* generic and `impl From<u32>` and
-- | `impl From<f64>` for one type could not both be written. §1.4 measured the
-- | near miss: `E0049` from rustc, naming a type parameter the author never
-- | wrote.
-- |
-- | The superclass clause is read speculatively, because `class Show => Shape`
-- | and `class Shape` differ only at the `=>` — see `class_supers`.
export(crate) class_decl : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<ClassDecl, ParseError>
class_decl p leading start visibility =
  (.expect (&TokenKind::Kw Keyword::Class) "expected `class`" p)?
  supers = (class_supers p)?
  name = (.ident "expected the class's name" p)?
  -- Greedy, and safe to be: a class head is followed by a line break, so
  -- there is nothing else on the line for a name to belong to.
  mut params = Vec::new ()
  while .try_ident p is Some param
    .push param params
  mut ctx = MethodContext::for_class (&params)
  -- Plan 63 leaf 1: members are recorded under this class's name as they are
  -- read, which is what an `instance` later borrows from.
  ctx.recording := Some $ .clone name.text
  members = (class_body p (&ctx))?
  Ok (ClassDecl { name, params, supers, members, visibility, span = (start, (.prev_span p).1), leading })
