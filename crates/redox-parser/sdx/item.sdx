export(crate) alias_target : &mut Parser -> &Ident -> Result<String, ParseError>
alias_target p spelling =
  mut text = String::new ()
  loop
    kind = &(.peek p).kind
    at_end = case kind of
      TokenKind::Newline or TokenKind::Indent or TokenKind::Dedent or TokenKind::Eof -> true
      _ -> false
    if at_end
      break
    if (.peek p).ws_before && !.is_empty text
      .push ' ' text
    .push_str (&token_text kind) text
    .advance p
  trimmed = .trim (.as_str text)
  if .is_empty trimmed
    return Err $ ParseError::with_help Code::OperatorShape "expected a function for this operator to stand for" "a declaration is an **alias**: `infixl 6 <+> = Set::union` makes `a <+> b` emit `Set::union(a, b)`. It declares no function of its own, because no Rust function can be named `<+>`" spelling.span
  Ok (.to_string trimmed)

export(crate) const_decl : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<ConstDecl, ParseError>
const_decl p leading start visibility =
  is_static = .check (&TokenKind::Kw Keyword::Static) p
  .advance p
  name = (.ident "expected a name after `const`" p)?
  (.expect (&TokenKind::Colon) "expected `:` and a type — doc 03 §13.4 requires one on a module-scope binding" p)?
  ty = (capture_type p "expected the binding's type" TypeStop::Greedy)?
  (.expect (&TokenKind::Eq) "expected `=` and a value — a module-scope binding must be initialised" p)?
  value = (parse_expr p 0)?
  Ok (ConstDecl { name, ty, value, is_static, visibility, span = (start, (.prev_span p).1), leading })

export(crate) declares_an_operator : &Parser -> bool
declares_an_operator p =
  word_is_fixity = case &(.peek p).kind of
    TokenKind::Ident text -> .is_some (Fixity::from_keyword (.as_str text))
    _ -> false
  if !word_is_fixity
    return false
  level_is_an_int = .is_some_and (\t -> case &t.kind of
    TokenKind::Int _ -> true
    _ -> false) (.peek_at 1 p)
  names_an_operator = .is_some_and (\t -> case &t.kind of
    TokenKind::UserOp _ -> true
    _ -> false) (.peek_at 2 p)
  level_is_an_int && names_an_operator

export(crate) extern_block : &mut Parser -> Vec<Trivia> -> usize -> Result<ExternBlock, ParseError>
extern_block p leading start =
  (.expect (&TokenKind::Kw Keyword::Extern) "expected `extern`" p)?
  abi = case &(.peek p).kind of
    TokenKind::Str { raw, .. } -> .clone raw
    _ ->
      return Err (ParseError::expected "expected an ABI string after `extern`, as in `extern \"C\"`" (.peek_span p))
  .advance p
  (.newline_with_trailing "expected a line break after the ABI" p)?
  mut decls = Vec::new ()
  (.expect (&TokenKind::Indent) "expected indented `extern` declarations" p)?
  loop
    .skip_separators p
    if .check (&TokenKind::Dedent) p || .at_eof p
      break
    decl_leading = .peek_leading p
    decl_start = (.peek_span p).0
    name = (.ident "expected a foreign function's name" p)?
    (.expect (&TokenKind::Colon) "expected `:` after the foreign function's name" p)?
    spine = (parse_spine p)?
    span = (decl_start, (.prev_span p).1)
    .push (ForeignFn { name, sig = signature_only (&spine) span, span, leading = decl_leading }) decls
    (.newline_with_trailing "expected a line break after the declaration" p)?
  (.expect (&TokenKind::Dedent) "expected the `extern` block to end" p)?
  Ok (ExternBlock { abi, decls, span = (start, (.prev_span p).1), leading })

export(crate) import_decl : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<ImportDecl, ParseError>
import_decl p leading start visibility =
  (.expect (&TokenKind::Kw Keyword::Import) "expected `import`" p)?
  path = (import_path p)?
  alias = if .check (&TokenKind::Kw Keyword::As) p
    .advance p
    Some (.ident "expected a name after `as`" p)?
  else
    None
  Ok (ImportDecl { path, alias, visibility, span = (start, (.prev_span p).1), leading })

export(crate) import_path : &mut Parser -> Result<String, ParseError>
import_path p =
  start = .peek_span p
  mut depth : i32 = 0
  mut text = String::new ()
  loop
    kind = &(.peek p).kind
    ends = case kind of
      TokenKind::Newline or TokenKind::Indent or TokenKind::Dedent or TokenKind::Eof or TokenKind::Kw (Keyword::As) -> true
      _ -> false
    if depth == 0 && ends
      break
    case kind of
      TokenKind::LBrace -> depth += 1
      TokenKind::RBrace -> depth -= 1
      _ -> ()
    renames = case kind of
      TokenKind::Kw (Keyword::As) -> true
      _ -> false
    if renames
      .push_str " as " text
      .advance p
      continue
    .push_str (&token_text kind) text
    separates = case kind of
      TokenKind::Comma -> true
      _ -> false
    if separates
      .push ' ' text
    .advance p
  if .is_empty text
    return Err (ParseError::r#with Code::ExpectedName "expected a module path after `import`" start)
  Ok text

export(crate) local_test : &mut Parser -> Result<(), ParseError>
local_test p =
  if !.check (&TokenKind::Kw Keyword::Test) p
    return Ok ()
  keyword = .peek_span p
  _dropped = test_decl p (Vec::new ()) keyword.0
  Err $ ParseError::with_help Code::LocalTest "a `test` declaration belongs at module scope, and this one is inside a body" "move it out to the left margin: rustc does not collect a nested `#[test]` — it warns `cannot test inner items` and the test silently never runs (plan 55 §1.5)" keyword

export(crate) module_decl : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<ModuleDecl, ParseError>
module_decl p leading start visibility =
  (.expect (&TokenKind::Kw Keyword::Module) "expected `module`" p)?
  name = (.ident "expected the module's name" p)?
  has_body = .check (&TokenKind::Newline) p && .is_some_and (\t -> t.kind == TokenKind::Indent) (.peek_at 1 p)
  if !has_body
    return Ok (ModuleDecl { name, items = None, visibility, span = (start, (.prev_span p).1), leading })
  .advance p
  .advance p
  items = (.items_until_dedent p)?
  Ok (ModuleDecl { name, items = Some items, visibility, span = (start, (.prev_span p).1), leading })

export(crate) operator_decl : &mut Parser -> Vec<Trivia> -> usize -> Result<OperatorDecl, ParseError>
operator_decl p leading start =
  word = (.ident "expected `infix`, `infixl` or `infixr`" p)?
  guard Fixity::from_keyword (.as_str word.text) is Some fixity else
    return Err $ ParseError::r#with Code::OperatorShape "expected `infix`, `infixl` or `infixr`" word.span
  at_level = .peek_span p
  guard &(.peek p).kind is TokenKind::Int digits else
    return Err $ ParseError::with_help Code::OperatorShape "expected a precedence after the fixity keyword" "the scale is Haskell's 0 to 9 — `infixl 6 <+> = Set::union`" at_level
  guard digit_precedence (.as_str digits) is Some level else
    return Err $ ParseError::with_help Code::OperatorPrecedence "a declared precedence must be a single digit, 0 to 9" "the scale is Haskell's, and `Fixity::powers` maps it onto the binding powers between `|>` and `+`. Every user operator binds looser than arithmetic, which is what keeps a familiar expression meaning what it looks like. No suffix and no separator — `infixl 6`, not `infixl 6u8`" at_level
  .advance p
  at_spelling = .peek_span p
  guard &(.peek p).kind is TokenKind::UserOp text else
    return Err $ ParseError::with_help Code::OperatorShape "expected an assignable operator after the precedence" "the admissible spellings are closed: `<+>`, `<->`, `<*>`, `</>`, `<%>`, `<|>`, `<&>`, `<^>`, `<=>`, `<~>`, `<$>`, `<?>`. `ASSIGNABLE_OPERATORS` records why" at_spelling
  spelling = Ident { text = .clone text, span = at_spelling }
  .advance p
  (.expect (&TokenKind::Eq) "expected `=` after the operator's spelling" p)?
  target = (alias_target p (&spelling))?
  .insert (.clone spelling.text) (fixity, level, .clone target) p.fixities
  (.newline_with_trailing "expected a line break after the operator declaration" p)?
  Ok (OperatorDecl { spelling, fixity, precedence = level, target, span = (start, (.prev_span p).1), leading })

export(crate) pattern_synonym : &mut Parser -> Vec<Trivia> -> usize -> Result<PatternSynonym, ParseError>
pattern_synonym p leading start =
  .advance p
  name = (.ident "expected a name for the pattern synonym" p)?
  mut params = Vec::new ()
  while .try_ident p is Some param
    .push param params
  (.expect (&TokenKind::Eq) "expected `=` after the pattern synonym's name" p)?
  body = (pattern_alt p)?
  (.newline_with_trailing "expected a line break after the pattern synonym" p)?
  declared : Vec<String> = params |> .iter |> .map (\i -> .clone i.text) |> .collect
  for bound in .binders body
    if !.contains (&bound) declared
      message = format! \-> "`#{bound}` is not a parameter of this pattern synonym, so it would introduce a name the use site never wrote"
      return Err $ ParseError::with_help Code::PatternSynonymShape message "a synonym's body may bind only its own parameters — `pattern Both a b = (Some a, Some b)` declares `a` and `b` and binds exactly those. A name from nowhere is what `docs/DECLINED.md` refuses `RecordWildCards` for" name.span
  Ok (PatternSynonym { name, params, body, span = (start, (.prev_span p).1), leading })

export(crate) retired_spelling : &Ident -> Option<ParseError>
retired_spelling name =
  replacement = case .as_str name.text of
    "assert" -> "`assert! \\-> cond`, or `assert! \\-> a == b` for a comparison"
    "panic" -> "`panic! \\-> \"message\"`"
    "print" -> "`println! \\-> \"\#{x}\"`, or `eprintln!` to write to stderr"
    "todo" -> "`todo!`"
    "unimplemented" -> "`unimplemented!`"
    "unreachable" -> "`unreachable!`"
    _ ->
      return None
  message = format! \-> "`#{name.text}` is not a construct any more — macros are callable, so write #{replacement}"
  Some $ ParseError::with_help Code::RetiredSpelling message "`!` marks a macro's name and `\\->` opens each argument, so no bracket is needed: `println! \\-> \"\#{total} rows\"`" name.span

export(crate) rewritten : &str -> &str -> &str -> String
rewritten text var subject =
  mut out = String::with_capacity (.len text)
  mut word = String::new ()
  for ch in .chars text
    if .is_alphanumeric ch || ch == '_'
      .push ch word
      continue
    flush_word (&mut out) (&mut word) var subject
    .push ch out
  flush_word (&mut out) (&mut word) var subject
  out

export(crate) starts_a_declaration : &Parser -> bool
starts_a_declaration p =
  case (.peek p).kind of
    TokenKind::Kw (Keyword::Data or Keyword::Newtype or Keyword::Union or Keyword::Type or Keyword::Class or Keyword::Instance or Keyword::Errors or Keyword::Import or Keyword::Const or Keyword::Static) -> true
    _ -> false

export(crate) test_decl : &mut Parser -> Vec<Trivia> -> usize -> Result<TestDecl, ParseError>
test_decl p leading start =
  (.expect (&TokenKind::Kw Keyword::Test) "expected `test`" p)?
  description = case &(.peek p).kind of
    TokenKind::Str { raw, .. } -> .clone raw
    _ ->
      return Err (ParseError::expected "expected the test's description, as a string literal" (.peek_span p))
  .advance p
  (.newline_with_trailing "expected a line break after the description" p)?
  body = (.indented_block Code::EmptyBody "expected an indented test body" p)?
  Ok (TestDecl { description, body, span = (start, (.prev_span p).1), leading })

export(crate) type_alias : &mut Parser -> Vec<Trivia> -> usize -> Visibility -> Result<TypeAlias, ParseError>
type_alias p leading start visibility =
  (.expect (&TokenKind::Kw Keyword::Type) "expected `type`" p)?
  name = (.ident "expected a name after `type`" p)?
  (.expect (&TokenKind::Eq) "expected `=` after the alias's name" p)?
  ty = (capture_type p "expected a type" TypeStop::Greedy)?
  Ok (TypeAlias { name, ty, visibility, span = (start, (.prev_span p).1), leading })

export(crate) visibility : &mut Parser -> Result<Visibility, ParseError>
visibility p =
  if !.check (&TokenKind::Kw Keyword::Export) p
    return Ok Visibility::Private
  .advance p
  if !.check (&TokenKind::LParen) p
    return Ok Visibility::Public
  .advance p
  scope = if .check (&TokenKind::Kw Keyword::In) p
    .advance p
    mut path = String::new ()
    while !.check (&TokenKind::RParen) p && !.at_eof p
      .push_str (&token_text (&(.peek p).kind)) path
      .advance p
    if .is_empty path
      return Err (ParseError::expected "expected a module path after `in`" (.peek_span p))
    Visibility::In path
  else
    word = token_text $ &(.peek p).kind
    .advance p
    case .as_str word of
      "crate" -> Visibility::Crate
      "super" -> Visibility::Super
      _ ->
        return Err (ParseError::expected "expected `crate`, `super` or `in` inside `export(…)`" (.prev_span p))
  (.expect (&TokenKind::RParen) "expected `)` to close `export(…)`" p)?
  Ok scope

export(crate) walk_item_for_tails : &Item -> &mut Vec<ParseError> -> ()
walk_item_for_tails item problems =
  case item of
    Item::Fn decl ->
      for clause in &decl.clauses
        if .plain clause.body is Some block
          .extend (return_in_tail block) problems
        if !.is_empty clause.wheres
          .extend (return_in_tail (&Block { stmts = .clone clause.wheres, span = clause.span })) problems
    Item::Class decl ->
      for member in &decl.members
        walk_member_for_tails member problems
    Item::Instance decl ->
      for member in &decl.members
        walk_member_for_tails member problems
    Item::Test decl -> .extend (return_in_tail (&decl.body)) problems
    Item::Module decl ->
      for inner in .flatten (.iter decl.items)
        walk_item_for_tails inner problems
    Item::Data _ or Item::Type _ or Item::Errors _ or Item::Import _ or Item::Const _ or Item::InlineRust _ or Item::Extern _ or Item::PatternSynonym _ or Item::DeriveTemplate _ or Item::OperatorDecl _ -> ()
  ()
