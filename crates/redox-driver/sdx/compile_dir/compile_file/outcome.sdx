import std::path::PathBuf

-- | What compiling one file produced.
-- |
-- | Plan 10 (`docs/15 - 10 - Incremental Cache.md`) leaf 5. `was_cached` is
-- | reported, never acted on: no caller may behave differently because a result
-- | came from cache, which is what keeps plan 10 §1's rule — *a hit is strictly
-- | an optimization* — true by construction rather than by discipline.
export(crate) data Outcome = Outcome {
  -- | The `.rs` written.
  export(crate) written : PathBuf,
  -- | Whether the cache supplied the content.
  export(crate) was_cached : bool,
}
  deriving (Debug, Clone, PartialEq, Eq)
