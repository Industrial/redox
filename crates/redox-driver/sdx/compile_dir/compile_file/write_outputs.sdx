import crate::cache::store::cached::Cached
import crate::diagnose::io_diagnostic::io_diagnostic
import redox_diag::Diagnostic
import std::path::{Path, PathBuf}

-- | Write the generated Rust and its map, whatever their provenance.
-- |
-- | Plan 10 (`docs/15 - 10 - Incremental Cache.md`) leaf 5. Shared by the cache
-- | hit and miss paths **so the two cannot diverge**. If they wrote different
-- | bytes, a cache hit would change the build — precisely what plan 10 §1
-- | forbids — and the difference would appear only on a second run, which is
-- | the hardest kind of bug to reproduce.
-- |
-- | The hit path writes rather than assuming last run's files survive.
-- | `OUT_DIR` does persist, but so does a half-finished build, and a write of
-- | a few kilobytes makes the question moot.
export(crate) write_outputs : &Path -> &Path -> &str -> &Cached -> Result<PathBuf, Vec<Diagnostic>>
write_outputs source out path content =
  stem = .map_or_else (\-> .to_string "generated") (\s -> .to_string (.to_string_lossy s)) (.file_stem source)
  target = .join (format! \-> "#{stem}.rs") out

  out_shown = out |> .display |> .to_string
  (.map_err (\e -> vec! \-> io_diagnostic path (format! \-> "cannot create #{out_shown}: #{e}")) (std::fs::create_dir_all out))?
  target_shown = target |> .display |> .to_string
  -- `content.r#rust`, because `rust` is a Redox keyword and the translator
  -- renamed the field. The first collision to reach a *use* site.
  (.map_err (\e -> vec! \-> io_diagnostic path (format! \-> "cannot write #{target_shown}: #{e}")) (std::fs::write (&target) (&content.r#rust)))?

  mut map_name = .to_os_string (.expect "a name" (.file_name target))
  map_name |> .push ".map"
  sidecar = .with_file_name map_name target
  sidecar_shown = sidecar |> .display |> .to_string
  (.map_err (\e -> vec! \-> io_diagnostic path (format! \-> "cannot write #{sidecar_shown}: #{e}")) (std::fs::write (&sidecar) (&content.map)))?

  Ok target
