import crate::remap
import crate::remap::RustcMessage
import redox_diag::Diagnostic
import redox_diag::DiagnosticCode
import redox_parser::ParseFailure
import std::path::Path
import std::path::PathBuf
import std::process::Command

export check : &Path -> &str -> Result<CheckOutcome, String>
check path source =
  sdx_path = path |> .display |> .to_string

  program = case redox_parser::parse_source source of
    Ok parsed -> parsed
    Err failure ->
      return Ok (CheckOutcome { diagnostics = diagnose path source (&failure), failed = true })

  mut diagnostics = crate::lint path source (Some (&program))

  emitted = redox_emit::emit_with_map (&program) source (&sdx_path)

  rustc = (.ok_or_else (\-> .to_string "error: no rustc found. `redox check` compiles the generated Rust, so it needs the Rust toolchain on PATH.") (rustc_path ()))?

  dir = (ScratchDir::new "check")?
  xrs = dir |> .path |> .join "check.xrs"
  xrs_path = xrs |> .display |> .to_string
  (.map_err (\e -> format! \-> "error: cannot write #{xrs_path}: #{e}") (std::fs::write (&xrs) (&emitted.0)))?

  rustc_shown = rustc |> .display |> .to_string
  invoked = Command::new (&rustc)
    |> .args (["--edition", "2024", "--error-format=short", "--emit=metadata"])
    |> .arg "-o"
    |> .arg (.join "check.rmeta" (.path dir))
    |> .arg (&xrs)
    |> .output
  out = (.map_err (\e -> format! \-> "error: cannot run #{rustc_shown}: #{e}") invoked)?

  stderr = String::from_utf8_lossy (&out.stderr)
  messages : Vec<RustcMessage> = stderr
    |> .lines
    |> .filter_map RustcMessage::parse
    |> .collect
  failed = messages |> .iter |> .any RustcMessage::is_error
  remapped = .map (\m -> remap m (&emitted.1) (&sdx_path) source (&xrs_path) (&emitted.0)) (.iter messages)
  .extend remapped diagnostics

  if .is_empty messages && !.success out.status
    trimmed = .trim_end stderr
    return Err (format! \-> "error: rustc failed:\n#{trimmed}")

  Ok (CheckOutcome { diagnostics, failed })

export data CheckOutcome = CheckOutcome { export diagnostics : Vec<Diagnostic>, export failed : bool }
  deriving (Debug, Clone, Default)

export(crate) data ScratchDir = ScratchDir PathBuf

instance ScratchDir
  export(crate) new : &str -> Result<Self, String>
  new tag =
    n = .fetch_add 1 std::sync::atomic::Ordering::Relaxed NEXT
    pid = std::process::id ()
    dir = .join (format! \-> "redox-#{tag}-#{pid}-#{n}") (std::env::temp_dir ())
    shown = dir |> .display |> .to_string
    (.map_err (\e -> format! \-> "error: cannot create #{shown}: #{e}") (std::fs::create_dir_all (&dir)))?
    Ok $ ScratchDir dir

  export(crate) path : &self -> &Path
  path self = &self.0

instance Drop ScratchDir
  drop : &mut self -> ()
  drop self =
    _dropped = .ok $ std::fs::remove_dir_all (&self.0)
    ()

test "creates and removes itself"
  gone =
    dir = .expect "should create" $ ScratchDir::new "test"
    live = dir |> .path |> .to_path_buf
    assert! \-> .is_dir live
    live
  assert! \-> !.exists gone \-> "the directory should be gone after the drop"

test "two directories do not collide"
  a = .expect "should create" $ ScratchDir::new "test"
  b = .expect "should create" $ ScratchDir::new "test"
  assert_ne! \-> .path a \-> .path b

export(crate) static NEXT : std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new 0

export diagnose : &Path -> &str -> &ParseFailure -> Vec<Diagnostic>
diagnose path source failure =
  shown = path |> .display |> .to_string
  case failure of
    ParseFailure::Lex e ->
      vec! \-> Diagnostic { code = .into e.code, severity = redox_diag::Severity::Error, message = .clone e.message, span = e.span, help = .clone e.help, path = shown, source = .to_string source }
    ParseFailure::Parse problems ->
      problems
        |> .iter
        |> .map (\e -> Diagnostic { code = .into e.code, severity = redox_diag::Severity::Error, message = .clone e.message, span = e.span, help = .clone e.help, path = .clone shown, source = .to_string source })
        |> .collect

test "carries a lex errors code and help across"
  source = "main : ()\nmain =\n\tprint 1\n"
  failure = .expect_err "a tab is an error" $ redox_parser::parse_source source
  diagnostics = diagnose (Path::new "a.sdx") source (&failure)
  assert_eq! \-> .len diagnostics \-> 1
  assert_eq! \-> .text diagnostics[0].code \-> "RDX0001"
  assert_eq! \-> diagnostics[0].path \-> "a.sdx"
  assert! \-> .is_some diagnostics[0].help \-> "the lexer's help survives"

test "reports every recovered parse error"
  source = "a : ()\na =\n  + 1\n\nb : ()\nb =\n  * \n"
  failure = .expect_err "should fail" $ redox_parser::parse_source source
  diagnostics = diagnose (Path::new "a.sdx") source (&failure)
  count = .len diagnostics
  assert! \-> count >= 2 \-> "expected a diagnostic per error, got #{count}"
  assert! \-> .all (\d -> d.source == source) (.iter diagnostics)

export(crate) io_diagnostic : &str -> String -> Diagnostic
io_diagnostic path message =
  Diagnostic { code = DiagnosticCode::Foreign (.to_string "io"), severity = redox_diag::Severity::Error, message, span = (0, 0), help = None, path = .to_string path, source = String::new () }

test "renders without a snippet"
  d = io_diagnostic "a.sdx" (.to_string "cannot read a.sdx: missing")
  assert_eq! \-> .text d.code \-> "io"
  assert_eq! \-> d.path \-> "a.sdx"
  out = redox_diag::render (std::slice::from_ref (&d)) true
  assert! \-> .contains "cannot read" out \-> "#{out}"
  assert! \-> !.contains "  |" out \-> "no snippet should be drawn:\n#{out}"

export rustc_path : Option<PathBuf>
rustc_path =
  from_path = std::env::var_os "PATH"
    |> .into_iter
    |> .flat_map (\paths ->
    dirs : Vec<PathBuf> = std::env::split_paths (&paths)
      |> .map (\dir -> .join "rustc" dir)
      |> .collect
    dirs)
  baked = std::iter::once $ PathBuf::from $ env! \-> "REDOX_RUSTC"
  from_env = std::env::var_os "RUSTC"
    |> .map PathBuf::from
    |> .into_iter

  from_path
    |> .chain baked
    |> .chain from_env
    |> .find (\candidate -> is_real_rustc candidate)

test "finds a rustc"
  found = .expect "the toolchain should provide a rustc" $ rustc_path ()
  shown = .display found
  assert! \-> is_real_rustc (&found) \-> "#{shown} is not rustc"

export(crate) is_real_rustc : &Path -> bool
is_real_rustc candidate =
  if !.is_file candidate
    return false
  probed = Command::new candidate |> .arg "--version" |> .output
  .is_ok_and (\o -> .success o.status && .starts_with "rustc " (String::from_utf8_lossy (&o.stdout))) probed

test "rejects a program that is not rustc"
  assert! \-> !is_real_rustc (Path::new "/bin/sh")

test "rejects a path that does not exist"
  assert! \-> !is_real_rustc (Path::new "/nonexistent/rustc")

test "rejects a directory"
  assert! \-> !is_real_rustc (Path::new "/tmp")
