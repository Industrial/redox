import crate::lint::program_walk::ProgramWalk
import crate::lint::walk_item::walk_item
import redox_ast::Program

-- | Walk a whole program — plan 53 leaf 4, shared by plan 54 leaf 3.
-- |
-- | The entry point every lint that needs the tree goes through, so there is
-- | one answer to *what does a lint see*. What it does with what it sees is
-- | [`ProgramWalk`]'s.
export(crate) walk_program : &Program -> &mut dyn ProgramWalk -> ()
walk_program program walk =
  for item in &program.items
    walk_item item walk
  ()
