import redox_ast::Binding
import redox_ast::ClassMember
import redox_ast::ClauseBody
import redox_ast::Expr
import redox_ast::Ident
import redox_ast::Item
import redox_ast::Pattern
import redox_ast::Program
import redox_ast::Stmt
import redox_diag::Code
import redox_diag::Diagnostic
import redox_diag::DiagnosticCode
import redox_diag::Lint
import redox_diag::Severity
import redox_diag::Span
import redox_lexer::TokenKind
import redox_lexer::Trivia
import redox_lexer::TriviaKind
import std::path::Path

export lint : &Path -> &str -> Option<&Program> -> Vec<Diagnostic>
lint path source program =
  shown = path |> .display |> .to_string
  warning = \code message span help -> Diagnostic { code, severity = Severity::Warning, message, span, help = Some help, path = .clone shown, source = .to_string source }

  unwraps = unwrap_call_sites source program
    |> .into_iter
    |> .map (\span -> warning (DiagnosticCode::from Code::UnwrapUsed) (.to_string UNWRAP_MESSAGE) span (.to_string "if a panic is intended here, say so on the line above: `\#[redox::allow(unwrap)]`"))

  pragmas = comment_pragma_sites source
    |> .into_iter
    |> .map (\pair ->
    span = pair.0
    named = pair.1
    code_text = named |> .code |> .text
    help = format! \-> "the comment still suppresses `#{code_text}` for this milestone; the attribute is what plan 64 keeps"
    warning (DiagnosticCode::from Code::CommentAllowPragma) (comment_pragma_message named) span help)

  mut found : Vec<Diagnostic> = .collect (.chain pragmas unwraps)

  if program is Some tree
    shadows = shadow_sites tree
      |> .into_iter
      |> .map (\pair ->
      span = pair.0
      name = pair.1
      warning (DiagnosticCode::from Code::ShadowedBinding) (shadow_message (&name)) span (.to_string SHADOW_HELP))
    .extend shadows found

  .sort_by_key (\d -> d.span) found
  found

export(crate) allow_pragma : &Trivia -> Lint -> bool
allow_pragma trivium lint =
  attribute_pragma trivium == Some lint || comment_pragma trivium == Some lint

export(crate) attribute_pragma : &Trivia -> Option<Lint>
attribute_pragma trivium_attribute_pragma = case trivium_attribute_pragma.kind of
  TriviaKind::Attribute -> Lint::from_allow_attribute $ .trim trivium_attribute_pragma.text
  _ -> None

#[cfg(test)]
trivium_attribute_pragma : TriviaKind -> &str -> Trivia
trivium_attribute_pragma kind text = Trivia { kind, text = .to_string text, span = (0, 0) }

test "the attribute suppresses"
  assert_eq! \-> attribute_pragma (&trivium_attribute_pragma TriviaKind::Attribute "redox::allow(unwrap)") \-> Some Lint::Unwrap

test "each lint is suppressed by its own name"
  assert_eq! \-> attribute_pragma (&trivium_attribute_pragma TriviaKind::Attribute "redox::allow(shadow)") \-> Some Lint::Shadow

test "an unknown lint name is not a pragma"
  assert_eq! \-> attribute_pragma (&trivium_attribute_pragma TriviaKind::Attribute "redox::allow(unwarp)") \-> None

test "an unnamespaced allow is rustc's"
  assert_eq! \-> attribute_pragma (&trivium_attribute_pragma TriviaKind::Attribute "allow(unwrap)") \-> None

test "whitespace inside the brackets is not normalised"
  assert_eq! \-> attribute_pragma (&trivium_attribute_pragma TriviaKind::Attribute "redox :: allow( unwrap )") \-> None

test "an inner attribute does not suppress"
  assert_eq! \-> attribute_pragma (&trivium_attribute_pragma TriviaKind::InnerAttribute "redox::allow(unwrap)") \-> None

export(crate) binding_name : &Binding -> Option<&Ident>
binding_name binding = case &binding.pattern of
  Pattern::Binding ident -> Some ident
  Pattern::Literal { .. } or Pattern::Wildcard _ or Pattern::Range { .. } or Pattern::Apply { .. } or Pattern::Tuple { .. } or Pattern::Slice { .. } or Pattern::Record { .. } or Pattern::As { .. } or Pattern::Rest _ or Pattern::NamedRest { .. } or Pattern::Or _ -> None

export(crate) comment_pragma : &Trivia -> Option<Lint>
comment_pragma trivium_comment_pragma = case trivium_comment_pragma.kind of
  TriviaKind::LineComment -> Lint::from_allow_comment $ .trim trivium_comment_pragma.text
  _ -> None

#[cfg(test)]
trivium_comment_pragma : TriviaKind -> &str -> Trivia
trivium_comment_pragma kind text = Trivia { kind, text = .to_string text, span = (0, 0) }

test "the pragma suppresses"
  assert_eq! \-> comment_pragma (&trivium_comment_pragma TriviaKind::LineComment "redox: allow unwrap") \-> Some Lint::Unwrap

test "each lint is suppressed by its own name"
  assert_eq! \-> comment_pragma (&trivium_comment_pragma TriviaKind::LineComment "redox: allow shadow") \-> Some Lint::Shadow

test "an unrelated comment does not suppress"
  assert_eq! \-> comment_pragma (&trivium_comment_pragma TriviaKind::LineComment "allow unwrap here, it cannot fail") \-> None

test "a doc comment does not suppress"
  assert_eq! \-> comment_pragma (&trivium_comment_pragma TriviaKind::DocComment "redox: allow unwrap") \-> None

export(crate) comment_pragma_message : Lint -> String
comment_pragma_message lint =
  comment = .allow_comment lint
  attribute = .allow_attribute lint
  format! \-> "`-- #{comment}` is deprecated — write `\#[#{attribute}]` on the line above instead (plan 53 §1.3)"

test "the unwrap wording is plan 53's"
  assert_eq! \-> comment_pragma_message Lint::Unwrap \-> "`-- redox: allow unwrap` is deprecated — write `\#[redox::allow(unwrap)]` on the line above instead (plan 53 §1.3)"

test "each lint gets its own spellings"
  text = comment_pragma_message Lint::Shadow
  assert! \-> .contains "-- redox: allow shadow" text
  assert! \-> .contains "\#[redox::allow(shadow)]" text

export(crate) comment_pragma_sites : &str -> Vec<(Span, Lint)>
comment_pragma_sites source =
  guard redox_lexer::lex source is Ok tokens else
    return Vec::new ()

  tokens
    |> .iter
    |> .flat_map (\t -> .chain (.as_ref t.trailing) (.iter t.leading))
    |> .filter_map (\trivium -> .map (\lint -> (trivium.span, lint)) (comment_pragma trivium))
    |> .collect

export(crate) line_of : &str -> usize -> usize
line_of source offset =
  end = .min (.len source) offset
  .count (.matches '\n' source[0 .. end]) + 1

export(crate) data PragmaWalk = PragmaWalk { export(crate) lint : Lint, export(crate) found : Vec<Span> }

instance ProgramWalk PragmaWalk
  item : &mut self -> &Item -> ()
  item self item =
    if .any (\t -> allow_pragma t self.lint) (.iter (redox_ast::leading item))
      .push (.span item) self.found
    ()

  stmts : &mut self -> &[Stmt] -> ()
  stmts self stmts =
    for stmt in stmts
      if .any (\t -> allow_pragma t self.lint) (.iter stmt.leading)
        .push stmt.span self.found
    ()

export(crate) class ProgramWalk
  item : &mut self -> &Item -> ()

  stmts : &mut self -> &[Stmt] -> ()

export(crate) const SHADOW_HELP : &str = "to reassign instead, write `:=` and `mut` on the first binding; if the shadow is meant, say so on the line above: `#[redox::allow(shadow)]`"

export(crate) shadow_message : &str -> String
shadow_message name =
  format! \-> "`#{name}` is already bound in this block — a bare `=` binds a second name rather than reassigning the first (plan 54 §1.1)"

test "it names the shadowed binding"
  assert! \-> .starts_with "`cursor` is already bound" (shadow_message "cursor")

export(crate) shadow_sites : &Program -> Vec<(Span, String)>
shadow_sites program =
  mut walk = ShadowWalk { found = Vec::new () }
  walk_program program (&mut walk)

  ranges = suppressed_spans program Lint::Shadow
  walk.found
    |> .into_iter
    |> .filter (\pair ->
    span = pair.0
    !.any (\r -> r.0 <= span.0 && span.1 <= r.1) (.iter ranges))
    |> .collect

export(crate) data ShadowWalk = ShadowWalk { export(crate) found : Vec<(Span, String)> }

instance ProgramWalk ShadowWalk
  item : &mut self -> &Item -> ()
  item self _item = ()

  stmts : &mut self -> &[Stmt] -> ()
  stmts self stmts =
    mut bound : Vec<&str> = Vec::new ()
    for stmt in stmts
      guard &stmt.expr is Expr::Binding binding else
        continue
      guard binding_name binding is Some ident else
        continue

      suppressed = .is_some_and (\t -> allow_pragma t Lint::Shadow) (.as_ref stmt.trailing)

      if .contains (&.as_str ident.text) bound && !suppressed
        .push (ident.span, .clone ident.text) self.found
      .push (&ident.text) bound
    ()

export(crate) suppressed_spans : &Program -> Lint -> Vec<Span>
suppressed_spans program lint =
  mut walk = PragmaWalk { lint, found = Vec::new () }
  walk_program program (&mut walk)
  walk.found

export(crate) unwrap_call_sites : &str -> Option<&Program> -> Vec<Span>
unwrap_call_sites source program =
  guard redox_lexer::lex source is Ok tokens else
    return Vec::new ()

  suppressed : Vec<usize> = tokens
    |> .iter
    |> .flat_map (\t -> .chain (.as_ref t.trailing) (.iter t.leading))
    |> .filter (\trivium -> allow_pragma trivium Lint::Unwrap)
    |> .map (\trivium -> line_of source trivium.span.0)
    |> .collect

  ranges = program
    |> .map (\p -> suppressed_spans p Lint::Unwrap)
    |> .unwrap_or_default

  tokens
    |> .windows 2
    |> .filter (\pair -> pair[0].kind == TokenKind::Dot)
    |> .filter_map (\pair ->
    case &pair[1].kind of
      TokenKind::Ident name | name == "unwrap" || name == "expect" -> Some pair[1].span
      _ -> None)
    |> .filter (\span -> !.contains (&line_of source span.0) suppressed)
    |> .filter (\span -> !.any (\r -> r.0 <= span.0 && span.1 <= r.1) (.iter ranges))
    |> .collect

export(crate) const UNWRAP_MESSAGE : &str = "`unwrap` and `expect` panic — the ergonomic path is `?`, `??` or `catch` (doc 03 §12.7)"

export(crate) walk_item : &Item -> &mut dyn ProgramWalk -> ()
walk_item item walk =
  .item item walk

  case item of
    Item::Fn decl ->
      for clause in &decl.clauses
        case &clause.body of
          ClauseBody::Plain block -> walk_stmts (&block.stmts) walk
          ClauseBody::Guarded rows ->
            for row in rows
              walk_stmts (&row.body.stmts) walk
        walk_stmts (&clause.wheres) walk
    Item::Class decl ->
      for member in &decl.members
        walk_member member walk
    Item::Instance decl ->
      for member in &decl.members
        walk_member member walk
    Item::Test decl -> walk_stmts (&decl.body.stmts) walk
    Item::Module decl ->
      for inner in .flatten (.iter decl.items)
        walk_item inner walk
    Item::Data _ or Item::Type _ or Item::Errors _ or Item::Import _ or Item::Const _ or Item::InlineRust _ or Item::Extern _ or Item::PatternSynonym _ or Item::DeriveTemplate _ or Item::OperatorDecl _ -> ()
  ()

export(crate) walk_member : &ClassMember -> &mut dyn ProgramWalk -> ()
walk_member member walk =
  if member is ClassMember::Method decl
    walk_item (&Item::Fn (.clone decl)) walk
  ()

export(crate) walk_program : &Program -> &mut dyn ProgramWalk -> ()
walk_program program walk =
  for item in &program.items
    walk_item item walk
  ()

export(crate) walk_stmts : &[Stmt] -> &mut dyn ProgramWalk -> ()
walk_stmts stmts walk =
  .stmts stmts walk

  for stmt in stmts
    for nested in .statement_blocks stmt.expr
      walk_stmts (&nested.stmts) walk
  ()
