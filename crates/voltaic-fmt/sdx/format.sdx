import crate::stmt_text::trivia_text
import voltaic_ast::Program
import voltaic_ast::{Expr, Item, Pattern, Stmt}
import crate::expr_text::expr_text
import crate::item_text::item_text
import crate::stmt_text::stmt_text
import crate::pattern_text::pattern_text

export class Render
  render : usize -> &str -> &self -> String

export format : &Program -> &str -> String
format program source =
  mut out = String::new ()
  mut first = true
  for item in &program.items
    mut text = .render 0 source item
    if first
      first := false
      text := String::from $ .trim_start_matches '\n' text
    out |> .push_str (&text)
    out |> .push '\n'
  for trivium in &program.trailing
    .push_str (&trivia_text trivium 0) out
    .push '\n' out
  trimmed_tail out

export(crate) trimmed_tail : String -> String
trimmed_tail text =
  mut text = text
  while .ends_with "\n\n" text
    .pop text
  text

instance Render Item
  render indent src self = item_text self indent src

instance Render Stmt
  render indent src self = stmt_text self indent src

instance Render Expr
  render indent src self = expr_text self 0 indent src

instance Render Pattern
  render _indent _src self = pattern_text self
