import crate::diagnostic::Diagnostic
import crate::diagnostic::line_and_column::diagnostic_line_and_column
import redox_diag::Severity

-- | Project a compiler diagnostic onto the wire shape.
-- |
-- | Plan 50 §1.3. The two fields that do **not** cross are the point of the
-- | function: `source` is the whole file and stays behind, and `span` becomes a
-- | line and a column.
-- |
-- | The span's **start** is what is reported. A range would be more
-- | information, and plan 05 keeps one so `miette` can underline a statement —
-- | but an MCP client quotes a position, and offering an end column that is
-- | sometimes the whole statement and sometimes one token would be a field
-- | nobody could rely on. Narrowed deliberately; plan 50 §10 records it.
export(crate) diagnostic_from_redox : &redox_diag::Diagnostic -> Diagnostic
diagnostic_from_redox diagnostic =
  position = diagnostic_line_and_column (&diagnostic.source) diagnostic.span.0
  severity = case diagnostic.severity of
    Severity::Error -> "error"
    Severity::Warning -> "warning"
  Diagnostic { code = .text diagnostic.code, severity = .to_string severity, message = .clone diagnostic.message, path = .clone diagnostic.path, line = position.0, column = position.1, help = .clone diagnostic.help }
