import crate::build::request::BuildRequest
import crate::build::response::BuildResponse
import crate::diagnostic::from_redox::diagnostic_from_redox
import redox_driver::diagnose

-- | `redox_build`'s parameters.
export(crate) module request
-- | `redox_build`'s result.
export(crate) module response

-- | `redox_build` — transpile a `.sdx` to `.xrs` and its source-map sidecar.
-- |
-- | Plan 50 leaf 2. The same work `redox build` does, which is why the
-- | sidecar is written too: plan 07 finds a map by the rule *`main.xrs` has
-- | `main.xrs.map`*, and a build that skipped it would leave `redox_source_map`
-- | unable to answer about its own output.
-- |
-- | Unlike [`crate::check::check`] this writes, and the register asks it to —
-- | `redox_build` is the tool for *produce the Rust*. The paths written are
-- | **returned**, so a caller never has to infer them.
export build : &BuildRequest -> Result<BuildResponse, String>
build request =
  path = std::path::Path::new (&request.path)
  shown = .clone request.path
  source = (.map_err (\e -> format! \-> "cannot read #{shown}: #{e}") (std::fs::read_to_string path))?

  -- A syntax error is Redox's own and never reaches the emitter. Returned as a
  -- diagnostic rather than an `Err`, because a program that does not parse is
  -- an answer about the program (plan 50 §5 criterion 2).
  program = case redox_parser::parse_source (&source) of
    Ok parsed -> parsed
    Err failure ->
      return Ok (BuildResponse { ok = false, output = None, map = None, diagnostics = diagnose path (&source) (&failure)
        |> .iter
        |> .map diagnostic_from_redox
        |> .collect })

  diagnostics = redox_driver::lint path (&source) (Some (&program))
  emitted = redox_emit::emit_with_map (&program) (&source) (&request.path)
  -- `generated`, not `rust`: **`rust` is a keyword**, and as a binding name it
  -- earns `RDX0101: expected a """ block of Rust after `rust`` — a diagnostic
  -- about the escape hatch, which is not what the author wrote. Three keyword
  -- collisions in three crates now, and a message naming the collision would
  -- have cost a minute instead of a puzzle.
  generated = emitted.0
  map = emitted.1

  output = .with_extension "xrs" path
  out_shown = output |> .display |> .to_string
  (.map_err (\e -> format! \-> "cannot write #{out_shown}: #{e}") (std::fs::write (&output) (&generated)))?

  -- Same rule as `redox build`: the stem plus `.map`, so `main.xrs` has
  -- `main.xrs.map` rather than `main.map`.
  --
  -- Bound and mutated because `OsString::push` returns `()`, so there is no
  -- value for a pipeline to carry.
  mut map_name = .to_os_string (.expect "a name" (.file_name output))
  .push ".map" map_name
  map_path = .with_file_name map_name output
  map_shown = map_path |> .display |> .to_string
  (.map_err (\e -> format! \-> "cannot write #{map_shown}: #{e}") (std::fs::write (&map_path) (redox_diag::render_map (&map))))?

  Ok (BuildResponse { ok = true, output = Some out_shown, map = Some map_shown, diagnostics = diagnostics
    |> .iter
    |> .map diagnostic_from_redox
    |> .collect })
