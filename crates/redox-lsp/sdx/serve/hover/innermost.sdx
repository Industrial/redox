import crate::serve::declared::declared
import redox_ast::Item

-- | The innermost named declaration whose span contains `offset`.
export(crate) innermost : &[Item] -> usize -> Option<(&'static str, String, (usize, usize))>
innermost items offset =
  mut best : Option<(&'static str, String, (usize, usize))> = None
  for item in items
    span = .span item
    if offset < span.0 || offset > span.1
      continue
    -- A `module` body first, so an inner declaration beats the module that
    -- holds it. `module_items` is `None` for a bodiless `module`, which loads
    -- a file and declares nothing a cursor can be inside.
    if item is Item::Module decl && .as_ref decl.items is Some inner && innermost inner offset is Some deeper
      return Some deeper
    if declared item is Some pair
      best := Some (pair.0, pair.1, span)
  best
