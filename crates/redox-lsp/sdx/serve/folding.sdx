import crate::serve::positions::position_of::position_of
import lsp_types::{FoldingRange, FoldingRangeKind}
import redox_lexer::TokenKind

-- | Every indented block in the document, as a folding range — plan 71 leaf 5.
-- |
-- | # The lexer already did this
-- |
-- | Redox is an off-side-rule language, so *"an indented block"* is not a
-- | heuristic over whitespace — it is a pair of tokens. `redox_lexer::lex`
-- | emits `Indent` and `Dedent`, and the depth they describe is the one the
-- | parser uses, so a fold here closes exactly where a block closes. That is
-- | leaf 5's reason for choosing this capability third: the information is
-- | already computed, and the alternative — counting leading spaces — would be
-- | a second implementation of the off-side rule, free to disagree with the
-- | first.
-- |
-- | # The header line folds, not the first indented one
-- |
-- | A fold starts on the line **above** the `Indent`, which is the line an
-- | editor leaves visible when the range is collapsed. `main =` with four
-- | statements under it collapses to `main =`, which is what a reader wants;
-- | starting at the first statement would collapse the body and leave a blank
-- | gap under the header.
-- |
-- | A one-line block is dropped: a range whose start and end are the same line
-- | gives the editor a fold arrow that does nothing.
-- |
-- | # A document that does not lex answers with nothing
-- |
-- | Not an error — `symbols` and `semantic_tokens` make the same choice for
-- | the same reason. Half a file's folds while the user is mid-edit is worse
-- | than none, because the ranges would be stale exactly where they are being
-- | typed.
export(crate) folding : &str -> Vec<FoldingRange>
folding source =
  guard redox_lexer::lex source is Ok toks else
    return Vec::new ()
  mut found = Vec::new ()
  -- One entry per open block: the line the fold starts on.
  mut open : Vec<u32> = Vec::new ()
  -- The last line that carried a token, which is where a block ends. Read at
  -- the `Dedent` rather than from the `Dedent`'s own span, because a dedent
  -- sits at the start of the line that *ends* the block — so its own line is
  -- already outside it.
  mut last = 0 : u32
  for tok in &toks
    line = (position_of source tok.span.0).line
    case &tok.kind of
      TokenKind::Indent ->
        -- `last` is still the header's line here, because an `Indent` follows
        -- the `Newline` that ended it.
        .push last open
      TokenKind::Dedent ->
        if .pop open is Some start && last > start
          .push (FoldingRange { start_line = start, start_character = None, end_line = last, end_character = None, kind = Some FoldingRangeKind::Region, collapsed_text = None }) found
      TokenKind::Newline or TokenKind::Eof -> ()
      _ -> last := line
  found
