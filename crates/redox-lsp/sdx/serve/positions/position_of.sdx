import lsp_types::Position

-- | One byte offset as a `(line, utf16 character)` position.
-- |
-- | Clamped to the end of the source rather than panicking: a span past the end
-- | means the text changed under a diagnostic computed from an older version,
-- | which is a race an editor can produce and not a defect to crash on.
export(crate) position_of : &str -> usize -> Position
position_of source offset =
  -- `at`, not a rebinding of `offset`: `RDX1003` reports a shadow.
  at = .min (.len source) offset
  -- Closed ranges: a parenthesised half-open range is an operator section.
  before = source |> .get (0 .. at) |> .unwrap_or ""
  line = before |> .matches '\n' |> .count
  line_start = .map_or 0 (+ 1) (.rfind '\n' before)
  -- An ascription where the Rust had `sum::<usize>()`: doc 03 §18 has no
  -- turbofish, and a binding's type says the same thing.
  character : usize = source
    |> .get (line_start .. at)
    |> .unwrap_or ""
    |> .chars
    |> .map char::len_utf16
    |> .sum
  Position { line = .unwrap_or u32::MAX (.ok (u32::try_from line)), character = .unwrap_or u32::MAX (.ok (u32::try_from character)) }
