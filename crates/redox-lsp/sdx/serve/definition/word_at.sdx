-- | The identifier `offset` falls inside, or nothing — plan 71 leaf 5.
-- |
-- | ```text
-- | joined = a <+> b
-- |            ^ -> None, the cursor is on an operator
-- | joined = merge a b
-- |            ^ -> Some "merge"
-- | ```
-- |
-- | # Read from the text, not from the tree
-- |
-- | Every other cursor lookup in this crate goes through the AST, and this one
-- | deliberately does not: an *identifier* is a lexical unit, and the question
-- | is which characters the cursor is among. Walking the tree to answer it would
-- | mean a span lookup over `Expr`'s forty-six forms to arrive at the same
-- | string.
-- |
-- | An offset **one past** an identifier's last character still reads it, which
-- | is what an editor means by a cursor sitting after a word. An offset in
-- | whitespace or on punctuation reads nothing.
-- |
-- | A path's last segment is the answer: the cursor on `union` in
-- | `BTreeSet::union` reads `union`, because `:` is not an identifier
-- | character. That is the right half for `definition` — a file declares
-- | `union`, not `BTreeSet::union` — so no path handling is needed.
-- |
-- | # The boundary is `redox_lexer`'s, restated
-- |
-- | `is_ident_start` and `is_ident_continue` are `pub(crate)` to the lexer, so
-- | this restates their union — ASCII alphanumeric or `_` — rather than calling
-- | them. A restated rule can drift, so `the_word_boundary_matches_the_lexer`
-- | lexes an identifier made of each class and asserts the lexer agrees. That
-- | is the same shape `editors.rs` uses where a highlighter restates the
-- | grammar: the copy is allowed, the silence is not.
export(crate) word_at : &str -> usize -> Option<String>
word_at source offset =
  -- Byte indices, so a multi-byte character cannot be split. Redox's own
  -- source is full of `—` and `§`, so this is the ordinary case rather than
  -- the edge one.
  chars : Vec<(usize, char)> = source |> .char_indices |> .collect
  -- Ascribed, because a bare lambda parameter has no type to infer from: the
  -- first use is a method call, and rustc asks for the annotation. `fn` rather
  -- than a closure type because it captures nothing.
  is_word : fn(char) -> bool = \ch -> .is_ascii_alphanumeric ch || ch == '_'
  -- The character the cursor is on, if any, and otherwise the one before it —
  -- the cursor-after-a-word case.
  mut index = .len chars
  for pair in .enumerate (.iter chars)
    -- `entry` rather than `pair.1.0`: a nested tuple index lexes `1.0` as a
    -- **float**, so the chain needs a binding to break it. `scan_operator`'s
    -- ordering test records the same wart, and Rust spells the way out
    -- `(pair.1).0`.
    entry = pair.1
    if entry.0 >= offset
      index := pair.0
      break
  if index >= .len chars || !is_word chars[index].1
    -- One back. `checked_sub` rather than `index - 1`, because the cursor may
    -- be at offset zero.
    index := (.checked_sub 1 index)?
  if index >= .len chars || !is_word chars[index].1
    return None
  mut lo = index
  while lo > 0 && is_word chars[lo - 1].1
    lo -= 1
  mut hi = index
  while hi + 1 < .len chars && is_word chars[hi + 1].1
    hi += 1
  -- An identifier may not begin with a digit, so a cursor inside `42` reads
  -- nothing rather than a name no file can declare.
  if .is_ascii_digit chars[lo].1
    return None
  start = chars[lo].0
  end = chars[hi].0 + .len_utf8 chars[hi].1
  source |> .get (start .. end) |> .map (\text -> .to_string text)

-- | The restatement above agrees with the lexer it restates.
-- |
-- | Asked of `redox_lexer::lex` rather than of the predicates, which are
-- | `pub(crate)` — so this asserts the observable consequence: a run of
-- | characters this function reads as one word is one `Ident` token, and a
-- | character it stops at ends one.
test "the word boundary matches the lexer"
  source = "a_b1 + c"
  -- The whole identifier, from a cursor in its middle.
  assert_eq! \-> word_at source 2 \-> Some (.to_string "a_b1")
  -- And the lexer agrees that is one token. A panic is intended: a probe whose
  -- own fixture does not lex has nothing to assert, and failing loudly there is
  -- the point.
  #[redox::allow(unwrap)]
  toks = .expect "the probe should lex" (redox_lexer::lex source)
  first = &toks[0]
  assert_eq! \-> first.span \-> (0, 4) \-> "`a_b1` should be one Ident token"
  -- The operator is not part of either.
  assert_eq! \-> word_at source 5 \-> None

test "a cursor just past a word still reads it"
  assert_eq! \-> word_at "merge a" 5 \-> Some (.to_string "merge")

test "a number is not an identifier"
  assert_eq! \-> word_at "x = 42" 5 \-> None

test "a path reads its last segment"
  assert_eq! \-> word_at "BTreeSet::union" 12 \-> Some (.to_string "union")
