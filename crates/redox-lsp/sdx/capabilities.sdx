import crate::capabilities::token_types::token_types
import lsp_types::{FoldingRangeProviderCapability, HoverProviderCapability, OneOf, SemanticTokensFullOptions, SemanticTokensLegend, SemanticTokensOptions, SemanticTokensServerCapabilities, ServerCapabilities, TextDocumentSyncCapability, TextDocumentSyncKind, WorkDoneProgressOptions}

-- | The legend the server's token indices refer into.
export(crate) module token_types

-- | What this server tells the editor it can do.
-- |
-- | # Only what is implemented
-- |
-- | Plan 40's criterion 1, and it is a real rule rather than tidiness: an editor
-- | told a capability exists **stops looking for another source for it**. A
-- | server that advertises completion and returns nothing is worse than one
-- | that advertises none, because the editor's own word-based fallback is
-- | switched off by the advertisement.
-- |
-- | So the list is exactly **seven**, and
-- | `capabilities_are_exactly_the_seven_implemented` in the test suite is the
-- | assertion that it stays that way.
-- |
-- | # The three plan 71 leaf 5 added, and why they are not the ones plan 40 declined
-- |
-- | Plan 40 §6 declined `hover` and `definition` because they *"would need name
-- | resolution"*, and that is true of the capabilities a Rust programmer
-- | expects: the **type** of the expression under the cursor, and the
-- | definition of a name wherever it lives.
-- |
-- | These three are a different question each, and each is answerable by a
-- | **span lookup over an AST that already carries spans** — which is leaf 5's
-- | own criterion for choosing them:
-- |
-- | | Capability | The question it answers | What it never does |
-- | |---|---|---|
-- | | `hover` | which declaration am I inside, and what is its first line | consult a type |
-- | | `definition` | where does **this file** declare this name | follow an import, or walk a scope tree |
-- | | `foldingRange` | where are the indented blocks | re-implement the off-side rule |
-- |
-- | Doc 02 §12.4's refusal of a type checker is untouched and rustc remains the
-- | sole authority on types — `redox check` is where a reader gets one, and it
-- | reports rustc's own answer against the `.sdx`.
-- |
-- | # Full-document sync
-- |
-- | Plan 40 decision 5. The parser is fast enough that incremental sync is a
-- | complication without a measurement — and row 44's benchmarks are where that
-- | stops being an assertion. Full sync also means the document store holds
-- | exactly what the editor holds, so a diagnostic's span is an offset into the
-- | text the user can see.
export capabilities : ServerCapabilities
capabilities =
  -- **The record-update form**, where the Rust wrote
  -- `..ServerCapabilities::default()`. Doc 18 §6 lowers a lowercase head to a
  -- mut-bind plus assignments, because Rust's own `X { f: v, ..base }` needs
  -- the type's path and the source gives only the value's name. The emitted
  -- Rust therefore contains no `..`.
  base = ServerCapabilities::default ()
  base { text_document_sync = Some (TextDocumentSyncCapability::Kind TextDocumentSyncKind::FULL), document_symbol_provider = Some (OneOf::Left true), document_formatting_provider = Some (OneOf::Left true), hover_provider = Some (HoverProviderCapability::Simple true), definition_provider = Some (OneOf::Left true), folding_range_provider = Some (FoldingRangeProviderCapability::Simple true), semantic_tokens_provider = Some (SemanticTokensServerCapabilities::SemanticTokensOptions (SemanticTokensOptions { work_done_progress_options = WorkDoneProgressOptions::default (), legend = SemanticTokensLegend { token_types = token_types (), token_modifiers = Vec::new () }, range = None, full = Some (SemanticTokensFullOptions::Bool true) })) }
