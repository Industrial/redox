-- | A unary prefix operator.
export data UnaryOp
  -- | `-x`
  = Neg
  -- | `!x`
  | Not
  -- | `&x`
  | Ref
  -- | `&mut x`
  | RefMut
  -- | `*x`
  | Deref
  deriving (Debug, Clone, Copy, PartialEq, Eq)

instance UnaryOp
  export rust_text : self -> &'static str
  rust_text self = case self of
    Neg -> "-"
    Not -> "!"
    Ref -> "&"
    RefMut -> "&mut "
    Deref -> "*"
