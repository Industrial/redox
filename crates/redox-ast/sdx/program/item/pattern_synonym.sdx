import crate::{Ident, Pattern}
import redox_lexer::{Span, Trivia}

-- | `pattern Origin = Point { x = 0, y = 0 }` — a **pattern synonym**, plan 87.
-- |
-- | ```text
-- | pattern Origin = Point { x = 0, y = 0 }
-- | pattern Both a b = (Some a, Some b)
-- |
-- | describe Origin = "the origin"       -- the nullary form, substituted
-- | case pair of
-- |   Both l r -> l + r                  -- the parameterised form
-- | ```
-- |
-- | Rust has **no pattern abstraction at all**. A pattern cannot be named,
-- | reused or parameterised, and `macro_rules!` does not reach the ergonomics
-- | — which is why the RFC has stood unaccepted for years. This is the largest
-- | piece of expressiveness in milestone 11 that costs no type knowledge
-- | whatsoever.
-- |
-- | # Why it is admissible
-- |
-- | The lowering is **textual substitution at emit time**: `Origin` at a use
-- | site becomes `Point { x: 0, y: 0 }` in the generated Rust, and rustc then
-- | performs every check it would have performed on the written-out form —
-- | exhaustiveness, field names, types, binding modes. Doc 03 §2's corollary is
-- | not weakened in either direction: Redox checks nothing new, and rustc loses
-- | nothing.
-- |
-- | # Binders come from the use site, so hygiene does not arise
-- |
-- | [`params`](Self::params) are **formal parameters**, not names the synonym
-- | introduces. `Both l r` substitutes `l` and `r` positionally, so every
-- | binder at a use site is written at that use site and doc 02 §6.3's
-- | `__rdx_` reservation is not needed here.
-- |
-- | That is what distinguishes this from `docs/DECLINED.md`'s refusal of
-- | `RecordWildCards`, which is declined because it *"introduces names absent
-- | from the source"*. A synonym introduces none.
-- |
-- | A body naming a lowercase identifier that is **not** one of its parameters
-- | would introduce one, and the parser refuses it.
export data PatternSynonym = PatternSynonym {
  -- | The synonym's own name. Upper case, because a use site has to read as a
  -- | constructor — `pattern_app` keeps a bare upper-case name as a path and a
  -- | lower-case one is a binder, which is the same convention doc 18 §5.3 uses
  -- | for a type variable and plan 68 for a constructor pattern.
  export name : Ident,
  -- | The formal parameters, in order. Empty for the nullary form.
  export params : Vec<Ident>,
  -- | The pattern the name stands for.
  export body : Pattern,
  export span : Span,
  export leading : Vec<Trivia>,
}
  deriving (Debug, Clone, PartialEq, Eq)
