import crate::Ident
import crate::program::item::fixity::Fixity
import redox_lexer::{Span, Trivia}

-- | `infixl 6 <+> = Set::union` — a spelling and a fixity for a function that
-- | already exists. Plan 90.
-- |
-- | ```text
-- | infixl 6 <+> = Set::union
-- | infixr 1 <$> = and_then
-- |
-- | combined = a <+> b          -- Set::union(a, b)
-- | ```
-- |
-- | # It is an alias, not a definition
-- |
-- | Haskell lets `(<+>)` *be* the function's name. That does not work here, and
-- | the reason is Rust's identifier grammar: no Rust function can be named
-- | `<+>`, so the emitter would have to invent one — which fabricates API
-- | surface, the objection doc 03 §8.7 raises against default arguments and the
-- | reason they stay declined.
-- |
-- | So the declaration **names a function that already exists**, and emits no
-- | item at all. `a <+> b` emits `Set::union(a, b)`, nothing is renamed, and
-- | go-to-definition on the operator has somewhere real to go.
-- |
-- | # The decline this overturns, and why its reason was wrong
-- |
-- | `docs/DECLINED.md` refused this construct under doc 03 §14.4: *"Rust has no
-- | mechanism for it, so there is no lowering target."* The first clause is
-- | true and the second does not follow — the surface already carries six
-- | operators with no Rust counterpart (`|>`, `>>>`, `<<<`, `$`, `??`, `is`),
-- | and every one lowers to an ordinary expression form. A user-declared `<+>`
-- | lowering to a call has exactly the target `a |> f` has.
-- |
-- | Plan 90 §1.1 makes the correction in full. It is the third time
-- | `docs/DECLINED.md` has had a *reason* replaced rather than a verdict
-- | reversed on new evidence.
export data OperatorDecl = OperatorDecl {
  -- | The operator's spelling, one of `ASSIGNABLE_OPERATORS` — `<+>`.
  export spelling : Ident,
  -- | How it groups.
  export fixity : Fixity,
  -- | The declared precedence, 0–9 on Haskell's scale.
  -- |
  -- | Kept as written rather than as the internal binding power, because this
  -- | is what `redox fmt` has to print back. `Fixity::powers` is where the two
  -- | are related, and its doc comment carries the interleave table.
  export precedence : u8,
  -- | The function the operator stands for, verbatim from the source.
  -- |
  -- | A path, pasted into the generated Rust as the callee. Verbatim for doc 03
  -- | §14.1's standing reason — a path the author wrote is already Rust, so
  -- | re-spelling it from a tree could only lose something — and plan 84's
  -- | `given` field is the same decision one construct over.
  export target : String,
  export span : Span,
  export leading : Vec<Trivia>,
}
  deriving (Debug, Clone, PartialEq, Eq)
