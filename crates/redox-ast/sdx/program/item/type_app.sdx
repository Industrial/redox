import crate::Ident
import crate::program::item::primitive_type::primitive_type
import redox_lexer::Span

-- | A type written by **juxtaposition**: `Wrapper t`, `Pair k v`, `Counter`.
-- |
-- | Doc 18 §2.1 reads application the same way everywhere, types included, so
-- | an `instance` target needs no notation of its own. The lowering adds the
-- | angle brackets Rust wants and nothing else:
-- |
-- | ```text
-- | Counter        Counter
-- | Wrapper t   →  Wrapper<T>
-- | Pair k v       Pair<K, V>
-- | ```
-- |
-- | Structured rather than captured verbatim, unlike every other type in Redox
-- | (doc 03 §14.1). The reason is that the *generic list* has to be
-- | synthesised from it — doc 18 §5.3's "the generic list is synthesised from
-- | first appearance" — and a string cannot say which of its words were type
-- | variables.
export data TypeApp = TypeApp {
  export head : Ident,
  -- | The arguments, in source order. A lowercase argument is a type
  -- | *variable* (doc 18 §5.3) and is emitted uppercase.
  export args : Vec<Ident>,
  export span : Span,
}
  deriving (Debug, Clone, PartialEq, Eq)
instance TypeApp
  -- | The Rust spelling: `Wrapper<T>`, or just `Counter` with no arguments.
  export rust_text : &self -> String
  rust_text self =
    if .is_empty self.args
      return .clone self.head.text
    args : Vec<String> = self.args
      |> .iter
      |> .map (\a -> TypeApp::rust_name (&a.text))
      |> .collect
    format! \-> "#{self.head.text}<#{(.join ", " args)}>"

  -- | The type variables, in order of first appearance.
  -- |
  -- | Doc 18 §5.3: "type variables need no declaration … the generic list is
  -- | synthesised from first appearance". Order matters and duplicates do not,
  -- | so this is a vector filtered against itself rather than a set — a set
  -- | would make the output depend on iteration order, which the emitter's
  -- | byte-stability forbids.
  export vars : &self -> Vec<&str>
  vars self =
    mut seen : Vec<&str> = Vec::new ()
    for a in &self.args
      if TypeApp::is_var (&a.text) && !.contains (&.as_str a.text) seen
        .push (&a.text) seen
    seen

  -- | Whether a name is a **lifetime**: it opens with `'`.
  -- |
  -- | `'static` and `'_` are not, for the reasons `type_vars` records about
  -- | the same two names: one needs no declaration, and the other must not
  -- | have one — `fn f<'_>(…)` is `E0637: '_ cannot be used here`.
  export is_lifetime : &str -> bool
  is_lifetime text = .starts_with '\'' text && text != "'static" && text != "'_"

  -- | Whether a name is a type variable, which doc 18 §5.3 makes the case of
  -- | its first letter — with [`primitive_type`]'s correction, because `f64`
  -- | is lowercase and concrete.
  -- |
  -- | The correction arrived with plan 67: `instance Convert f64 Meters` is
  -- | `impl Convert<f64> for Meters`, and the case of the first letter alone
  -- | made it `Convert<F64>`.
  -- |
  -- | **A lifetime counts**, which plan 74 added. Doc 18 §5.3 says the
  -- | synthesised list includes lifetimes and this predicate asked only about
  -- | the first letter's case, so `'a` was not a variable: `rust_text`
  -- | printed `Cursor<'a>` and `generics` declared nothing, giving
  -- | `impl Cursor<'a>` with an undeclared lifetime. The target and the list
  -- | that must declare its arguments disagreed.
  export is_var : &str -> bool
  is_var text =
    if TypeApp::is_lifetime text
      return true
    .is_some_and char::is_lowercase (.next (.chars text)) && !primitive_type text

  -- | A type argument's Rust spelling: a variable uppercased, a concrete type
  -- | left alone.
  export rust_name : &str -> String
  rust_name text =
    -- A lifetime is already its own Rust spelling, and `is_var` now says yes
    -- to one — so without this it would come out `'A`.
    if .starts_with '\'' text
      return .to_string text
    if TypeApp::is_var text
      return .to_uppercase text
    .to_string text
