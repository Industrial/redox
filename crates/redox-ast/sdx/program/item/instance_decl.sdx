import crate::program::item::class_member::ClassMember
import crate::program::item::constraint::Constraint
import crate::program::item::type_app::TypeApp
import redox_lexer::{Span, Trivia}

-- | An `instance` declaration — doc 18 §2.5's `impl`.
-- |
-- | ```text
-- | instance Display t => Describe (Wrapper t)   impl<T: Display> Describe for Wrapper<T> {
-- |   describe self = "…"                    →       fn describe(&self) -> String { "…" }
-- |                                              }
-- |
-- | instance Counter                             impl Counter {
-- |   increment : &mut self -> ()           →       fn increment(&mut self) {
-- |   increment self = self.value += 1                   self.value += 1;
-- |                                                  }
-- |                                              }
-- | ```
-- |
-- | `instance` means `impl`, **with or without a class name**, which is what
-- | lets one keyword cover both of Rust's forms. Which one is written is
-- | decided by how many names precede the target: `instance Counter` is
-- | inherent, `instance Describe (Wrapper t)` is a trait impl.
export data InstanceDecl = InstanceDecl {
  -- | The class being implemented, with its own arguments, or `None` for an
  -- | inherent `impl`.
  -- |
  -- | A [`TypeApp`] rather than a bare name since plan 67:
  -- | `instance Convert f64 Meters` is `impl Convert<f64> for Meters`, so the
  -- | class carries arguments of its own and the **last** name in the head is
  -- | the implementing type.
  export r#class : Option<TypeApp>,
  export target : TypeApp,
  -- | `Display t =>` — bounds on the generic parameters.
  export constraints : Vec<Constraint>,
  -- | `instance given <T: Display> Describe T` — the **verbatim** impl generic
  -- | list, plan 84 leaf 4.
  -- |
  -- | `Some` turns the synthesised list off for this head, so
  -- | [`constraints`](Self::constraints) is then empty: plan 84 §1.6's
  -- | all-or-nothing rule, the same one a signature's own binder follows.
  -- |
  -- | This is what closes **`blanket_impl`**, which `docs/STATUS.md` carried as
  -- | a gap. `instance Display t => Describe t` emitted `impl Describe for t`
  -- | with a lowercase target rustc rejects, because `TypeApp::vars` reads the
  -- | *arguments* and a bare variable is the head — a synthesis failure rather
  -- | than a type one. Written verbatim the question does not arise.
  export r#given : Option<String>,
  export members : Vec<ClassMember>,
  export span : Span,
  export leading : Vec<Trivia>,
}
  deriving (Debug, Clone, PartialEq, Eq)
