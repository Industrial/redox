import crate::Ident
import crate::program::item::constructor::Constructor
import crate::program::item::visibility::Visibility
import redox_lexer::{Span, Trivia}

-- | A `data` or `newtype` declaration — doc 18 §2.4.
-- |
-- | ```text
-- | data Point = Point { x : f64, y : f64 }     #[derive(Debug, Clone)]
-- |   deriving (Debug, Clone)                     struct Point { x: f64, y: f64 }
-- |
-- | data Event                                    enum Event {
-- |   = Click { x : i32, y : i32 }                  Click { x: i32, y: i32 },
-- |   | Key char                              →       Key(char),
-- |   | Close                                         Close,
-- |                                               }
-- | newtype Meters = Meters f64                   struct Meters(f64);
-- | data Marker = Marker                          struct Marker;
-- | ```
-- |
-- | **One constructor whose name matches the type is a `struct`; anything else
-- | is an `enum`.** The rule is syntactic, which doc 18 §2.4 says is the whole
-- | requirement — it is decidable from the source text alone, doc 03 §2's
-- | admission test 1, and needs no name resolution.
-- |
-- | Four Redox keywords collapse into two here: `struct`, `enum` and the
-- | `union` and tuple-struct spellings are all `data`, and `derive` as a
-- | standalone keyword becomes `deriving` as a clause of the declaration.
export data DataDecl = DataDecl {
  export name : Ident,
  -- | The generic list, **synthesised** from the constructors' field types —
  -- | doc 18 §5.3's "type variables need no declaration … the generic list is
  -- | the order of their first appearance, lifetimes included".
  -- |
  -- | Plan 74 added it, and the gap it closed is worth stating: that rule was
  -- | already applied to a *signature*, by `generalise`, and to an `instance`
  -- | *target*, by `TypeApp::vars` — and nowhere to a declaration. So
  -- | `data Cursor = Cursor { src : &'a str }` emitted
  -- | `struct Cursor { src: &'a str }`, which rustc rejects for an undeclared
  -- | lifetime. Nothing new is written in the source; the third of three
  -- | places the same rule belongs simply had it missing.
  export generics : Vec<String>,
  -- | One or more, in source order.
  export constructors : Vec<Constructor>,
  -- | The `deriving (…)` list, which becomes `#[derive(…)]`.
  export derives : Vec<Ident>,
  -- | Whether the author wrote `newtype`.
  -- |
  -- | **It changes the output.** `newtype Meters = Meters f64` emits
  -- | `#[repr(transparent)] struct Meters(f64);` and
  -- | `data Meters = Meters f64` emits the struct alone — plan 53 leaf 3.
  -- | Rust has one single-field tuple struct and not two, which is why this
  -- | used to be a flag that changed nothing; what it does have is a layout
  -- | guarantee worth asking for by name, and `newtype` is the keyword that
  -- | asks. The flag is also what lets the
  -- | formatter re-spell the declaration the way it was written, and what
  -- | `newtype_shape` reads to reject a `newtype` that is not **one
  -- | constructor over one field** — a check Haskell makes and Rust has no
  -- | equivalent of, now `RDX0111`.
  -- |
  -- | Both halves of that rule, not just the field count this comment used to
  -- | name: `newtype Shade = Light | Dark` emitted a perfectly good `enum`
  -- | before plan 53 leaf 2, which is as wrong as a two-field tuple and was
  -- | the half nobody had written down.
  -- |
  -- | rustc backstops exactly one of the four refused shapes, and only since
  -- | leaf 3: `#[repr(transparent)]` over two fields is `E0690`. A unit struct
  -- | with it compiles clean, so zero fields, zero constructors and a bare
  -- | `newtype Lone` with no `=` row at all are caught here or not at all.
  export is_newtype : bool,
  -- | `union Reg = Reg { a : u32, b : f32 }` — plan 45 leaf 4.
  -- |
  -- | Doc 18 §2.4's rule reads a shape off the constructors, and a union is
  -- | not a shape — it is a struct's shape with overlapping storage, which no
  -- | arrangement of constructors could select. So it takes a keyword, as
  -- | `newtype` does for the same kind of reason.
  -- |
  -- | Rust requires named fields in a union and permits exactly one "variant";
  -- | neither is checked here. A `union` with two constructors emits two
  -- | variants and rustc rejects it, which is the every-check-rustc-makes
  -- | corollary rather than an omission.
  export is_union : bool,
  -- | Doc 03 §9.6's visibility. Private when the author wrote no marker,
  -- | which is Rust's default and has no spelling.
  export visibility : Visibility,
  export span : Span,
  export leading : Vec<Trivia>,
}
  deriving (Debug, Clone, PartialEq, Eq)
