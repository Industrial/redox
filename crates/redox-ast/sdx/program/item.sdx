-- | A `class` declaration — Rust's `trait`.
export(crate) module class_decl
-- | One member of a `class` or `instance` body.
export(crate) module class_member
-- | One equation of a function.
export(crate) module clause
-- | A clause's right-hand side.
export(crate) module clause_body
-- | A module-scope `const` or `static`.
export(crate) module const_decl
-- | One `Trait t` constraint, from a `=>` clause.
export(crate) module constraint
-- | One constructor of a `data` declaration.
export(crate) module constructor
-- | What a constructor carries.
export(crate) module constructor_fields
-- | A `data` or `newtype` declaration.
export(crate) module data_decl
-- | A `deriving` template, instantiated against a declaration.
-- | Whether a declared operator groups left, right, or not at all.
export module fixity
export(crate) module derive_template
-- | `infixl 6 <+> = Set::union` — a spelling and a fixity for an existing function.
export(crate) module operator_decl
-- | One row of an `errors` declaration.
export(crate) module error_variant
-- | An `errors` declaration.
export(crate) module errors_decl
-- | An `extern` block.
export(crate) module extern_block
-- | One `name : Type` field of a record constructor.
export(crate) module field_decl
-- | A signature line and the equations that define it.
export(crate) module fn_decl
-- | One declaration inside an `extern` block.
export(crate) module foreign_fn
-- | One `| cond = body` row of a guard ladder.
export(crate) module r#guard
-- | An `import` declaration.
export(crate) module import_decl
-- | The inline Rust escape hatch.
export(crate) module inline_rust
-- | An `instance` declaration — Rust's `impl`.
export(crate) module instance_decl
-- | An item's leading trivia — its comments and attributes.
export(crate) module leading
-- | A `module` declaration.
export(crate) module module_decl
-- | One parameter in a signature.
export(crate) module param
-- | A pattern in an equation's binder position.
export(crate) module pattern
-- | A pattern given a name and reused.
export(crate) module pattern_synonym
-- | Whether a lowercase name is one of Rust's primitive type names.
export(crate) module primitive_type
-- | One field of a record pattern — `x` or `x = 0`.
export(crate) module record_pattern_field
-- | A function's parameters and return type.
export(crate) module signature
-- | A `test` block.
export(crate) module test_decl
-- | A `type` alias.
export(crate) module type_alias
-- | A type written by juxtaposition: `Wrapper t`, `Pair k v`.
export(crate) module type_app
-- | An item's or field's visibility.
export(crate) module visibility

import crate::FnDecl
import crate::program::item::class_decl::ClassDecl
import crate::program::item::const_decl::ConstDecl
import crate::program::item::data_decl::DataDecl
import crate::program::item::derive_template::DeriveTemplate
import crate::program::item::operator_decl::OperatorDecl
import crate::program::item::errors_decl::ErrorsDecl
import crate::program::item::extern_block::ExternBlock
import crate::program::item::import_decl::ImportDecl
import crate::program::item::inline_rust::InlineRust
import crate::program::item::instance_decl::InstanceDecl
import crate::program::item::module_decl::ModuleDecl
import crate::program::item::pattern_synonym::PatternSynonym
import crate::program::item::test_decl::TestDecl
import crate::program::item::type_alias::TypeAlias
import redox_lexer::Span

-- | A top-level declaration.
-- |
-- | Doc 18 §§2.4–2.5 collapsed six of doc 03's declaration keywords into four.
-- | `struct`, `enum`, `union` and the tuple-struct spelling are all `data`;
-- | `class` means `trait` rather than doc 01 §17.7's "struct plus impl"; and
-- | `instance` means `impl`, trait or inherent.
export data Item
  = Fn FnDecl
  | Data DataDecl
  | Type TypeAlias
  | Class ClassDecl
  | Instance InstanceDecl
  -- | Doc 03 §12.5's `errors`, kept by doc 18 §8 — the one declaration that
  -- | generates more than one Rust item.
  | Errors ErrorsDecl
  -- | Doc 03 §15's `test`, kept by doc 18 §8. The only item that is **not**
  -- | emitted where it appears: §15 asks for one module per file, so the
  -- | tests are gathered and written together.
  | Test TestDecl
  -- | Doc 03 §13.1's `import` — plan 14.
  | Import ImportDecl
  -- | Doc 18 §7's `module`, which is Rust's `mod` — plan 14. The only item
  -- | that **contains** items, and so the only one the emitter recurses on.
  | Module ModuleDecl
  -- | Doc 03 §13.4's module-scope `const` or `static` — plan 16.
  | Const ConstDecl
  -- | Doc 01 §23.1's inline Rust — plan 45. The only item whose contents are
  -- | never parsed.
  | InlineRust InlineRust
  -- | An `extern` block — plan 45 leaf 3, and doc 01 §26's FFI requirement.
  | Extern ExternBlock
  -- | `pattern Origin = Point { x = 0, y = 0 }` — a pattern synonym, plan 87.
  -- |
  -- | **Emits nothing.** It is a compile-time construct: the emitter expands
  -- | every use site and the declaration itself produces no Rust, which is what
  -- | leaves rustc checking the written-out form and nothing else.
  | PatternSynonym PatternSynonym
  -- | `deriving template Forward` — plan 89.
  -- |
  -- | **Emits nothing where it stands.** The declaration is a store: a
  -- | `deriving` list naming it emits the stored `instance` beside *that*
  -- | declaration, with `Target` and `Field0`… substituted. Like
  -- | [`PatternSynonym`](Self::PatternSynonym), a compile-time construct whose
  -- | own position produces no Rust.
  | DeriveTemplate DeriveTemplate
  | OperatorDecl OperatorDecl
  deriving (Debug, Clone, PartialEq, Eq)
instance Item
  export span : &self -> Span
  span self = case self of
    Item::Fn f -> f.span
    Item::Data d -> d.span
    Item::Type a -> a.span
    Item::Class c -> c.span
    Item::Instance i -> i.span
    Item::Errors e -> e.span
    Item::Test t -> t.span
    Item::Import i -> i.span
    Item::Module m -> m.span
    Item::Const c -> c.span
    Item::InlineRust r -> r.span
    Item::Extern e -> e.span
    Item::PatternSynonym p -> p.span
    Item::DeriveTemplate t -> t.span
    Item::OperatorDecl o -> o.span
