import crate::Item
-- | `name = value`, and its `mut`, annotated and destructuring forms.
export(crate) module binding

import crate::Expr
import redox_lexer::{Span, Trivia}

-- | One element of a [`Block`](crate::Block): an expression, and the trivia
-- | that surrounds it.
-- |
-- | # Why this survives plan 55 leaf 1, when `StmtKind` did not
-- |
-- | Leaf 1 collapsed the statement/expression fork: there is one node kind,
-- | and every body position holds an [`Expr`]. That could have made a block a
-- | bare `Vec<Expr>` — and it does not, because **`Expr` carries no trivia**.
-- |
-- | A comment attaches to a *line*, not to a subexpression. AGENTS.md makes
-- | comment preservation load-bearing (doc 02 §10.1 corrects doc 01 §4.1), so
-- | the trivia has to live somewhere, and the two candidates are this wrapper
-- | or two more fields on every one of `Expr`'s forty-six forms. So `Stmt`
-- | stays as the trivia carrier and keeps its name: it is still a block
-- | element, and the thing that changed is that its payload is no longer a
-- | kind of its own.
export data Stmt = Stmt {
  export expr : Expr,
  export span : Span,
  export leading : Vec<Trivia>,
  export trailing : Option<Trivia>,
}
  deriving (Debug, Clone, PartialEq, Eq)
instance Stmt
  -- | The single name a `where` entry defines, when it defines exactly one —
  -- | plan 61 leaf 1.
  -- |
  -- | ```text
  -- | scaled = base * 2      Some("scaled")
  -- | go : u64 -> u64        Some("go")       — a function entry
  -- | (a, b) = p             None             — two names, no single vertex
  -- | print x                None             — defines nothing
  -- | ```
  -- |
  -- | A binding may define **several** names — `(a, b) = p` is one statement
  -- | binding two, which plan 61 §11.2 measured — and a multi-name binding is
  -- | not a vertex the graph can represent, so it is neither a source nor a
  -- | target of an edge. The sort then leaves it where it was written, which is
  -- | the conservative answer and where it already worked.
  -- |
  -- | A **function** entry has a name and deliberately returns it: the cycle
  -- | search needs it to *report* a cycle, and [`crate::where_edges`] excludes
  -- | functions by asking what kind of entry each is rather than by having no
  -- | name for them. A mutually recursive pair of nested `fn`s is
  -- | order-independent in Rust and must not be reported.
  export where_entry_name : &self -> Option<String>
  where_entry_name self = case &self.expr of
    Expr::Binding b -> case (.as_slice (.binders b.pattern)) of
      [one] -> Some (.clone one)
      _ -> None
    Expr::Item { item, .. } -> case (.as_ref item) of
      Item::Fn decl -> Some (.clone decl.name.text)
      _ -> None
    _ -> None
