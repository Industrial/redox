import crate::Pattern
import crate::section::Qualifier
import crate::section::Section
import redox_lexer::Span

export data Expr
  = Call {
    callee : Box<Expr>,
    args : Vec<Expr>,
    is_dollar : bool,
    span : Span,
  }
  | Field { recv : Box<Expr>, name : Ident, span : Span }
  | Index { recv : Box<Expr>, index : Box<Expr>, span : Span }
  | Binary { op : BinaryOp, lhs : Box<Expr>, rhs : Box<Expr>, span : Span }
  | UserBinary { spelling : Ident, fixity : crate::Fixity, precedence : u8, target : String, lhs : Box<Expr>, rhs : Box<Expr>, span : Span }
  | Over { selector : Vec<Ident>, function : Box<Expr>, place : Box<Expr>, span : Span }
  | Unary { op : UnaryOp, operand : Box<Expr>, span : Span }
  | Paren { inner : Box<Expr>, span : Span }
  | Path { text : String, span : Span }
  | Lambda { params : Vec<crate::Param>, body : Box<Expr>, is_move : bool, span : Span }
  | MethodRef { name : Ident, span : Span }
  | AsyncBlock { body : crate::Block, span : Span }
  | UnsafeBlock { body : crate::Block, span : Span }
  | TryBlock { body : crate::Block, span : Span }
  | BindBlock { method : crate::Ident, body : crate::Block, span : Span }
  | Ascribe { inner : Box<Expr>, ty : TypeExpr, span : Span }
  | StrLit { value : String, span : Span }
  | StrInterp { parts : Vec<crate::StrInterpPart>, span : Span }
  | Tuple { items : Vec<Expr>, span : Span }
  | ArrayRepeat { value : Box<Expr>, count : Box<Expr>, span : Span }
  | RawLit { text : String, span : Span }
  | Record { head : Box<Expr>, fields : Vec<FieldInit>, span : Span }
  | List { items : Vec<Expr>, span : Span }
  | Comprehension { element : Box<Expr>, qualifiers : Vec<Qualifier>, span : Span }
  | If { condition : crate::Condition, then_block : crate::Block, r#otherwise : Option<crate::Block>, span : Span }
  | Block { label : Option<String>, body : crate::Block, span : Span }
  | Try { inner : Box<Expr>, span : Span }
  | Unit { span : Span }
  | Section { section : Section, span : Span }
  | Case { scrutinee : Box<Expr>, arms : Vec<CaseArm>, span : Span }
  | Num { text : String, span : Span }
  | Bool { value : bool, span : Span }
  | Char { value : char, span : Span }
  | SelfField { name : Ident, span : Span }
  | SelfType { name : Ident, span : Span }
  | Ident Ident

  | Binding Box<crate::Binding>
  | Item { item : Box<crate::Item>, span : Span }
  | Return { value : Option<Box<Expr>>, span : Span }
  | Draw {
    name : Ident,
    value : Box<Expr>,
    span : Span,
  }
  | Await { pattern : Option<crate::Pattern>, value : Box<Expr>, span : Span }
  | Assign {
    target : Box<Expr>,
    op : Option<BinaryOp>,
    value : Box<Expr>,
    span : Span,
  }
  | Guard { pattern : crate::Pattern, source : Box<Expr>, r#otherwise : crate::Block, span : Span }
  | While {
    condition : crate::Condition,
    negated : bool,
    body : crate::Block,
    label : Option<String>,
    span : Span,
  }
  | For { binder : Ident, source : Box<Expr>, body : crate::Block, label : Option<String>, span : Span }
  | Loop { body : crate::Block, label : Option<String>, span : Span }
  | Break { label : Option<String>, value : Option<Box<Expr>>, span : Span }
  | Continue { label : Option<String>, span : Span }
  | RustHatch { code : String, span : Span }
  | MacroCall { name : String, args : Vec<Expr>, span : Span }
  deriving (Debug, Clone, PartialEq, Eq)
instance Expr
  export span : &self -> Span
  span self = case self of
    Call { span, .. } or Field { span, .. } or Index { span, .. } or Binary { span, .. } or Unary { span, .. } or Paren { span, .. } or Path { span, .. } or Lambda { span, .. } or MethodRef { span, .. } or AsyncBlock { span, .. } or UnsafeBlock { span, .. } or TryBlock { span, .. } or BindBlock { span, .. } or Ascribe { span, .. } or StrLit { span, .. } or StrInterp { span, .. } or Tuple { span, .. } or ArrayRepeat { span, .. } or RawLit { span, .. } or Case { span, .. } or Record { span, .. } or Expr::Section { span, .. } or Try { span, .. } or Item { span, .. } or If { span, .. } or Block { span, .. } or List { span, .. } or Comprehension { span, .. } or Num { span, .. } or Bool { span, .. } or Char { span, .. } or SelfField { span, .. } or SelfType { span, .. } or Return { span, .. } or Draw { span, .. } or Await { span, .. } or Assign { span, .. } or Guard { span, .. } or While { span, .. } or For { span, .. } or Loop { span, .. } or Break { span, .. } or Continue { span, .. } or MacroCall { span, .. } or RustHatch { span, .. } or UserBinary { span, .. } or Over { span, .. } or Unit { span } -> *span
    Ident i -> i.span
    Binding b -> b.span

  export is_statement_form : &self -> bool
  is_statement_form self =
    own = case self of
      Binding _ or Item { .. } or Return { .. } or Draw { .. } or Await { .. } or Assign { .. } -> true
      _ -> false
    own || .is_control_flow self

  export is_control_flow : &self -> bool
  is_control_flow self = case self of
    If { .. } or While { .. } or For { .. } or Loop { .. } or Break { .. } or Continue { .. } or Guard { .. } -> true
    _ -> false

  export statement_blocks : &self -> Vec<&crate::Block>
  statement_blocks self = case self of
    If { then_block, r#otherwise, .. } -> case r#otherwise of
      Some other -> [then_block, other] : Vec<&crate::Block>
      None -> [then_block] : Vec<&crate::Block>
    While { body, .. } or For { body, .. } or Loop { body, .. } -> [body] : Vec<&crate::Block>
    Guard { r#otherwise, .. } -> [r#otherwise] : Vec<&crate::Block>
    Item { .. } or Call { .. } or Field { .. } or Index { .. } or Binary { .. } or Unary { .. } or Paren { .. } or Path { .. } or Lambda { .. } or MethodRef { .. } or AsyncBlock { .. } or UnsafeBlock { .. } or TryBlock { .. } or BindBlock { .. } or Ascribe { .. } or StrLit { .. } or StrInterp { .. } or Tuple { .. } or ArrayRepeat { .. } or RawLit { .. } or Record { .. } or List { .. } or Comprehension { .. } or Block { .. } or Try { .. } or Unit { .. } or Expr::Section { .. } or Case { .. } or Num { .. } or Bool { .. } or Char { .. } or SelfField { .. } or SelfType { .. } or Return { .. } or Draw { .. } or Await { .. } or Assign { .. } or Break { .. } or Continue { .. } or MacroCall { .. } or RustHatch { .. } or UserBinary { .. } or Over { .. } or Ident _ or Binding _ -> Vec::new ()

export data BinaryOp
  = Add
  | Sub
  | Mul
  | Div
  | Rem
  | Eq
  | Ne
  | Lt
  | Gt
  | Le
  | Ge
  | And
  | Or
  | BitAnd
  | BitOr
  | BitXor
  | Shl
  | Shr
  | Range
  | RangeInclusive
  | Coalesce
  | Catch
  | Pipeline
  | Compose
  | ComposeBack
  deriving (Debug, Clone, Copy, PartialEq, Eq)
instance BinaryOp
  export rust_text : self -> Option<&'static str>
  rust_text self = case self of
    Coalesce or Catch or Pipeline or Compose or ComposeBack -> None
    Add -> Some "+"
    Sub -> Some "-"
    Mul -> Some "*"
    Div -> Some "/"
    Rem -> Some "%"
    Eq -> Some "=="
    Ne -> Some "!="
    Lt -> Some "<"
    Gt -> Some ">"
    Le -> Some "<="
    Ge -> Some ">="
    And -> Some "&&"
    Or -> Some "||"
    BitAnd -> Some "&"
    BitOr -> Some "|"
    BitXor -> Some "^"
    Shl -> Some "<<"
    Shr -> Some ">>"
    Range -> Some ".."
    RangeInclusive -> Some "..="

  export redox_text : self -> &'static str
  redox_text self = case self of
    Coalesce -> "??"
    Catch -> "catch"
    Pipeline -> "|>"
    Compose -> ">>>"
    ComposeBack -> "<<<"
    other -> case .rust_text other of
      Some text -> text
      None -> unreachable!

  export power : self -> u8
  power self = case self of
    Pipeline -> 1
    Coalesce or Catch -> 3
    Range or RangeInclusive -> 5
    Or -> 7
    And -> 9
    Eq or Ne or Lt or Gt or Le or Ge -> 11
    BitOr -> 13
    BitXor -> 15
    BitAnd -> 17
    Shl or Shr -> 19
    Add or Sub -> 21
    Mul or Div or Rem -> 23
    Compose or ComposeBack -> 25

  export is_range : self -> bool
  is_range self = case self of
    Range or RangeInclusive -> true
    _ -> false

  export compare_method : self -> Option<&'static str>
  compare_method self = case self of
    Eq -> Some "eq"
    Ne -> Some "ne"
    Lt -> Some "lt"
    Gt -> Some "gt"
    Le -> Some "le"
    Ge -> Some "ge"
    _ -> None

  export flipped : self -> Option<Self>
  flipped self = case self of
    Eq -> Some Eq
    Ne -> Some Ne
    Lt -> Some Gt
    Gt -> Some Lt
    Le -> Some Ge
    Ge -> Some Le
    _ -> None

export data CaseArm = CaseArm {
  export pattern : Pattern,
  export ty : Option<crate::TypeExpr>,
  export r#guard : Option<crate::Condition>,
  export body : Expr,
  export span : Span,
}
  deriving (Debug, Clone, PartialEq, Eq)

export data FieldInit = FieldInit {
  export name : Ident,
  export value : Option<Expr>,
  export span : Span,
}
  deriving (Debug, Clone, PartialEq, Eq)

export data Ident = Ident { export text : String, export span : Span }
  deriving (Debug, Clone, PartialEq, Eq)

export data StrInterpPart
  = Text String
  | Interp {
    expr : crate::Expr,
    spec : Option<String>,
  }
  deriving (Debug, Clone, PartialEq, Eq)

export data TypeExpr = TypeExpr {
  export text : String,
  export span : Span,
}
  deriving (Debug, Clone, PartialEq, Eq)

export data UnaryOp
  = Neg
  | Not
  | Ref
  | RefMut
  | Deref
  deriving (Debug, Clone, Copy, PartialEq, Eq)

instance UnaryOp
  export rust_text : self -> &'static str
  rust_text self = case self of
    Neg -> "-"
    Not -> "!"
    Ref -> "&"
    RefMut -> "&mut "
    Deref -> "*"
