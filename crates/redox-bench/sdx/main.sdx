-- ! `redox-bench` — regenerates `benchmarks/REPORT.md`.
-- !
-- ! Plan 44 leaf 2 and §1.4: throughput and latency are **reported, not
-- ! asserted**. A timing assertion is the flaky gate §1.2 declines, and a
-- ! threshold would encode this machine's speed into the repository.
-- !
-- ! Criterion 7: the report is regenerable by this command, so a number in it
-- ! can be checked rather than trusted.

import redox_bench::throughput
import std::path::{Path, PathBuf}
import std::time::Duration

-- | How many times each source is transpiled.
-- |
-- | Enough that the mean is stable to the three significant figures the report
-- | prints, and few enough that regenerating it takes seconds. §1.1 measured
-- | that no statistics library is available or pinned, and §6 declines to add
-- | one: a number reported to three figures does not need one.
const RUNS : u32 = 200

-- | The workspace root, from this crate's manifest directory.
root : PathBuf
root = .join "../.." $ Path::new $ env! \-> "CARGO_MANIFEST_DIR"

main : Result<(), String>
main =
  corpus = (sources (&.join "examples" (root ())))?
  mut rows : Vec<(String, usize, Duration)> = Vec::new ()
  mut total_bytes : usize = 0
  mut total_time = Duration::ZERO

  for entry in &corpus
    -- Borrowed: `entry` is a `&(String, String)`, so binding a field by
    -- value is `E0507` — a move out of a shared reference.
    name = &entry.0
    r#text = &entry.1
    measured = throughput r#text RUNS
    mean = measured.1
    total_bytes += .len r#text
    total_time += mean
    rows |> .push (.clone name, .len r#text, mean)

  -- Slowest first: a report sorted by name hides which file costs the most,
  -- and that is the only ordering a reader acts on.
  .sort_by_key (\r -> std::cmp::Reverse r.2) rows

  report = render (&rows) total_bytes total_time (&machine ())
  path = .join "benchmarks/REPORT.md" $ root ()
  (.map_err (\e -> .to_string e) (std::fs::write (&path) report))?
  -- `root()` is the manifest directory joined to `../..`, so the path prints
  -- as `crates/redox-bench/../../benchmarks/REPORT.md` unless it is resolved.
  -- The reader wants the file, not the route taken to it.
  shown = path |> .canonicalize |> .ok |> .unwrap_or (.clone path)
  println! \-> "wrote #{(.display shown)}"
  Ok ()

-- | Every `.sdx` in a directory, with its text.
sources : &Path -> Result<Vec<(String, String)>, String>
sources dir =
  mut found : Vec<(String, String)> = Vec::new ()
  shown = .display dir
  entries = (.map_err (\e -> format! \-> "#{shown}: #{e}") (std::fs::read_dir dir))?
  mut paths : Vec<PathBuf> = entries
    |> .filter_map Result::ok
    |> .map (\entry -> .path entry)
    |> .filter (\path -> .is_some_and (\x -> x == "sdx") (.extension path))
    |> .collect
  .sort paths
  for path in paths
    r#text = (.map_err (\e -> .to_string e) (std::fs::read_to_string (&path)))?
    -- `lexical.sdx` is skipped here, and only here: it does not parse, so
    -- transpiling it measures the error path rather than the compiler. Every
    -- other sweep in the repository includes it deliberately; this is the one
    -- where it would be measuring the wrong thing.
    name = path
      |> .file_name
      |> .unwrap_or_default
      |> .to_string_lossy
      |> .into_owned
    if name == "lexical.sdx"
      continue
    found |> .push (name, r#text)
  Ok found

-- | What this was measured on. A number without a machine is not a
-- | measurement — plan 44 decision 7.
machine : String
machine =
  read = .ok $ std::fs::read_to_string "/proc/cpuinfo"
  found = .and_then (\t -> model_name (&t)) read
  cpu = .unwrap_or (.to_string "unknown CPU") found
  profile = if cfg! \-> debug_assertions
    "debug"
  else
    "release"
  format! \-> "#{cpu}, #{profile} build"

-- | The `model name` line of `/proc/cpuinfo`, as its value.
-- |
-- | `#[cfg(test)]` is not wanted here — `machine` calls it — but it is its own
-- | construct because doc 06 §1 allows one per file and `machine`'s closure
-- | chain needed a name to be readable at all.
model_name : &str -> Option<String>
model_name body =
  line = (.find (\l -> .starts_with "model name" l) (.lines body))?
  split = (.split_once ": " line)?
  Some $ .to_string $ .trim split.1

-- | The report's text.
render : &[(String, usize, Duration)] -> usize -> Duration -> &str -> String
render rows total_bytes total_time machine_text =
  mut out = String::new ()
  .push_str HEADER out
  out
    |> .push_str (&format! \-> "## Machine\n\n#{machine_text}\n\n")
  out
    |> .push_str (&format! \-> "## Methodology\n\n- Each source is transpiled **#{RUNS} times**, after one discarded warm run.\n- *Transpile* means parse and emit — not `redox build`, which also writes a file and consults a cache, so timing it would time the filesystem.\n- The figure per file is the **mean**; the total is the sum of the means.\n- Timed with `std::time::Instant`. §1.1 measured that neither `hyperfine` nor `criterion` is available or pinned, and §6 declines to add one: a number reported to three significant figures does not need a statistics library.\n- `examples/lexical.sdx` is excluded, and only here — it does not parse, so transpiling it measures the error path. Every other sweep in the repository includes it deliberately.\n\n")

  -- **`u32::try_from` and `f64::from`, where the Rust wrote `total_bytes as
  -- f64`.** That cast is this crate's one entry in `docs/CONFORMANCE.md`, and
  -- the `unwrap_or 0.0` cannot mislead: `per_byte` is then zero and the guard
  -- below prints `0.0 MB/s`, so a corpus larger than 4 GB reports nothing
  -- rather than something wrong.
  bytes_f = u32::try_from total_bytes |> .ok |> .map f64::from |> .unwrap_or 0.0
  per_byte = if bytes_f > 0.0
    .as_secs_f64 total_time / bytes_f
  else
    0.0
  rate = if per_byte > 0.0
    1.0 / per_byte / 1000000.0
  else
    0.0
  count = .len rows
  ms = .as_secs_f64 total_time * 1000.0
  out
    |> .push_str (&format! \-> "## Throughput\n\n#{count} files, #{total_bytes} bytes, #{ms:.3} ms total — **#{rate:.1} MB/s**.\n\n")

  out
    |> .push_str "| File | Bytes | Mean |\n|---|---:|---:|\n"
  for row in rows
    -- Borrowed, for the reason the loop above records.
    name = &row.0
    bytes = row.1
    us = .as_secs_f64 row.2 * 1000000.0
    out
      |> .push_str (&format! \-> "| `#{name}` | #{bytes} | #{us:.1} µs |\n")

  .push_str CLOSER out
  out

-- | The report's opening, verbatim.
const HEADER : &str = "# Benchmarks\n\nPlan 44 (`docs/38 - 44 - Zero-cost Benchmarks.md`) leaf 2. Regenerate with:\n\n```bash\ncargo run -p redox-bench\n```\n\n## What is here, and what is not\n\n**The zero-cost claim is not in this document.** It is asserted in the gate, as identical optimised LLVM IR, by `crates/redox-bench/tests/zero_cost.rs`. §1.2 explains why it is not a timing: a timing assertion is a flaky gate, and three rows of this project have already written *unexplained* into their results because a gate failed for a load-dependent reason.\n\nWhat *is* here is the measurement that cannot be made exact — how fast transpiling is. It is **reported, not asserted**, for the same reason, and because a threshold would encode one machine's speed into the repository.\n\n"

-- | The closing section, verbatim.
const CLOSER : &str = "\n## Watch latency\n\n**Not measured, and the reason is worth more than a number would be.**\n\nPlan 09's watcher rebuilds on a filesystem event, so its latency is `notify`'s delivery plus a transpile plus a write. The transpile is the column above — tens of microseconds — and the other two are the filesystem's, which is not Redox's claim to make.\n\nMeasuring the whole thing would produce a number dominated by `notify`'s debounce and the page cache, reported as though it described the compiler. That is the failure mode plan 44 §1.4's *losses reported* discipline exists to prevent, so this section reports the loss instead: **the row did not measure what its register cell asked for**, because the measurement would have been misleading. The successor is whoever wants an end-to-end figure and is willing to name the filesystem in it.\n"
