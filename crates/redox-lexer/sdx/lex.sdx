import crate::Span
import crate::Token
import crate::TokenKind
import crate::Trivia
import crate::TriviaKind
import crate::cursor::Cursor
import crate::keyword::Keyword
import crate::scan::is_ident_continue
import crate::scan::is_ident_start
import crate::scan::scan_byte
import crate::scan::scan_comment
import crate::scan::scan_cstring
import crate::scan::scan_number
import crate::scan::scan_operator
import crate::scan::scan_quote
import crate::scan::scan_raw_ident
import crate::scan::scan_raw_string
import crate::scan::scan_rust_block
import crate::scan::scan_string
import crate::scan::trim_comment
import redox_diag::Code

export lex : &str -> Result<Vec<Token>, LexError>
lex src =
  .run $ Lexer::new src

export data LexError
  = LexError {
    export code : Code,
    export message : String,
    export span : Span,
    export help : Option<String>,
  }
  deriving (Debug, Clone, PartialEq, Eq)

instance LexError
  export(crate) offset_by : usize -> mut self -> Self
  offset_by base self =
    self.span := (self.span.0 + base, self.span.1 + base)
    self

export(crate) data Lexer
  = Lexer {
    cur : Cursor<'a>,
    toks : Vec<Token>,
    indents : Vec<usize>,
    pending : Vec<Trivia>,
    open_delims : Vec<(usize, usize)>,
    trailing : Option<Trivia>,
    at_line_start : bool,
  }

instance (Lexer 'a)
  export(crate) new : &'a str -> Self
  new src =
    Lexer { cur = Cursor::new src, toks = Vec::new (), indents = vec! \-> 0, pending = Vec::new (), open_delims = Vec::new (), trailing = None, at_line_start = true }

  export(crate) run : mut self -> Result<Vec<Token>, LexError>
  run self =
    (.start_of_line self)?
    while !.is_eof self.cur
      (.step self)?
    (.finish self)?
    Ok self.toks

  step : &mut self -> Result<(), LexError>
  step self =
    ws = .eat_spaces self.cur > 0

    if .is_eof self.cur
      return Ok ()

    if .peek self.cur == Some '\n'
      trailing_continues = .is_some_and (\t -> .continues_line t.kind) (.last self.toks)
      .bump self.cur
      self.at_line_start := true
      if trailing_continues || .next_line_continues self
        .eat_spaces self.cur
        return Ok ()
      .end_of_line self
      (.start_of_line self)?
      return Ok ()

    if .peek self.cur == Some '\r'
      .bump self.cur
      return Ok ()

    if (.scan_dashes self)? || (.scan_hash self)?
      return Ok ()

    start = .pos self.cur
    kind = (.scan_token self)?
    opens_a_rust_block = kind == TokenKind::Kw Keyword::Rust
    .track_delims (&kind) start self
    .push kind (start, .pos self.cur) ws self

    if opens_a_rust_block
      base = *.expect "the base level is never popped" (.last self.indents)
      body_start = .pos self.cur
      case scan_rust_block (&mut self.cur) base of
        Some code ->
          .push (TokenKind::RustBlock code) (body_start, .pos self.cur) true self
        None -> ()
    Ok ()

  scan_token : &mut self -> Result<TokenKind, LexError>
  scan_token self =
    ch = self.cur |> .peek |> .expect "step checked for eof"

    if ch == '"'
      return scan_string (&mut self.cur)
    if ch == '\''
      return scan_quote (&mut self.cur)
    if .is_ascii_digit ch
      return scan_number (&mut self.cur)

    if ch == 'r' && .peek_at 1 self.cur == Some '#'
      if .is_some_and is_ident_start (.peek_at 2 self.cur)
        return scan_raw_ident (&mut self.cur)
      return scan_raw_string (&mut self.cur)
    if ch == 'r' && .peek_at 1 self.cur == Some '"'
      return scan_raw_string (&mut self.cur)
    byte_prefix = case .peek_at 1 self.cur of
      Some '"' or Some '\'' -> true
      _ -> false
    if ch == 'b' && byte_prefix
      return scan_byte (&mut self.cur)
    if ch == 'c' && .peek_at 1 self.cur == Some '"'
      return scan_cstring (&mut self.cur)

    if is_ident_start ch
      span = .eat_while is_ident_continue self.cur
      text = .slice span self.cur
      word = case Keyword::from_text text of
        Some kw -> TokenKind::Kw kw
        None -> TokenKind::Ident $ .to_string text
      return Ok word

    case scan_operator (&mut self.cur) of
      Some kind ->
        return Ok kind
      None -> ()

    start = .pos self.cur
    .bump self.cur
    Err (LexError { code = Code::UnexpectedCharacter, help = None, message = format! \-> "unexpected character #{ch:?}", span = (start, .pos self.cur) })

  scan_hash : &mut self -> Result<bool, LexError>
  scan_hash self =
    if .peek self.cur != Some '#'
      return Ok false
    start = .pos self.cur

    if .starts_with "\#[" self.cur || .starts_with "\#![" self.cur
      inner = .starts_with "\#![" self.cur
      opener = if inner
        "\#!["
      else
        "\#["
      self.cur |> .eat opener
      body_start = .pos self.cur
      mut depth : i32 = 1
      while depth > 0
        ch = case .bump self.cur of
          Some c -> c
          None ->
            return Err (LexError { code = Code::UnterminatedAttribute, help = None, message = .to_string "unterminated attribute; expected `]`", span = (start, .pos self.cur) })
        case ch of
          '[' -> depth += 1
          ']' -> depth -= 1
          _ -> ()
      text = self.cur
        |> .slice (body_start, .pos self.cur - 1)
        |> .to_string
      marker = if inner
        TriviaKind::InnerAttribute
      else
        TriviaKind::Attribute
      self.pending
        |> .push (Trivia::comment marker text (start, .pos self.cur))
      return Ok true

    Ok false

  scan_dashes : &mut self -> Result<bool, LexError>
  scan_dashes self =
    start = .pos self.cur

    if .starts_with "{-" self.cur
      .eat "{-" self.cur
      body_start = .pos self.cur
      mut depth : i32 = 1
      while depth > 0
        if .starts_with "{-" self.cur
          .eat "{-" self.cur
          depth += 1
          continue
        if .starts_with "-}" self.cur
          .eat "-}" self.cur
          depth -= 1
          continue
        if .is_none (.bump self.cur)
          return Err (LexError { code = Code::UnterminatedFence, help = Some (.to_string "close it with `-}`"), message = .to_string "unterminated `{- -}` comment", span = (start, .pos self.cur) })
      end = .pos self.cur - 2
      text = self.cur
        |> .slice (body_start, end)
        |> .trim
        |> .to_string
      self.pending
        |> .push (Trivia::comment TriviaKind::FencedComment text (start, .pos self.cur))
      return Ok true

    found = case scan_comment (.rest self.cur) of
      Some pair -> pair
      None ->
        return Ok false
    kind = found.0
    marker = found.1
    for _step in 0 .. marker
      .bump self.cur

    body = .eat_while (!= '\n') self.cur
    text = trim_comment $ .slice body self.cur
    trivium = Trivia::comment kind text (start, .pos self.cur)

    if !self.at_line_start && .is_some_and (\t -> !.is_structural t.kind) (.last self.toks)
      self.trailing := Some trivium
    else
      self.pending |> .push trivium
    Ok true

  track_delims : &TokenKind -> usize -> &mut self -> ()
  track_delims kind start self =
    case kind of
      TokenKind::LParen or TokenKind::LBracket or TokenKind::LBrace ->
        self.open_delims |> .push (start, .len self.indents)
      TokenKind::RParen or TokenKind::RBracket or TokenKind::RBrace ->
        mark = case .pop self.open_delims of
          Some opened -> opened.1
          None ->
            return ()
        while .len self.indents > mark
          .pop self.indents
          .push TokenKind::Dedent (start, start) false self
      _ -> ()
    ()

  next_line_continues : &mut self -> bool
  next_line_continues self =
    leading : &[&str] = &[">>>", "<<<", "|>"]
    mark = .mark self.cur
    .eat_spaces self.cur

    while .starts_with "--" self.cur && !.starts_with "-- |" self.cur
      .eat_while (!= '\n') self.cur
      .bump self.cur
      .eat_spaces self.cur

    continues = .any (\op -> .starts_with op self.cur) (.iter leading)
    .reset_to mark self.cur
    continues

  end_of_line : &mut self -> ()
  end_of_line self =
    continued = .is_some_and (\t -> .continues_line t.kind) (.last self.toks)
    if continued
      return ()
    if .is_some_and (\t -> !.is_structural t.kind) (.last self.toks)
      at = (.pos self.cur, .pos self.cur)
      .push TokenKind::Newline at false self
      trailing = .take self.trailing
      last = self.toks
        |> .last_mut
        |> .expect "a Newline was just pushed"
      last.trailing := trailing
    ()

  start_of_line : &mut self -> Result<(), LexError>
  start_of_line self =
    loop
      line_start = .pos self.cur
      width = (.measure_indent self)?

      case .peek self.cur of
        None ->
          return Ok ()
        Some '\n' ->
          .bump self.cur
          .push_blank line_start (.pos self.cur) self
          continue
        Some '\r' ->
          .bump self.cur
          continue
        Some '#' or Some '-' or Some '{' ->
          before = .pos self.cur
          if !(.scan_dashes self)? && !(.scan_hash self)?
            return .sync_indent width line_start self
          if .is_some_and (\t -> t.span.0 >= before) (.last self.toks)
            return .sync_indent width line_start self
          if .peek self.cur == Some '\n'
            .bump self.cur
          continue
        Some _ ->
          return .sync_indent width line_start self

  measure_indent : &mut self -> Result<usize, LexError>
  measure_indent self =
    mut width : usize = 0
    loop
      case .peek self.cur of
        Some ' ' ->
          .bump self.cur
          width += 1
        Some '\t' ->
          start = .pos self.cur
          .bump self.cur
          return Err (LexError { code = Code::TabIndent, help = Some (.to_string "indent with spaces"), message = .to_string "tab in indentation; Redox indents with spaces", span = (start, .pos self.cur) })
        _ ->
          return Ok width

  sync_indent : usize -> usize -> &mut self -> Result<(), LexError>
  sync_indent width line_start self =
    closes = case .peek self.cur of
      Some ')' or Some ']' or Some '}' -> true
      _ -> false
    if !.is_empty self.open_delims && closes
      return Ok ()

    top = *.expect "indent stack is never empty" (.last self.indents)
    at = (line_start + width, line_start + width)

    if width > top
      self.indents |> .push width
      .push TokenKind::Indent at false self
      return Ok ()

    while width < *.expect "indent stack is never empty" (.last self.indents)
      .pop self.indents
      .push TokenKind::Dedent at false self
    if width != *.expect "indent stack is never empty" (.last self.indents)
      return Err (LexError { code = Code::InconsistentDedent, help = Some (.to_string "match an enclosing indentation level"), message = format! \-> "inconsistent dedent: #{width} spaces matches no enclosing indentation level", span = at })
    Ok ()

  finish : &mut self -> Result<(), LexError>
  finish self =
    case .first self.open_delims of
      Some opened ->
        pos = opened.0
        return Err (LexError { code = Code::UnbalancedDelimiter, help = Some (.to_string "add the closing delimiter"), message = .to_string "unbalanced delimiter: this is never closed", span = (pos, pos + 1) })
      None -> ()

    self |> .end_of_line
    end = .pos self.cur
    while .len self.indents > 1
      .pop self.indents
      .push TokenKind::Dedent (end, end) false self
    .push TokenKind::Eof (end, end) false self
    Ok ()

  push : TokenKind -> Span -> bool -> &mut self -> ()
  push kind span ws_before self =
    if !.is_structural kind
      self.at_line_start := false
    leading = if .is_structural kind
      Vec::new ()
    else
      std::mem::take $ &mut self.pending
    self.toks
      |> .push (Token { kind, span, ws_before, leading, trailing = None })
    ()

  push_blank : usize -> usize -> &mut self -> ()
  push_blank start end self =
    case .last_mut self.pending of
      Some t | t.kind == TriviaKind::BlankLines ->
        t.span.1 := end
      _ ->
        self.pending |> .push (Trivia::blank (start, end))
    ()
