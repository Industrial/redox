import crate::Token

-- | One piece of a string literal: literal text, or an interpolation.
-- |
-- | Plan 02 (`docs/07 - 02 - Lexical Surface.md`), leaf 4.
-- |
-- | Interpolation bodies are lexed **recursively** with the same scanners, so
-- | `"#{f(x, "y")}"` works and nothing needs a second tokenizer. Storing the
-- | raw body and re-lexing it in the parser would split one responsibility
-- | across two crates and give interpolated expressions worse spans.
export data StrPart
  -- | Literal text, with escapes already decoded.
  = Text String
  -- | `#{expr}` or `#{expr:spec}`.
  | Interp {
    -- | The body, lexed with the ordinary scanners.
    tokens : Vec<Token>,
    -- | Rust format-spec text, carried verbatim for plan 23's emitter to paste
    -- | into the format string. Not interpreted here — rustc validates it.
    spec : Option<String>,
  }
  deriving (Debug, Clone, PartialEq, Eq)
