import crate::lexer::cursor::Cursor
import crate::lexer::scan_string::split_parts::split_parts
import crate::lexer::skip_interpolation::skip_interpolation
import crate::{LexError, TokenKind}
import redox_diag::Code

-- | Split a string body into literal text and interpolations.
export(crate) module split_parts

-- | Scan a `"…"` or `"""…"""` literal, the cursor on the opening quote.
-- |
-- | Plan 02 (`docs/07 - 02 - Lexical Surface.md`), leaves 4 and 5.
-- |
-- | A `"""` block is dedented and then handed to the same part-splitting logic
-- | a single-quoted string uses, which is why interpolation works inside it for
-- | free — the property Emerald's 447-line heredoc pass had to be built to
-- | obtain, and which a hand-written cursor gives without effort.
export(crate) scan_string : &mut Cursor -> Result<TokenKind, LexError>
scan_string cur =
  start = .pos cur

  triple = .starts_with "\"\"\"" cur
  delim = if triple
    "\"\"\""
  else
    "\""
  -- Piped, because the line above binds a **block**: a following `.name`
  -- statement is read as field access on it, which is `RDX0115`.
  cur |> .eat delim

  -- Collect the raw body, stopping at the closing delimiter. Escapes are not
  -- decoded here — the body is split into parts first, so an escaped `\#`
  -- cannot open an interpolation.
  body_start = .pos cur
  loop
    if .is_eof cur
      return Err (LexError { code = Code::UnterminatedString, help = None, message = format! \-> "unterminated string literal; expected closing #{delim}", span = (start, .pos cur) })
    if .starts_with delim cur
      break
    -- An interpolation's body is skipped whole, because a string literal
    -- inside it must not be mistaken for this string's closing quote —
    -- `"outer #{String::from("inner")} done"`. Plan 23 found this claim
    -- false after plan 02 asserted it; `skip_interpolation` says why.
    if .starts_with "\#{" cur
      (skip_interpolation cur 0)?
      continue
    if .peek cur == Some '\\'
      .bump cur
      .bump cur
      continue
    if !triple && .peek cur == Some '\n'
      -- Names both the likely cause (a missing closing quote) and the
      -- alternative, because a reader who meant to span lines needs the
      -- second half and a reader who forgot a quote needs the first.
      return Err (LexError { code = Code::UnterminatedString, help = None, message = .to_string "unterminated string literal: a single-quoted string may not span lines — use \"\"\" for a multi-line string", span = (start, .pos cur) })
    .bump cur
  body_end = .pos cur
  .eat delim cur

  raw = .to_string (.slice (start, .pos cur) cur)
  body = .slice (body_start, body_end) cur

  -- A `"""` block drops its delimiter lines and loses its common indentation
  -- (doc 01 §7.2), before any part splitting. The rule lives in
  -- `verbatim_triple` because plan 45's escape hatch needs the same body
  -- *undecoded*, and two copies of this would be free to disagree about what a
  -- block's body is.
  owned = if triple
    crate::verbatim_triple::dedent_triple_body::dedent_triple_body body
  else
    .to_string body

  Ok (TokenKind::Str { parts = (split_parts (&owned) body_start)?, raw })
