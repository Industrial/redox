import crate::Span

export data Trivia = Trivia { export kind : TriviaKind, export text : String, export span : Span }
  deriving (Debug, Clone, PartialEq, Eq)

instance Trivia
  export(crate) comment : TriviaKind -> String -> Span -> Self
  comment kind text span = Trivia { kind, text, span }

  export(crate) blank : Span -> Self
  blank span = Trivia { kind = TriviaKind::BlankLines, text = String::new (), span }

export data TriviaKind
  = LineComment
  | DocComment
  | InnerDocComment
  | FencedComment
  | Attribute
  | InnerAttribute
  | BlankLines
  deriving (Debug, Clone, PartialEq, Eq)

instance TriviaKind
  export is_doc : &self -> bool
  is_doc self = case self of
    DocComment or InnerDocComment -> true
    _ -> false
