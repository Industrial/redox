import crate::emit::expr::emit_expr
import crate::emit::single_line_if_else_max_width::SINGLE_LINE_IF_ELSE_MAX_WIDTH
import crate::emit::sole_expression::sole_expression
import crate::emit::unparen::unparen
import redox_ast::Guard

-- | A two-armed guard ladder as one line, when rustfmt would write it that
-- | way.
-- |
-- | ```text
-- | halve n                          if n % 2 == 0 { Some(n / 2) } else { None }
-- |   | n % 2 == 0 = Some (n / 2)
-- |   | otherwise  = None
-- | ```
-- |
-- | `None` unless **every** condition holds: exactly two rows, the second
-- | `otherwise`, each body a single expression, and the result no wider than
-- | `SINGLE_LINE_IF_ELSE_MAX_WIDTH`. Anything else is the multi-line form,
-- | which is what rustfmt leaves alone in every other case.
-- |
-- | `indent` is not part of the width test, because rustfmt's is not: the rule
-- | measures the expression, as `chain_width` and `fn_call_width` do. It is
-- | taken here only so the bodies are rendered at the right column should one
-- | of them span lines — in which case the one-line form is refused anyway.
export(crate) two_armed : &[Guard] -> usize -> Option<String>
two_armed guards indent =
  guard guards is [first, second] else
    return None
  condition = (.as_ref first.condition)?
  if .is_some second.condition
    return None
  then_text = (sole_expression first indent)?
  else_text = (sole_expression second indent)?
  head = emit_expr (unparen condition) indent
  text = format! \-> "if #{head} { #{then_text} } else { #{else_text} }"
  if .len text > SINGLE_LINE_IF_ELSE_MAX_WIDTH || .contains '\n' text
    return None
  Some text
