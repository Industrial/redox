import crate::emit::expr::emit_expr
import crate::emit::field_value::field_value
import crate::emit::names_a_constructor::names_a_constructor
import crate::emit::one_field::one_field
import crate::emit::rust_indent::RUST_INDENT
import crate::emit::struct_lit_width::STRUCT_LIT_WIDTH
import crate::emit::unparen::unparen
import redox_ast::{Expr, FieldInit}

-- | Lower doc 18 §2.4's record literal, starting at column `indent`.
-- |
-- | ```text
-- | Point { x = 10, y = 20 }   Point { x: 10, y: 20 }
-- | Point { x, y }         →   Point { x, y }
-- | p { x = 99 }               { let mut __rdx_r = p; __rdx_r.x = 99; __rdx_r }
-- | ```
-- |
-- | **Construction or update is decided by the case of the head**, which doc
-- | 18 §5.3 makes meaningful and §2.4 says is "why the update form is
-- | admissible at all". An uppercase head names a constructor; anything else
-- | names a value.
-- |
-- | Update is one of §6's disclosed lowerings, and §6 gives the reason it is
-- | not Rust's `Point { x: 99, ..p }`: that form needs the type's *path*, and
-- | the source gives only the value's name. The block needs no type at all,
-- | and it moves `p` exactly as `..p` would.
-- |
-- | A punned field emits Rust's own shorthand, `Point { x }`. Doc 18 §2.4's
-- | table writes `Point { x: x, y: y }`, which is equivalent — and which
-- | clippy's `redundant_field_names` would flag in the user's own build. The
-- | doc is corrected rather than followed here: a lowering that makes the
-- | generated file noisy to lint fails doc 01 §3.4's readability requirement
-- | for no gain.
export(crate) emit_record : &Expr -> &[FieldInit] -> usize -> String
emit_record head fields indent =
  inner_pad = .repeat (indent + RUST_INDENT) " "
  close_pad = .repeat indent " "
  if !names_a_constructor head
    -- `p { x = 99 }` — the update lowering. Multi-line, because rustfmt
    -- expands a block of statements unconditionally.
    base = emit_expr (unparen head) $ indent + RUST_INDENT
    mut updated = format! \-> "{\n#{inner_pad}let mut __rdx_r = #{base};\n"
    for f in fields
      value = field_value f $ indent + RUST_INDENT
      .push_str (&format! \-> "#{inner_pad}__rdx_r.#{f.name.text} = #{value};\n") updated
    .push_str (&format! \-> "#{inner_pad}__rdx_r\n#{close_pad}}") updated
    return updated
  head_text = emit_expr (unparen head) indent
  if .is_empty fields
    return head_text
  texts : Vec<String> = fields
    |> .iter
    |> .map (\f -> one_field f indent)
    |> .collect
  joined = .join ", " texts
  if .len joined <= STRUCT_LIT_WIDTH && !.contains '\n' joined
    return format! \-> "#{head_text} { #{joined} }"
  mut text = format! \-> "#{head_text} {\n"
  for f in fields
    one = one_field f $ indent + RUST_INDENT
    .push_str (&format! \-> "#{inner_pad}#{one},\n") text
  .push_str (&format! \-> "#{close_pad}}") text
  text
