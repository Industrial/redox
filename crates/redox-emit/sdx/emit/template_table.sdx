import redox_ast::{DeriveTemplate, Item}

-- | Every `deriving` template a file declares, by name — plan 89.
-- |
-- | **Collect and never transform**, which is plan 61's rule about a pass with
-- | two consumers: written once at the emitter's entry and read while a `data`
-- | declaration's `deriving` list is emitted, changing no node either time.
-- |
-- | A `BTreeMap` for `redox-emit`'s standing reason — the output must be
-- | byte-stable and a hash map's iteration order is not. Here it matters: a
-- | declaration deriving two templates emits two impls, and their order is this
-- | map's.
-- |
-- | Scope is the file, which is plan 56 §1.4's boundary and plan 14 decision
-- | 4's refusal of name resolution. An undeclared name in a `deriving` list is
-- | already something — doc 03 §9.5 passes it through to `#[derive(…)]` — so
-- | the boundary is rustc's `E0433` rather than a Redox diagnostic, which plan
-- | 89 §9 decision 4 records as the cost of having no resolver.
export(crate) data TemplateTable = TemplateTable {
  by_name : std::collections::BTreeMap<String, DeriveTemplate>,
}
  deriving (Debug, Clone, Default)

instance TemplateTable
  -- | Collect every `deriving template` declaration among `items`.
  export(crate) from_items : &[Item] -> Self
  from_items items =
    mut by_name = std::collections::BTreeMap::new ()
    for item in items
      if item is Item::DeriveTemplate decl
        .insert (.clone decl.name.text) (.clone decl) by_name
    TemplateTable { by_name }

  -- | The template `name` stands for, if this file declared one.
  export(crate) get : &str -> &self -> Option<DeriveTemplate>
  get name self = self.by_name |> .get name |> .cloned
