import crate::emit::generics::generics
import crate::emit::member::emit_member
import crate::emit::pad::pad
import crate::emit::rust_indent::RUST_INDENT
import crate::emit::sink::Sink
import crate::emit::trivia::emit_trivia
import redox_ast::InstanceDecl

-- | Emit doc 18 §2.5's `instance` as a Rust `impl`.
-- |
-- | ```text
-- | instance Display t => Describe (Wrapper t)   impl<T: Display> Describe for Wrapper<T> {
-- | instance Convert f64 Meters              →   impl Convert<f64> for Meters {
-- | instance Counter                             impl Counter {
-- | ```
-- |
-- | The generic list is **synthesised** — doc 18 §5.3's "type variables need
-- | no declaration … the generic list is synthesised from first appearance" —
-- | and the constraints become its bounds. That is the one place a Redox type
-- | is assembled rather than copied verbatim, and `TypeApp` exists to make it
-- | possible: a captured string cannot say which of its words were variables.
-- |
-- | The class carries arguments of its own since plan 67, so it is printed by
-- | the same `rust_text` the target is: `Convert<f64>`, not `Convert`.
export(crate) emit_instance : &mut Sink<'_> -> &InstanceDecl -> usize -> ()
emit_instance out i indent =
  .unmark out
  emit_trivia out (&i.leading) indent
  .mark i.span out
  pad out indent
  .push_str "impl" out
  .push_str (&generics (&i.target) (&i.constraints)) out
  .push ' ' out
  if &i.r#class is Some named
    lowered = .rust_text named
    .push_str (&format! \-> "#{lowered} for ") out
  .push_str (&.rust_text i.target) out
  .push_str " {\n" out
  for m in &i.members
    emit_member out m $ indent + RUST_INDENT
  .unmark out
  pad out indent
  .push_str "}\n" out
  ()
