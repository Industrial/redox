import crate::emit::emit_body::emit_body
import crate::emit::emit_where_locals::emit_where_locals
import crate::emit::expr::emit_expr
import crate::emit::inline_comment::emit_inline_comment
import crate::emit::one_tail_expression::one_tail_expression
import crate::emit::pad::pad
import crate::emit::rust_indent::RUST_INDENT
import crate::emit::sink::Sink
import crate::emit::unparen::unparen
import redox_ast::Clause

-- | Emit one `match` arm for a clause, at `indent` spaces.
-- |
-- | Two spellings of the same arm. A clause whose body is a single tail
-- | expression becomes `pat => expr,`; anything else becomes a braced block.
-- |
-- | The distinction is not cosmetic. Plan 04's guarantee is that generated Rust
-- | is already rustfmt-clean, and rustfmt *collapses* `0 => { 0 }` to
-- | `0 => 0,`, so emitting the braced form for a one-expression arm made
-- | `examples/guards.sdx` the first example rustfmt would have rewritten. The
-- | braced form is kept for every other body, because that is what rustfmt
-- | leaves alone — a guard ladder in an arm stays `n => { if … }`.
-- |
-- | Found by adding an example, not by a unit test: the clause tests asserted
-- | `0 => {` and passed, because nothing in them ran rustfmt over the result.
export(crate) emit_arm : &mut Sink<'_> -> &Clause -> &str -> usize -> bool -> ()
emit_arm out clause arm indent tail =
  -- A clause with `where` locals is never collapsed to `pat => expr,`: the
  -- locals need statements, and an arm with statements needs its braces.
  collapsed = .filter (\_ -> .is_empty clause.wheres) (one_tail_expression clause tail)
  if collapsed is Some stmt
    .mark stmt.span out
    pad out indent
    .push_str arm out
    .push_str " => " out
    .push_str (&emit_expr (unparen (&stmt.expr)) indent) out
    .push ',' out
    emit_inline_comment out (.as_ref stmt.trailing)
    .push '\n' out
    return ()
  pad out indent
  .push_str arm out
  .push_str " => {\n" out
  emit_where_locals out (&clause.wheres) (indent + RUST_INDENT)
  -- Every arm is a tail position: a `match` arm's value is the arm's value,
  -- whether or not the function returns anything.
  -- A `match` arm's body, where rustfmt expands a two-armed `if`/`else` that
  -- it would have joined in a function body.
  emit_body out (&clause.body) (indent + RUST_INDENT) tail false
  pad out indent
  .push_str "}\n" out
  ()
