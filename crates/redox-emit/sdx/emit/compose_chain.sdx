import crate::emit::unparen::unparen
import redox_ast::{BinaryOp, Expr}

-- | The functions a composition chain applies, in **application order**.
-- |
-- | `f >>> g >>> h` is `[f, g, h]`, and `f <<< g` is `[g, f]` — one lowering
-- | for both directions, which is plan 66 §3 case 6's equivalence read off the
-- | order rather than asserted twice.
-- |
-- | Flattening rather than letting [`compose`](super::compose::compose) recurse
-- | through the emitter is what keeps the lowering **one** closure. A nested
-- | composition reached as an operand emits a closure inside its parent's body,
-- | immediately applied and binding the same `__rdx_1` the parent already
-- | bound. That is *correct* — the argument is evaluated outside the inner
-- | closure, so the shadow never bites — and it is unreadable in a file doc 02
-- | §10.1 makes human-facing.
-- |
-- | `unparen` so a parenthesised chain flattens too: `(f >>> g) >>> h` is the
-- | tree left-associativity already builds, and `f >>> (g >>> h)` is the one an
-- | author writes.
export(crate) compose_chain : BinaryOp -> &'a Expr -> &'a Expr -> &mut Vec<&'a Expr> -> ()
compose_chain op lhs rhs out =
  -- `swap` inline rather than a helper beside this function: doc 06 §1 is one
  -- construct per file. The `case` is the Rust's `matches!`, whose second
  -- argument is a pattern.
  swap = case op of
    BinaryOp::ComposeBack -> true
    _ -> false
  -- `sides.0` and `sides.1`, where the Rust destructured the pair.
  sides = if swap
    (rhs, lhs)
  else
    (lhs, rhs)
  -- A guard rather than `inner @ (A or B)`, because the emitter writes an
  -- as-pattern over an alternation **without parentheses** — `inner @ A | B`,
  -- which rustc refuses as `E0408: variable inner is not bound in all
  -- patterns`. Plan 81 §2 records it; the row is owed.
  for side in [sides.0, sides.1]
    bare = unparen side
    composed = case bare of
      Expr::Binary { op, lhs, rhs, .. } | *op == BinaryOp::Compose || *op == BinaryOp::ComposeBack ->
        Some (*op, lhs, rhs)
      _ -> None
    case composed of
      Some parts -> compose_chain parts.0 parts.1 parts.2 out
      None -> .push bare out
  ()
