import crate::emit::member::emit_member
import crate::emit::pad::pad
import crate::emit::rust_indent::RUST_INDENT
import crate::emit::sink::Sink
import crate::emit::trivia::emit_trivia
import redox_ast::{ClassDecl, TypeApp}

-- | Emit doc 18 §2.5's `class` as a Rust `trait`.
-- |
-- | ```text
-- | class Debug => Shape         trait Shape: Debug {
-- |   type Unit                      type Unit;
-- |   const SIDES : u32         →   const SIDES: u32;
-- |   area : &self -> f64           fn area(&self) -> f64;
-- |                              }
-- |
-- | class Convert t              trait Convert<T> {
-- |   wrap : t -> Self          →   fn wrap(__rdx_a0: T) -> Self;
-- |                              }
-- | ```
-- |
-- | The class's parameters become the trait's generic list, **in source
-- | order** — plan 67 leaf 2, and the order is the source's because the
-- | emitter's output has to be byte-stable. The superclass list becomes Rust's
-- | supertrait bounds, joined with `+`. Nothing else changes: Rust's trait
-- | system *is* Haskell's class system, so doc 18 §2.5 changes the words and
-- | leaves the content alone.
export(crate) emit_class : &mut Sink<'_> -> &ClassDecl -> usize -> ()
emit_class out c indent =
  .unmark out
  emit_trivia out (&c.leading) indent
  .mark c.span out
  pad out indent
  vis = .rust_text c.visibility
  .push_str (&format! \-> "#{vis}trait #{c.name.text}") out
  if !.is_empty c.params
    params : Vec<String> = c.params
      |> .iter
      |> .map (\p -> TypeApp::rust_name (&p.text))
      |> .collect
    joined = .join ", " params
    .push_str (&format! \-> "<#{joined}>") out
  if !.is_empty c.supers
    names : Vec<&str> = c.supers
      |> .iter
      |> .map (\s -> .as_str s.text)
      |> .collect
    joined = .join " + " names
    .push_str (&format! \-> ": #{joined}") out
  .push_str " {\n" out
  for m in &c.members
    emit_member out m $ indent + RUST_INDENT
  .unmark out
  pad out indent
  .push_str "}\n" out
  ()
