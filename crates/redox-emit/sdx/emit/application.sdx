import crate::emit::closure::closure
import crate::emit::closure_param::closure_param
import crate::emit::expr_list::expr_list
import crate::emit::method_ref::method_ref
import crate::emit::missing_arity::missing_arity
import crate::emit::receiver::receiver
import crate::emit::unparen::unparen
import redox_ast::Expr

-- | Lower doc 18 §2.1's application: a saturated call, or the closure an
-- | under-applied one becomes.
-- |
-- | Plan 56 (`docs/50 - 56 - Currying.md`) leaves 1, 2 and 4.
-- |
-- | ```text
-- | add 1 2      add(1, 2)
-- | add 1        |__rdx_1| add(1, __rdx_1)
-- | tagged "x"   |__rdx_1, __rdx_2| tagged("x", __rdx_1, __rdx_2)
-- | add 1 $ 2    add(1, 2)
-- | op 7 8       op(7, 8)
-- | ```
-- |
-- | Three things are deliberate about the shape.
-- |
-- | **The closure is flat, not nested.** Haskell would read a one-of-three as
-- | three closures, and §3 case 2 says *"nested closures"*; it cannot be, and
-- | the reason is on the **consumer** side rather than this one. An
-- | under-applied value is bound to a name, and a call of that name is a call
-- | of an *unknown-arity* name — `inc 5` emits `inc(5)` and `two 2 3` emits
-- | `two(2, 3)`, because no signature in the file names them. A nested closure
-- | would reject both. So the closure binds every parameter still missing, in
-- | one list, which is the shape the rest of the language already calls.
-- |
-- | **`f a $ b` is flattened back into `f(a, b)`.** §11.6's decision: `$` is
-- | Haskell's loose application and carries no meaning beyond precedence, so
-- | if `add 1 $ 2` allocated a closure and `add 1 2` did not, `$` would have
-- | become semantically significant and a reader would have to know which
-- | spelling allocates. The flatten is gated on [`missing_arity`] — *the inner
-- | call would have become a closure that is immediately called* — so it
-- | collapses exactly the allocation it was about to make, and a saturated
-- | inner call (`add 1 2 $ 3`) is left alone for rustc to judge.
-- |
-- | **The callee goes through [`receiver`].** `(` binds as tightly as `.`, so a
-- | callee that is a closure needs its parentheses, and §11.5 found that it did
-- | not get them: the Call arm called bare `emit_expr` and never consulted
-- | `wraps_as_receiver`, which does list `Expr::Lambda` and `Expr::Section`.
-- | `print ((+ 1) 2)` emitted `|__rdx_1| __rdx_1 + 1(2)` — broken Rust — and
-- | `print ((\_ -> 7) 1)` only worked because a *written* paren leaves an
-- | `Expr::Paren` behind. A synthesized closure has no `Paren`, so this row
-- | would have inherited the first shape; §11.5 asks for the fix in the row
-- | that creates synthesized lambdas, and this is it.
export(crate) emit_application : &Expr -> &[Expr] -> usize -> String
emit_application callee args indent =
  -- The `matches!` as a `case`, bound before the chain, because a macro's
  -- second argument cannot be a pattern.
  if unparen callee is Expr::Call { callee = inner, args = inner_args, .. }
    inner_is_method_ref = case unparen inner of
      Expr::MethodRef { .. } -> true
      _ -> false
    if .is_some (missing_arity inner inner_args) || inner_is_method_ref
      mut flattened = .clone inner_args
      .extend (.cloned (.iter args)) flattened
      return emit_application inner (&flattened) indent
  -- Plan 57's method-as-function. Not a call of a callee at all: the **last**
  -- argument is the receiver, so `.cmp y x` is `x.cmp(y)`. It is reached from
  -- here rather than from `emit_expr`'s `MethodRef` arm because that arm sees
  -- the method applied to *nothing* — the value awaiting its receiver — and
  -- this one sees the application.
  --
  -- The flatten above covers it too: `(.insert k) v m` is `.insert k v m` by
  -- associativity, which §11.6 is the note for, and `$` reaches the same
  -- shape.
  if unparen callee is Expr::MethodRef { name, .. }
    return method_ref name args indent
  head = receiver callee indent
  -- **A constructor applied to `()` passes unit.** `expr_list` collapses a
  -- lone unit argument to the empty list, because `f ()` is doc 18 §7's
  -- zero-argument call — and its doc comment accepts the trade that a
  -- function genuinely taking a `()` then cannot be called by juxtaposition,
  -- on the grounds that a unit parameter is rare. It is not: it is how every
  -- `Result<(), E>` function returns, and plan 74 found `return Ok (())`
  -- emitting `return Ok();` eleven times in `redox-lexer`.
  --
  -- The two readings are told apart by the convention the language already
  -- runs on — the case of the first letter, which decides a type variable
  -- (doc 18 §5.3) and a constructor pattern's path (plan 68). An uppercase
  -- last segment is a constructor, so `Ok ()` is `Ok(())`; a lowercase one is
  -- a function, so `String::new ()` stays `String::new()`.
  --
  -- Nothing takes this away: a unit struct is written `Marker` with no call,
  -- and `data` cannot declare a zero-field tuple struct.
  lone_unit = case args of
    [Expr::Unit { .. }] -> true
    _ -> false
  unit_argument = lone_unit && .is_some_and (\seg -> .starts_with char::is_uppercase seg) (.next (.rsplit "::" head))
  guard missing_arity callee args is Some missing else
    if unit_argument
      return format! \-> "#{head}(())"
    listed = expr_list args indent
    return format! \-> "#{head}(#{listed})"
  params : Vec<String> = (0 .. missing) |> .map closure_param |> .collect
  listed = expr_list args indent
  joined = .join ", " params
  body = format! \-> "#{head}(#{listed}, #{joined})"
  closure (&params) (&body)
