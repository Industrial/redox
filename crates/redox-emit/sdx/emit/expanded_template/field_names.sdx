import redox_ast::{ConstructorFields, DataDecl}

-- | The declaration's field names, in order, for `Field0`… to replace — plan
-- | 89.
-- |
-- | | Shape | Yields |
-- | |---|---|
-- | | `newtype Meters = Meters f64` | `["0"]` — Rust's own spelling for a tuple field |
-- | | `data P = P { x : u32, y : u32 }` | `["x", "y"]` |
-- | | `data Marker = Marker` | none |
-- | | `data E = A \| B` | none |
-- |
-- | **A single-constructor declaration only.** A `data` with alternatives has
-- | no one field list, so it yields none and a template's `FieldN` is left for
-- | rustc to report. That is the honest answer rather than picking a
-- | constructor: choosing one would be an inference, and choosing the first
-- | would be an inference that usually looks right.
export(crate) field_names : &DataDecl -> Vec<String>
field_names d = case .as_slice d.constructors of
  [only] -> case &only.fields of
    -- A tuple constructor's fields are positional, so the name *is* the index
    -- and `self.Field0` becomes `self.0` — which is what a hand-written
    -- forwarding impl for a newtype writes.
    ConstructorFields::Tuple types -> 0 .. .len types |> .map (\i -> format! \-> "#{i}") |> .collect
    ConstructorFields::Record fields -> fields |> .iter |> .map (\f -> .clone f.name.text) |> .collect
    ConstructorFields::Unit -> Vec::new ()
  _ -> Vec::new ()
