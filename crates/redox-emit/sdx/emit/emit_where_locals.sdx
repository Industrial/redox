import crate::emit::emit_stmts::emit_stmts
import crate::emit::sink::Sink
import crate::emit::where_order::where_order
import redox_ast::Stmt

-- | A `where` group's entries, emitted in dependency order — plan 61 leaf 2.
-- |
-- | The one place a `where` group becomes Rust, so the sort has exactly one
-- | caller's worth of surface: `emit_clauses` for a function's own body and
-- | `emit_arm` for a clause that became a `match` arm, both of which called
-- | `emit_stmts` on `clause.wheres` directly before this existed.
-- |
-- | # A clone, deliberately
-- |
-- | The reordered slice is a `Vec<Stmt>` built here rather than a permutation
-- | applied in `emit_stmts`, because `emit_stmts` reads *runs* of statements —
-- | a draw arrow owns every statement after it as its callback body — and an
-- | index-indirection layer threaded through that would be a second way to
-- | walk the same list. `Program` is untouched, which is leaf 2's rule and the
-- | reason the formatter still prints the author's order.
export(crate) emit_where_locals : &mut Sink<'_> -> &[Stmt] -> usize -> ()
emit_where_locals out wheres indent =
  if .len wheres < 2
    emit_stmts out wheres indent false
    return ()
  ordered : Vec<Stmt> = where_order wheres
    |> .into_iter
    |> .map (\i -> .clone wheres[i])
    |> .collect
  emit_stmts out (&ordered) indent false
  ()
