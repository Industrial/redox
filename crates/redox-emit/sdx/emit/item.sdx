import crate::emit::trivia::emit_trivia
import crate::emit::binding_kind::BindingKind
import crate::emit::binding_scope::BindingScope
import crate::emit::class::emit_class
import crate::emit::data::emit_data
import crate::emit::emit_const::emit_const
import crate::emit::emit_fn::emit_fn
import crate::emit::errors::emit_errors
import crate::emit::extern_block::emit_extern_block
import crate::emit::import::emit_import
import crate::emit::inline_rust::emit_inline_rust
import crate::emit::instance::emit_instance
import crate::emit::module::emit_module
import crate::emit::shared_const::shared_const
import crate::emit::sink::Sink
import crate::emit::type_alias::emit_type_alias
import redox_ast::Item

-- | Emit one declaration at `indent`.
-- |
-- | Extracted from `emit_items` by plan 55 leaf 5, which gave declarations a
-- | second home: a block element. Both callers read this one dispatch, so a
-- | local `data` and a module-scope one cannot drift — which matters more than
-- | it sounds, because the two are the same parse and a reader who sees them
-- | differ will reasonably assume the difference is deliberate.
-- |
-- | `Item::Test` is unreachable here. Tests are **gathered** rather than
-- | emitted in place — `emit_items` collects them into one `#[cfg(test)]`
-- | module — and a local one never reaches the emitter at all, because
-- | `RDX0112` refuses it in the parser (leaf 6).
-- |
-- | The match is exhaustive with no wildcard, for the reason `emit_expr` gives:
-- | a new `Item` must fail to compile here rather than be silently dropped.
export(crate) emit_item : &mut Sink<'_> -> &Item -> usize -> ()
emit_item out item indent =
  case item of
    Item::Fn f | BindingScope::kind_of (&f.name.text) == Some BindingKind::Shared ->
      case shared_const f of
        Some c -> emit_const out (&c) indent
        None -> emit_fn out f indent
    Item::Fn f -> emit_fn out f indent
    Item::Data d -> emit_data out d indent
    Item::Type a -> emit_type_alias out a indent
    Item::Class c -> emit_class out c indent
    Item::Instance i -> emit_instance out i indent
    Item::Errors e -> emit_errors out e indent
    Item::Import i -> emit_import out i indent
    Item::Module m -> emit_module out m indent
    Item::Const c -> emit_const out c indent
    Item::InlineRust r -> emit_inline_rust out r indent
    Item::Extern e -> emit_extern_block out e indent
    -- Plan 87. **Emits its comments and nothing else**, and both halves are the
    -- construct rather than an omission.
    --
    -- *Nothing else*, because a synonym is expanded at every use site, so the
    -- declaration has no Rust to produce — which is what leaves rustc checking
    -- the written-out pattern and never learning the name existed.
    --
    -- *Its comments*, because doc 02 §10.1 makes a comment trivia that reaches
    -- the `.xrs`, and every other arm here emits its own leading trivia. The
    -- first version emitted truly nothing and **dropped the author's comments**
    -- — then `emit_items`' separator, which counts an item that wrote no text,
    -- left two blank lines at the top of the file where the comments had been.
    -- `generated_rust_is_rustfmt_clean` caught the blanks; only reading the
    -- golden caught the loss.
    Item::PatternSynonym p ->
      .unmark out
      emit_trivia out (&p.leading) indent
    -- Plan 89, and the same shape for the same reason: a template's Rust is
    -- produced at each `deriving` list that names it, so the declaration
    -- itself has none — and its comments must still reach the `.xrs`.
    Item::DeriveTemplate t ->
      .unmark out
      emit_trivia out (&t.leading) indent
    -- Plan 90, and the third of the same shape. A declaration is fixity plus
    -- alias: it introduces no Rust name, so it has no item to emit — and its
    -- comments must still reach the `.xrs`.
    Item::OperatorDecl o ->
      .unmark out
      emit_trivia out (&o.leading) indent
    Item::Test _ ->
      unreachable! \-> "tests are gathered, not emitted in place"
  ()
