import crate::emit::pad::pad
import crate::emit::sink::Sink
import crate::emit::trivia::emit_trivia
import redox_ast::TypeAlias

-- | Emit doc 18 §2.4's `type` alias, which is already Rust.
-- |
-- | The keyword, the `=` and the type are unchanged, and the type is written
-- | verbatim (doc 03 §14.1) — so this is the shortest lowering in the emitter
-- | and the one with the least to go wrong.
export(crate) emit_type_alias : &mut Sink<'_> -> &TypeAlias -> usize -> ()
emit_type_alias out a indent =
  .mark a.span out
  emit_trivia out (&a.leading) indent
  pad out indent
  vis = .rust_text a.visibility
  .push_str (&format! \-> "#{vis}type #{a.name.text} = #{a.ty.text};\n") out
  ()
