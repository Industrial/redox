import crate::emit::expr::emit_expr
import crate::emit::pad::pad
import crate::emit::sink::Sink
import crate::emit::stmt::emit_stmt
import crate::emit::trivia::emit_trivia
import redox_ast::{Expr, Stmt}

-- | Emit a run of statements, flattening doc 30 §3.3's `with` callbacks.
-- |
-- | Every other statement lowers on its own, which is why `emit_stmt` takes one
-- | at a time. A `with` cannot: its lowering is a **callback whose body is
-- | every statement after it**, so the unit of translation is the run rather
-- | than the statement.
-- |
-- | ```text
-- | conn <- pool.with_connection      pool.with_connection(|conn| {
-- | tx <- conn.transaction        →       conn.transaction(|tx| {
-- | commit tx                                 commit(tx);
-- |                                       })
-- |                                   })
-- | ```
-- |
-- | Nesting falls out of the recursion: the second `with` is simply the
-- | first statement of the first one's body. That is doc 03 §7.6's lowering
-- | character for character, and the reason doc 18 §3.1 could delete `use`,
-- | `is`, `defer` and the comprehension's `for` in favour of one token — the
-- | flattening was already the hard part, and it was already written.
-- |
-- | `tail` applies to the **last** statement of the whole run, which after a
-- | draw arrow is the last statement of the innermost closure: that is where
-- | the function's value comes from.
export(crate) emit_stmts : &mut Sink<'_> -> &[Stmt] -> usize -> bool -> ()
emit_stmts out stmts indent tail =
  -- `split.0` is the first statement and `split.1` the rest, where the Rust
  -- destructured the pair.
  guard .split_first stmts is Some split else
    return ()
  first = split.0
  rest = split.1
  guard &first.expr is Expr::Draw { name, value, .. } else
    last = .is_empty rest
    emit_stmt out first indent (tail && last)
    emit_stmts out rest indent tail
    return ()
  .mark first.span out
  emit_trivia out (&first.leading) indent
  pad out indent
  .push_str (&emit_expr value indent) out
  .push_str "(|" out
  .push_str (&name.text) out
  .push_str "| {\n" out
  emit_stmts out rest (indent + crate::emit::rust_indent::RUST_INDENT) tail
  pad out indent
  .push_str "})" out
  -- The closing `;` is the draw-arrow statement's own, and is omitted when the
  -- callback's value is the function's value.
  if !tail
    .push ';' out
  .push '\n' out
  ()
