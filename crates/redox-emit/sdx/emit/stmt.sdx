import crate::emit::annotated_binding::annotated_binding
import crate::emit::emit_bind::emit_bind
import crate::emit::emit_control::emit_control
import crate::emit::expr::emit_expr
import crate::emit::inline_comment::emit_inline_comment
import crate::emit::item::emit_item
import crate::emit::pad::pad
import crate::emit::sink::Sink
import crate::emit::trivia::emit_trivia
import crate::emit::unparen::unparen
import redox_ast::{Expr, Stmt}

-- | Emit one block element at `indent`.
-- |
-- | `tail` marks the block's final expression, which is emitted **without a
-- | semicolon** so it becomes the block's value. Doc 01 §5.2's own example
-- | requires it: `add = (a, b): i32 -> a + b` must produce `{ a + b }`, and a
-- | trailing semicolon makes the function return `()` instead.
-- |
-- | Only a function that *declares* a return type gets a tail expression. One
-- | that does not returns `()`, and its last line is an ordinary statement —
-- | which is why a one-statement body still emits `println!("x");`.
-- |
-- | # This is the statement position, and that is a choice now rather than a type
-- |
-- | Plan 55 leaf 1 deleted `StmtKind`, so a block element and a subexpression
-- | are the same type. What used to be decided by *which enum a node lived in*
-- | is decided here instead: the forms `Expr::is_statement_form` names are
-- | written by this function, and everything else is handed to `emit_expr`.
-- | A new form still has to be considered, because `emit_expr` stays
-- | exhaustive with no wildcard for the reason its own doc gives.
export(crate) emit_stmt : &mut Sink<'_> -> &Stmt -> usize -> bool -> ()
emit_stmt out stmt indent tail =
  .mark stmt.span out
  emit_trivia out (&stmt.leading) indent
  -- Plan 20's control flow writes its own padding, its own braces and its own
  -- trailing newline, because each form spans lines and an `else if` has to
  -- reuse the line its `}` is on.
  if .is_control_flow stmt.expr
    emit_control out (&stmt.expr) indent tail
    return ()
  -- Plan 55 leaf 5. A declaration writes its own padding — `emit_item`'s
  -- callees all take an `indent` and pad from it, because a module body has
  -- always needed that — so it is routed before the pad for the same reason
  -- control flow is.
  if &stmt.expr is Expr::Item { item, .. }
    emit_item out item indent
    return ()
  pad out indent
  case &stmt.expr of
    Expr::Binding b ->
      .push_str "let " out
      if b.is_mut
        .push_str "mut " out
      .push_str (&.rust_text b.pattern) out
      -- Plan 62 leaf 1: an ascription that is the whole right-hand side is
      -- Rust's annotated `let`, so it moves to the annotation rather than
      -- emitting a block whose only job is to carry the type.
      --
      -- `annotated.0` is the type and `annotated.1` the value, where the Rust
      -- destructured the pair.
      annotated = annotated_binding b
      if annotated.0 is Some ty
        .push_str ": " out
        .push_str (&ty) out
      .push_str " = " out
      .push_str (&emit_expr annotated.1 indent) out
      .push ';' out
    Expr::Draw { .. } ->
      unreachable! \-> "a draw arrow must be emitted by `emit_stmts`, which has the following statements its callback body needs"
    Expr::Await { pattern, value, .. } -> .push_str (&emit_bind pattern value indent) out
    Expr::Assign { target, op, value, .. } ->
      operator = .map_or "" (\o -> .unwrap_or "/* unsupported */" (.rust_text o)) (*op)
      left = emit_expr (unparen target) indent
      right = emit_expr (unparen value) indent
      .push_str (&format! \-> "#{left} #{operator}= #{right};") out
    Expr::Return { value, .. } ->
      .push_str "return" out
      if value is Some e
        .push ' ' out
        .push_str (&emit_expr e indent) out
      .push ';' out
    value ->
      debug_assert! \-> !.is_statement_form value \-> "every statement form has an arm of its own above"
      .push_str (&emit_expr (unparen value) indent) out
      if !tail
        .push ';' out
  emit_inline_comment out $ .as_ref stmt.trailing
  .push '\n' out
  ()
