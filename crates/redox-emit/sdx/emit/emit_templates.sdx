import crate::emit::expanded_template::expanded_template
import crate::emit::pad::pad
import crate::emit::sink::Sink
import crate::emit::template_scope::TemplateScope
import redox_ast::{DataDecl, Ident}

-- | Every `deriving` template `d` names, emitted below it — plan 89.
-- |
-- | One `impl` per template, in the order the `deriving` list wrote them, each
-- | preceded by a **provenance comment** naming the template it came from.
-- |
-- | # The comment is the row's answer to its own disclosure cost
-- |
-- | Plan 89 §1.4 concedes that discoverability is worse here than with
-- | `#[derive]`: `Debug` is standard and `Forward` is one file's invention, so a
-- | reader meeting the generated `impl` has no way to know where it came from.
-- | Comments are trivia that reach the `.xrs` (doc 02 §10.1), and the `.xrs` is
-- | the artifact a person reads and steps through — so it says so itself.
-- |
-- | A comment rather than a `#[doc]` attribute, per §9 decision 5: an attribute
-- | would be API the author did not write, which is the objection doc 03 §8.7
-- | raises against default arguments.
export(crate) emit_templates : &mut Sink<'_> -> &[Ident] -> &DataDecl -> usize -> ()
emit_templates out named d indent =
  for name in named
    -- `lookup` cannot fail here: `emit_data` filtered this list by the same
    -- lookup. Written as a `guard` rather than an unwrap so a future caller
    -- that does not filter degrades to emitting nothing instead of panicking.
    guard TemplateScope::lookup (.as_str name.text) is Some template else
      continue
    -- The generated `impl` has no `.sdx` line of its own — no line of the
    -- author's `deriving` list corresponds to any line of it — so the span map
    -- is closed before it rather than pointing somewhere misleading.
    .unmark out
    .push_str "\n" out
    pad out indent
    .push_str (&format! \-> "// Derived by `deriving template #{name.text}`.\n") out
    .push_str (&expanded_template (&template) d indent) out
  ()
