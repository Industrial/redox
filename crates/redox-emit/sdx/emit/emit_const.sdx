import crate::emit::expr::emit_expr
import crate::emit::pad::pad
import crate::emit::sink::Sink
import crate::emit::trivia::emit_trivia
import redox_ast::ConstDecl

-- | Emit doc 03 §13.4's module-scope `const` or `static`, at `indent` spaces.
-- |
-- | ```text
-- | const MAX : usize = 1024      const MAX: usize = 1024;
-- | static COUNT : u32 = 0    →   static COUNT: u32 = 0;
-- | ```
-- |
-- | One keyword apart, which is why one node carries both.
export(crate) emit_const : &mut Sink<'_> -> &ConstDecl -> usize -> ()
emit_const out c indent =
  .unmark out
  emit_trivia out (&c.leading) indent
  .mark c.span out
  pad out indent
  keyword = if c.is_static
    "static"
  else
    "const"
  vis = .rust_text c.visibility
  value = emit_expr (&c.value) indent
  .push_str (&format! \-> "#{vis}#{keyword} #{c.name.text}: #{c.ty.text} = #{value};\n") out
  ()
