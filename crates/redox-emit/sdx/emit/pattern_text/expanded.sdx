import crate::emit::pattern_text::rebuilt::rebuilt
import crate::emit::pattern_text::substituted::substituted
import crate::emit::synonym_scope::SynonymScope
import redox_ast::Pattern

-- | `pattern` with plan 87's synonyms substituted, recursively.
-- |
-- | # Depth is capped, and the cap is a constant rather than a cycle detector
-- |
-- | A synonym whose body uses another synonym expands recursively, so a cycle
-- | is a non-terminating expansion. Plan 61 §10.4 is the precedent for taking
-- | a number instead of building an analysis: that row had to decide *"where
-- | 'together' is"* for a `where` group and chose one.
-- |
-- | Sixteen is far past anything a reader would write and far below anything
-- | that costs time. Past it the pattern is rendered **unexpanded**, and rustc
-- | then reports the constructor it does not know — which is the right failure
-- | for a cycle, because the alternative is a compiler that does not finish.
export(crate) expanded : &Pattern -> usize -> Pattern
expanded pattern depth =
  if depth >= 16
    return .clone pattern
  case pattern of
    -- A bare upper-case name. `pattern_app` keeps a bare constructor as a
    -- `Binding` carrying the whole path — plan 81 §2.4 recorded that — so the
    -- nullary form arrives here and not as an `Apply` with no arguments.
    Pattern::Binding name ->
      guard SynonymScope::lookup (&name.text) is Some decl else
        return .clone pattern
      if !.is_empty decl.params
        return .clone pattern
      expanded (&decl.body) (depth + 1)
    -- The parameterised form. The arguments replace the formal parameters
    -- positionally, so every binder in the result was written at the use site.
    Pattern::Apply { path, args, .. } ->
      guard SynonymScope::lookup path is Some decl else
        return rebuilt pattern depth
      if .len decl.params != .len args
        -- An arity mismatch is left alone. The unexpanded name is not a Rust
        -- constructor either, so rustc reports it — and a Redox diagnostic
        -- here would have to be sure the name is a synonym rather than a real
        -- constructor of the same spelling, which is name resolution.
        return rebuilt pattern depth
      mut body = .clone decl.body
      for pair in .enumerate (.iter decl.params)
        body := substituted (&body) (&pair.1.text) (&args[pair.0])
      expanded (&body) (depth + 1)
    _ -> rebuilt pattern depth
