export(crate) module emit_where_locals
-- | Split an error variant's message into a format string and its arguments.
export(crate) module error_message
-- | Emit an `errors` declaration: the enum, `Display`, `Error`, and its `From` rows.
export(crate) module r#errors
-- | Render an expression as Rust.
export(crate) module expr
-- | A comma-separated argument list.
export(crate) module expr_list
-- | A `deriving` template's `instance`, with its placeholders filled.
export(crate) module expanded_template
-- | Emit an `extern` block.
export(crate) module extern_block
-- | The argument positions holding an application hole, `_`.
