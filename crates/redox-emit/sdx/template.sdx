import redox_ast::DeriveTemplate
import redox_ast::Item
import std::cell::RefCell

rust """
  thread_local! {
    /// The template table in scope, empty outside a [`TemplateScope`].
    ///
    /// Empty is the safe default: a name no table knows is left in the
    /// `#[derive(…)]` list exactly as the author wrote it, which is what doc 03
    /// §9.5 already does with an unknown derive.
    static IN_SCOPE: RefCell<TemplateTable> = RefCell::new(TemplateTable::default());
  }
"""

export(crate) data TemplateScope = TemplateScope {
  previous : TemplateTable,
}

instance TemplateScope
  export(crate) enter : TemplateTable -> Self
  enter table =
    previous = .with_borrow_mut (\slot -> std::mem::replace slot table) IN_SCOPE
    TemplateScope { previous }

  export(crate) lookup : &str -> Option<redox_ast::DeriveTemplate>
  lookup name = .with_borrow (\table -> .get name table) IN_SCOPE

instance Drop TemplateScope
  drop : &mut self -> ()
  drop self =
    restored = std::mem::take $ &mut self.previous
    _dropped = .with_borrow_mut (\slot -> std::mem::replace slot restored) IN_SCOPE
    ()

export(crate) data TemplateTable = TemplateTable {
  by_name : std::collections::BTreeMap<String, DeriveTemplate>,
}
  deriving (Debug, Clone, Default)

instance TemplateTable
  export(crate) from_items : &[Item] -> Self
  from_items items =
    mut by_name = std::collections::BTreeMap::new ()
    for item in items
      if item is Item::DeriveTemplate decl
        .insert (.clone decl.name.text) (.clone decl) by_name
    TemplateTable { by_name }

  export(crate) get : &str -> &self -> Option<DeriveTemplate>
  get name self = self.by_name |> .get name |> .cloned
