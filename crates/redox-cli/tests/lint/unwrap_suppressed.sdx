-- The same program as `unwrap_warning.sdx`, suppressed — plan 38 §1.3.
--
-- Its expectation is **empty**, which is the only way to prove suppression
-- works: a corpus entry that asserts nothing is printed.
--
-- The marker is a comment rather than an attribute. `#[allow(unwrap)]` passed
-- through makes rustc say `unknown lint`, so suppressing a Redox lint would
-- stop the program compiling; consumed instead, plan 18 §1.3's
-- attributes-are-trivia rule becomes conditional for one spelling. A comment
-- reaches the `.xrs` as `//` and means nothing to rustc.
main :: ()
main =
  raw = Some 7
  port = raw.unwrap ()  -- redox: allow unwrap
  print port
