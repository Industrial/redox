import crate::build_command::build_command
import crate::check_command::check_command
import crate::fmt_command::fmt_command
import crate::run::commands::lookup::lookup
import crate::run::usage::usage
import crate::watch_command::watch_command

export(crate) module command
export(crate) module commands
export(crate) module usage

-- | Dispatch one invocation. Returns the message to print on failure.
-- |
-- | Plan 11 (`docs/16 - 11 - CLI Surface.md`) leaf 3. The surface comes from
-- | `COMMANDS`, which the usage text and `cli_surface.rs` also read, so the
-- | three cannot disagree about what Redox accepts (§2.1).
-- |
-- | Three outcomes for an argument, and keeping them distinct is the point of
-- | §1.2: a command that runs, a command doc 01 §27 declares but a later plan
-- | implements, and a word Redox does not know.
export(crate) run : &[String] -> Result<(), String>
run args =
  guard .map String::as_str (.first args) is Some first else
    help = usage ()
    print! \-> "#{help}"
    return Ok ()

  guard lookup first is Some command else
    help = usage ()
    return Err (format! \-> "error: unknown command `#{first}`\n\n#{help}")

  -- A declared command whose plan has not landed says so, and names the plan.
  if .not_yet command is Some message
    return Err message

  -- `args[1 .. n]` with `n` bound first, where the Rust wrote `&args[1..]`.
  -- An **open-ended range has no spelling** — plan 68's gap, third sighting.
  n = .len args
  rest = &args[1 .. n]

  case command.name of
    "--help" ->
      help = usage ()
      print! \-> "#{help}"
      Ok ()
    "--version" ->
      version = env! \-> "CARGO_PKG_VERSION"
      println! \-> "redox #{version}"
      Ok ()
    "build" -> build_command rest
    "check" -> check_command rest
    "fmt" -> fmt_command rest
    "watch" -> watch_command rest
    other ->
      unreachable! \-> "`#{other}` is Ready in COMMANDS but has no dispatch arm"
