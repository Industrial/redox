import crate::fmt_command::fmt_args::FmtArgs
import crate::run::usage::usage
import std::path::PathBuf

-- | Resolve `fmt`'s arguments into a [`FmtArgs`] — plan 34, leaf 1.
-- |
-- | Unlike `build`, several inputs are accepted and required: `fmt` with no file
-- | is a no-op that looks like success, and plan 34 §1.5's gate is
-- | `redox fmt --check examples/*.sdx`.
export(crate) parse_fmt_args : &[String] -> Result<FmtArgs, String>
parse_fmt_args args =
  mut inputs = Vec::new ()
  mut check = false
  mut plain = false

  for arg in args
    case .as_str arg of
      "--check" -> check := true
      "--plain" -> plain := true
      flag | .starts_with '-' flag ->
        help = usage ()
        return Err (format! \-> "error: unknown flag `#{flag}`\n\n#{help}")
      path -> inputs |> .push (PathBuf::from path)

  if .is_empty inputs
    help = usage ()
    return Err (format! \-> "error: fmt needs at least one .sdx\n\n#{help}")

  Ok (FmtArgs { inputs, check, plain })
