import crate::diagnostic::Diagnostic
import crate::diagnostic::diagnostic_from_voltaic
import voltaic_driver::diagnose

export build : &BuildRequest -> Result<BuildResponse, String>
build request =
  path = std::path::Path::new (&request.path)
  shown = .clone request.path
  source = (.map_err (\e -> format! \-> "cannot read #{shown}: #{e}") (std::fs::read_to_string path))?

  program = case voltaic_parser::parse_source (&source) of
    Ok parsed -> parsed
    Err failure ->
      return Ok (BuildResponse { ok = false, output = None, map = None, diagnostics = diagnose path (&source) (&failure)
        |> .iter
        |> .map diagnostic_from_voltaic
        |> .collect })

  diagnostics = voltaic_driver::lint path (&source) (Some (&program))
  emitted = voltaic_emit::emit_with_map (&program) (&source) (&request.path)
  generated = emitted.0
  map = emitted.1

  output = .with_extension "xrs" path
  out_shown = output |> .display |> .to_string
  (.map_err (\e -> format! \-> "cannot write #{out_shown}: #{e}") (std::fs::write (&output) (&generated)))?

  mut map_name = .to_os_string (.expect "a name" (.file_name output))
  .push ".map" map_name
  map_path = .with_file_name map_name output
  map_shown = map_path |> .display |> .to_string
  (.map_err (\e -> format! \-> "cannot write #{map_shown}: #{e}") (std::fs::write (&map_path) (voltaic_diag::render_map (&map))))?

  Ok (BuildResponse { ok = true, output = Some out_shown, map = Some map_shown, diagnostics = diagnostics
    |> .iter
    |> .map diagnostic_from_voltaic
    |> .collect })

export data BuildRequest = BuildRequest { export path : String }
  deriving (Debug, Clone, serde::Deserialize, schemars::JsonSchema)

export data BuildResponse = BuildResponse {
  export ok : bool,
  #[serde(skip_serializing_if = "Option::is_none")]
  export output : Option<String>,
  #[serde(skip_serializing_if = "Option::is_none")]
  export map : Option<String>,
  export diagnostics : Vec<Diagnostic>,
}
  deriving (Debug, Clone, serde::Serialize, schemars::JsonSchema)

export check : &CheckRequest -> Result<CheckResponse, String>
check request =
  path = std::path::Path::new (&request.path)
  shown = .clone request.path
  source = (.map_err (\e -> format! \-> "cannot read #{shown}: #{e}") (std::fs::read_to_string path))?

  outcome = (voltaic_driver::check path (&source))?
  Ok (CheckResponse { ok = !outcome.failed, diagnostics = outcome.diagnostics
    |> .iter
    |> .map diagnostic_from_voltaic
    |> .collect })

export data CheckRequest = CheckRequest { export path : String }
  deriving (Debug, Clone, serde::Deserialize, schemars::JsonSchema)

export data CheckResponse = CheckResponse { export ok : bool, export diagnostics : Vec<Diagnostic> }
  deriving (Debug, Clone, serde::Serialize, schemars::JsonSchema)

export format : &FormatRequest -> Result<FormatResponse, String>
format request =
  path = std::path::Path::new (&request.path)
  shown = .clone request.path
  source = (.map_err (\e -> format! \-> "cannot read #{shown}: #{e}") (std::fs::read_to_string path))?

  program = case voltaic_parser::parse_source (&source) of
    Ok parsed -> parsed
    Err failure ->
      return Ok (FormatResponse { ok = false, formatted = None, changed = false, diagnostics = diagnose path (&source) (&failure)
        |> .iter
        |> .map diagnostic_from_voltaic
        |> .collect })

  formatted = voltaic_fmt::format (&program) (&source)
  Ok (FormatResponse { ok = true, changed = formatted != source, formatted = Some formatted, diagnostics = Vec::new () })

export data FormatRequest = FormatRequest { export path : String }
  deriving (Debug, Clone, serde::Deserialize, schemars::JsonSchema)

export data FormatResponse = FormatResponse {
  export ok : bool,
  #[serde(skip_serializing_if = "Option::is_none")]
  export formatted : Option<String>,
  export changed : bool,
  export diagnostics : Vec<Diagnostic>,
}
  deriving (Debug, Clone, serde::Serialize, schemars::JsonSchema)

export source_map : &SourceMapRequest -> Result<SourceMapResponse, String>
source_map request =
  xrs = std::path::Path::new (&request.path)
  shown = .clone request.path
  is_map = .is_some_and (\e -> e == "map") (.extension xrs)
  map_path = if is_map
    .to_path_buf xrs
  else
    named = .ok_or_else (\-> format! \-> "#{shown} names no file") (.file_name xrs)
    mut name = .to_os_string named?
    .push ".map" name
    .with_file_name name xrs

  map_shown = map_path |> .display |> .to_string
  source_text = .map_err (\e -> format! \-> "cannot read #{map_shown}: #{e}. `voltaic_build` writes it beside the .xrs") (std::fs::read_to_string (&map_path))
  map = (.map_err (\e -> format! \-> "#{map_shown} is not a source map: #{e}") (voltaic_diag::parse_map (&source_text?)))?

  column = .unwrap_or 1 request.column
  case .resolve request.line column map of
    Some at ->
      Ok (SourceMapResponse { source = Some (.clone map.source_path), line = Some at.0, column = Some at.1, reason = None })
    None ->
      reason = if request.line == 0 || request.line > .len map
        "out-of-range: the .xrs has no such line"
      else
        "synthetic: Voltaic emitted this line and no .sdx line is behind it"
      Ok (SourceMapResponse { source = Some (.clone map.source_path), line = None, column = None, reason = Some (.to_string reason) })

export data SourceMapRequest = SourceMapRequest {
  export path : String,
  export line : usize,
  #[serde(default)]
  export column : Option<usize>,
}
  deriving (Debug, Clone, serde::Deserialize, schemars::JsonSchema)

export data SourceMapResponse = SourceMapResponse {
  #[serde(skip_serializing_if = "Option::is_none")]
  export source : Option<String>,
  #[serde(skip_serializing_if = "Option::is_none")]
  export line : Option<usize>,
  #[serde(skip_serializing_if = "Option::is_none")]
  export column : Option<usize>,
  #[serde(skip_serializing_if = "Option::is_none")]
  export reason : Option<String>,
}
  deriving (Debug, Clone, serde::Serialize, schemars::JsonSchema)
