import crate::code::DiagnosticCode
import crate::source::Span
import std::error::Error
import std::fmt::Display
import std::fmt::Formatter
import std::fmt::Result

export data Severity
  #[default]
  = Error
  | Warning
  deriving (Debug, Clone, Copy, PartialEq, Eq, Default)

instance Severity
  export is_fatal : self -> bool
  is_fatal self =
    case self of
      Severity::Error -> true
      _ -> false

  export to_miette : self -> miette::Severity
  to_miette self =
    case self of
      Severity::Error -> miette::Severity::Error
      Severity::Warning -> miette::Severity::Warning

export data Diagnostic
  = Diagnostic {
    export code : DiagnosticCode,
    export severity : Severity,
    export message : String,
    export span : Span,
    export help : Option<String>,
    export path : String,
    export source : String,
  }
  deriving (Debug, Clone)

instance Display Diagnostic
  fmt : &self -> &mut Formatter<'_> -> Result
  fmt self f =
    write! \-> f \-> "#{self.message}"

instance Error Diagnostic
