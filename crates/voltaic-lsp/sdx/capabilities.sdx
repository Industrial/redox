import lsp_types::FoldingRangeProviderCapability
import lsp_types::HoverProviderCapability
import lsp_types::OneOf
import lsp_types::SemanticTokenType
import lsp_types::SemanticTokensFullOptions
import lsp_types::SemanticTokensLegend
import lsp_types::SemanticTokensOptions
import lsp_types::SemanticTokensServerCapabilities
import lsp_types::ServerCapabilities
import lsp_types::TextDocumentSyncCapability
import lsp_types::TextDocumentSyncKind
import lsp_types::WorkDoneProgressOptions

export capabilities : ServerCapabilities
capabilities =
  base = ServerCapabilities::default ()
  base { text_document_sync = Some (TextDocumentSyncCapability::Kind TextDocumentSyncKind::FULL), document_symbol_provider = Some (OneOf::Left true), document_formatting_provider = Some (OneOf::Left true), hover_provider = Some (HoverProviderCapability::Simple true), definition_provider = Some (OneOf::Left true), folding_range_provider = Some (FoldingRangeProviderCapability::Simple true), semantic_tokens_provider = Some (SemanticTokensServerCapabilities::SemanticTokensOptions (SemanticTokensOptions { work_done_progress_options = WorkDoneProgressOptions::default (), legend = SemanticTokensLegend { token_types = token_types (), token_modifiers = Vec::new () }, range = None, full = Some (SemanticTokensFullOptions::Bool true) })) }

export(crate) token_types : Vec<SemanticTokenType>
token_types = vec! \-> SemanticTokenType::KEYWORD \-> SemanticTokenType::TYPE \-> SemanticTokenType::FUNCTION \-> SemanticTokenType::VARIABLE \-> SemanticTokenType::NUMBER \-> SemanticTokenType::STRING \-> SemanticTokenType::OPERATOR \-> SemanticTokenType::COMMENT
