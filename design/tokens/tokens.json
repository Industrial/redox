{
	"identity": "The Pile",
	"plan": ".cursor/plans/voltaic-identity-and-site.plan.md",
	"note": "The single palette definition. design/build.sh emits every SVG master, tokens.css and tokens.toml from this file plus design/geometry/pile.json; design/themes.sh emits the five editor themes from the roles and the syntax block. A hex that appears nowhere here appears nowhere at all, and crates/voltaic-cli/tests/design.rs enforces that.",
	"roles": {
		"copper": {
			"light": "#A85C32",
			"dark": "#D98B5A",
			"of": "the pile's anode plate"
		},
		"zinc": {
			"light": "#8A99A3",
			"dark": "#AEBEC8",
			"of": "the pile's cathode plate. The mark only — at 2.93:1 on white it is not a text colour, which the wave 10 contrast audit established."
		},
		"ink": {
			"light": "#11181D",
			"dark": "#E7EFF3",
			"of": "body text, and the single-colour cut"
		},
		"ink-2": {
			"light": "#3C4A52",
			"dark": "#C2D0D8",
			"of": "secondary text"
		},
		"ink-mute": {
			"light": "#5F6F79",
			"dark": "#8CA0AB",
			"of": "captions and metadata"
		},
		"ink-faint": {
			"light": "#63737D",
			"dark": "#7D8D98",
			"of": "line numbers, punctuation, the quietest text"
		},
		"ground": {
			"light": "#FFFFFF",
			"dark": "#141C21",
			"of": "page and tile ground"
		},
		"ground-2": {
			"light": "#F4F7F8",
			"dark": "#1B252B",
			"of": "raised surfaces, code blocks"
		},
		"rule": {
			"light": "#C9D3D8",
			"dark": "#27333B",
			"of": "hairlines and borders"
		},
		"arc": {
			"light": "#0D6E85",
			"dark": "#3FB9CE",
			"of": "links and interactive state"
		}
	},
	"mark": {
		"m1": "copper",
		"m2": "zinc",
		"mono": "ink"
	},
	"type": {
		"display": "Archivo",
		"body": "Spectral",
		"mono": "IBM Plex Mono"
	},
	"syntax": {
		"keyword": {
			"role": "copper",
			"bold": true,
			"scope": "keyword",
			"nvim": "keyword",
			"vim": "Keyword"
		},
		"type": {
			"role": "arc",
			"scope": "entity.name.type",
			"nvim": "type",
			"vim": "Type"
		},
		"function": {
			"role": "ink",
			"scope": "entity.name.function",
			"nvim": "function",
			"vim": "Function"
		},
		"constant": {
			"role": "copper",
			"scope": "constant.language",
			"nvim": "constant",
			"vim": "Constant"
		},
		"string": {
			"role": "ink-2",
			"scope": "string",
			"nvim": "string",
			"vim": "String"
		},
		"number": {
			"role": "arc",
			"scope": "constant.numeric",
			"nvim": "number",
			"vim": "Number"
		},
		"comment": {
			"role": "ink-mute",
			"italic": true,
			"scope": "comment",
			"nvim": "comment",
			"vim": "Comment"
		},
		"operator": {
			"role": "ink-faint",
			"scope": "keyword.operator",
			"nvim": "operator",
			"vim": "Operator"
		},
		"variable": {
			"role": "ink",
			"scope": "variable",
			"nvim": "variable",
			"vim": "Identifier"
		},
		"punctuation": {
			"role": "ink-faint",
			"scope": "punctuation",
			"nvim": "punctuation.delimiter",
			"vim": "Delimiter"
		}
	}
}
