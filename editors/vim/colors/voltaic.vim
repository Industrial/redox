" Voltaic for Vim. Generated by design/themes.sh - do not edit.
"
" :colorscheme voltaic
"
" 24-bit only. Vim has no equivalent of the token palette at 16 colours,
" and approximating it would be inventing colours the identity does not
" have - so this requires termguicolors and says so rather than degrading.

if !has("termguicolors")
  echohl WarningMsg
  echom "voltaic: needs termguicolors (set termguicolors)"
  echohl None
  finish
endif

hi clear
if exists("syntax_on") | syntax reset | endif
let g:colors_name = "voltaic"

if &background ==# "light"
  let s:copper = "#A85C32"
  let s:zinc = "#8A99A3"
  let s:ink = "#11181D"
  let s:ink_2 = "#3C4A52"
  let s:ink_mute = "#5F6F79"
  let s:ink_faint = "#63737D"
  let s:ground = "#FFFFFF"
  let s:ground_2 = "#F4F7F8"
  let s:rule = "#C9D3D8"
  let s:arc = "#0D6E85"
else
  let s:copper = "#D98B5A"
  let s:zinc = "#AEBEC8"
  let s:ink = "#E7EFF3"
  let s:ink_2 = "#C2D0D8"
  let s:ink_mute = "#8CA0AB"
  let s:ink_faint = "#7D8D98"
  let s:ground = "#141C21"
  let s:ground_2 = "#1B252B"
  let s:rule = "#27333B"
  let s:arc = "#3FB9CE"
endif

exe "hi Normal guifg=" . s:ink . " guibg=" . s:ground
exe "hi LineNr guifg=" . s:ink_faint
exe "hi CursorLineNr guifg=" . s:copper . " gui=bold"
exe "hi VertSplit guifg=" . s:rule
exe "hi Visual guibg=" . s:ground_2
exe "hi Pmenu guifg=" . s:ink . " guibg=" . s:ground_2

exe "hi Keyword guifg=" . s:copper . " gui=bold"
exe "hi Type guifg=" . s:arc
exe "hi Function guifg=" . s:ink
exe "hi Constant guifg=" . s:copper
exe "hi String guifg=" . s:ink_2
exe "hi Number guifg=" . s:arc
exe "hi Comment guifg=" . s:ink_mute . " gui=italic"
exe "hi Operator guifg=" . s:ink_faint
exe "hi Identifier guifg=" . s:ink
exe "hi Delimiter guifg=" . s:ink_faint
