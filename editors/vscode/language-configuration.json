{
	"comments": {
		"lineComment": "--"
	},
	"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] }
	],
	"surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
	"indentationRules": {
		"increaseIndentPattern": "(=|->|=>|\\bdo\\b|\\bwhere\\b|\\bof\\b|\\bthen\\b|\\belse\\b)\\s*$",
		"decreaseIndentPattern": "^\\s*$"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*--\\s*[|!]",
			"action": { "indent": "none", "appendText": "-- | " }
		}
	]
}
