{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Redox",
	"scopeName": "source.redox",
	"comment": "Plan 49 leaf 3. TextMate highlighting so a cold open is coloured before redox-lsp has started. The keyword list is checked against tree-sitter-redox/grammar.js by crates/redox-cli/tests/editors.rs, so it cannot drift from the tree-sitter and Vim highlighters.",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#verbatim" },
		{ "include": "#string" },
		{ "include": "#char" },
		{ "include": "#number" },
		{ "include": "#keyword" },
		{ "include": "#constant" },
		{ "include": "#attribute" },
		{ "include": "#type" },
		{ "include": "#operator" }
	],
	"repository": {
		"comment": {
			"patterns": [
				{
					"name": "comment.block.documentation.redox",
					"match": "--\\s*[|!].*$"
				},
				{
					"name": "comment.line.double-dash.redox",
					"match": "--(?!\\s*[|!]).*$"
				}
			]
		},
		"verbatim": {
			"comment": "Redox's triple-quoted block — plan 23's raw strings and plan 45's inline Rust. Matched before #string, or the opening quotes read as an empty string.",
			"name": "string.quoted.triple.redox",
			"begin": "\"\"\"",
			"end": "\"\"\""
		},
		"string": {
			"name": "string.quoted.double.redox",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{ "name": "constant.character.escape.redox", "match": "\\\\." }
			]
		},
		"char": {
			"name": "string.quoted.single.redox",
			"match": "'([^'\\\\]|\\\\.)'"
		},
		"number": {
			"patterns": [
				{
					"name": "constant.numeric.hex.redox",
					"match": "\\b0[xX][0-9a-fA-F_]+\\b"
				},
				{
					"name": "constant.numeric.binary.redox",
					"match": "\\b0[bB][01_]+\\b"
				},
				{
					"name": "constant.numeric.octal.redox",
					"match": "\\b0[oO][0-7_]+\\b"
				},
				{
					"name": "constant.numeric.decimal.redox",
					"match": "\\b\\d[0-9_]*(\\.\\d[0-9_]*)?([eE][-+]?\\d+)?(_?[iuf](8|16|32|64|128|size))?\\b"
				}
			]
		},
		"keyword": {
			"comment": "One list, three highlighters. `export` is a visibility and is matched with its optional modifier.",
			"patterns": [
				{
					"name": "storage.modifier.redox",
					"match": "\\bexport(\\((crate|super|in [A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*)\\))?"
				},
				{
					"name": "keyword.control.redox",
					"match": "\\b(import|module|data|newtype|type|class|instance|errors|test|const|static|deriving|from|as|where|otherwise|if|then|else|while|until|for|in|loop|break|continue|return|assert|guard|with|case|of|do|async|try|catch|mut|move|or|rust|unsafe|extern|union)\\b"
				}
			]
		},
		"constant": {
			"patterns": [
				{
					"name": "constant.language.boolean.redox",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "variable.language.self.redox",
					"match": "\\b(self|Self)\\b"
				},
				{
					"name": "entity.name.label.redox",
					"match": "'[a-z_][a-zA-Z0-9_]*\\b(?!')"
				}
			]
		},
		"attribute": {
			"name": "meta.attribute.redox",
			"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
		},
		"type": {
			"comment": "Redox has no type checker, so a grammar certainly cannot tell a type from a constructor. Both are UpperCamel and both are coloured as a type, which is honest rather than a heuristic that is sometimes wrong.",
			"name": "entity.name.type.redox",
			"match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
		},
		"operator": {
			"patterns": [
				{ "name": "keyword.operator.ascription.redox", "match": "::" },
				{
					"name": "keyword.operator.redox",
					"match": "->|=>|\\\\|\\?\\?|\\?\\.|<\\||\\|>|<<|>>|[-+*/%<>=!&|^~]"
				}
			]
		}
	}
}
