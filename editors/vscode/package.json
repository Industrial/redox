{
	"name": "voltaic",
	"displayName": "Voltaic",
	"description": "Voltaic language support — highlighting, diagnostics and formatting via voltaic-lsp.",
	"publisher": "voltaic-lang",
	"version": "0.1.0",
	"license": "MIT",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages",
		"Formatters",
		"Linters"
	],
	"main": "./src/extension.js",
	"activationEvents": [
		"onLanguage:voltaic"
	],
	"contributes": {
		"languages": [
			{
				"id": "voltaic",
				"aliases": [
					"Voltaic",
					"voltaic"
				],
				"extensions": [
					".sdx"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "voltaic",
				"scopeName": "source.voltaic",
				"path": "./syntaxes/voltaic.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Voltaic",
			"properties": {
				"voltaic.server.path": {
					"type": "string",
					"default": "voltaic-lsp",
					"description": "Path to the voltaic-lsp binary."
				},
				"voltaic.server.enable": {
					"type": "boolean",
					"default": true,
					"description": "Start voltaic-lsp for .sdx files. Turn this off to keep TextMate highlighting only."
				}
			}
		}
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	}
}
