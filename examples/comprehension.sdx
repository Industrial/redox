-- Doc 18 §3.2's comprehension and the list literal it shares its brackets
-- with, checked by running the generated Rust: a guard applied to the wrong
-- binder, or a generator nested the wrong way round, prints the wrong count.

main :: ()
main =
  -- A list literal is Rust's array literal, unchanged.
  xs = [1, 2, 3, 4]
  print (xs.len ())

  -- An ascribed list literal is doc 18 §6's third lowering: the container is
  -- named in the ascription, so the value is `C::from([…])`.
  owned = [1, 2, 3] :: Vec<i32>
  print (owned.len ())

  -- One generator. `collect` carries no turbofish, so the type comes from the
  -- ascription — which is §3.2's own spelling.
  doubled = [ n * 2 | n <- xs ] :: Vec<i32>
  print (doubled.iter () |> sum :: i32)

  -- A guard. `filter_map` hands the closure the *value*, so the guard reads
  -- as written — §3.2's own lowering uses `filter`, whose closure receives a
  -- reference and so needs a `*` Redox cannot know to insert.
  odd = [ n | n <- xs, n % 2 == 1 ] :: Vec<i32>
  print (odd.len ())

  -- Two generators and a guard, which is §3.2's own example. The source is a
  -- range, so the receiver needs its parentheses: `1..3.into_iter()` would
  -- be `1..(3.into_iter())`.
  pairs = [ x * y | x <- 1 .. 4, y <- 1 .. 4, x != y ] :: Vec<i32>
  print (pairs.len ())

  -- A set, which is the whole of what doc 03's deleted set literal did.
  seen = [ c | c <- xs ] :: std::collections::HashSet<i32>
  print (seen.len ())
