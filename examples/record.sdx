-- Doc 18 §2.4's record literal: construction, punning and update, checked by
-- running the generated Rust — an update lowered to the wrong order prints
-- the wrong number.

data Point = Point { x : i32, y : i32 }
  deriving (Debug, Clone, PartialEq)

main : ()
main =
  -- Construction. `=` for a value, against `::` for a type.
  p = Point { x = 10, y = 20 }
  println! \-> "#{p.x}"
  println! \-> "#{p.y}"

  -- Punning, in the direction Haskell had it first.
  x = 1
  y = 2
  q = Point { x, y }
  println! \-> "#{q.x}"
  println! \-> "#{q.y}"

  -- Update. One of doc 18 §6's disclosed lowerings: a block, because Rust's
  -- own `Point { x: 99, ..p }` needs the type's path and the source gives
  -- only the value's name.
  r = p { x = 99 }
  println! \-> "#{r.x}"
  println! \-> "#{r.y}"
  ()
