-- Doc 18 §6's ascription, and §5.2's spaced-versus-tight `::` rule, in the
-- example corpus — which is where plan 04's "the output is already
-- rustfmt-clean" guarantee is actually measured. The lowering spans three
-- lines, and until this file existed nothing checked that it spanned them at
-- the right column.

main :: ()
main =
  -- `e :: T` states a type without naming a path.
  n = 1 :: u64
  print n
  -- Ascription is the loosest thing in an expression: the sum is ascribed,
  -- not the `2`.
  total = 1 + 2 :: u64
  print total
  -- A tight `::` is still a path, which is the half that would break every
  -- existing program if it went wrong.
  print (i32::max 1 9)
  -- A generic type survives verbatim — doc 03 §14.1 — and the value is an
  -- application, because `Some 1` is juxtaposition like everything else.
  wide = Some 1 :: Option<u8>
  -- `wide` is `Some` by construction two lines up, so the panic is
  -- unreachable — doc 03 §12.7's lint is suppressed per line rather than
  -- argued with.
  print (wide.unwrap ())  -- redox: allow unwrap
  -- A multi-line lowering as a macro argument: `println!` keeps the call on
  -- one line and lets the block hang, which is the form rustfmt writes.
  print (1 + 1 :: u64)
