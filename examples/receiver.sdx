-- Doc 18 §2.5's **marked** receiver — plan 67. `self` in a type is the
-- receiver, wherever in the signature it is written, and the borrow prefix on
-- the marker chooses between Rust's three forms.
--
-- `examples/class.sdx` is the ordinary shape: one class, one argument per
-- method. This file is the three shapes the corpus never had, each of which
-- the old positional rule either could not express or expressed wrongly —
-- plan 67 §1.3 counted the gap.

import std::fmt::Debug

newtype Meters = Meters f64

data Counter = Counter { value : u32 }
  deriving (Debug)

-- A superclass survives the class losing its variable: `=>` before the name,
-- and nothing after it. A bound on a trait *parameter* is a different row —
-- plan 67 §6.
class Debug => Tally
  -- All three receivers, from the prefix on the marker and nothing else.
  current : &self -> u32
  bump : &mut self -> ()
  total : self -> u32
  -- Two arguments with the receiver **first**, which is Rust's order.
  plus : &self -> u32 -> u32
  -- Two arguments with the receiver **last**, which is the order plan 57's
  -- call reads: `.minus 1 c`. Both emit `fn …(&self, n: u32) -> u32`, so
  -- position carries no meaning and an author writes whichever reads better.
  minus : u32 -> &self -> u32
  -- No `self` in any type, so no receiver at all: an associated function,
  -- reached through the type rather than through a value.
  start : u32 -> Self
  -- A body that **applies** something to `self`, which is the one position
  -- plan 68 found unreachable: `starts_argument` listed every token that can
  -- begin a juxtaposed argument and `self` was not among them, so
  -- `.to_string self.label` stopped the application after `.to_string` and
  -- left `self.label` a stray expression. Every other `self` in this file is
  -- a whole body or an operand, which is why nothing caught it until a crate
  -- full of methods was ported.
  label : &self -> String

instance Tally Counter
  current : &self -> u32
  current self = self.value
  bump : &mut self -> ()
  bump self =
    self.value += 1
    ()
  total : self -> u32
  total self = self.value
  plus : &self -> u32 -> u32
  plus self n = self.value + n
  minus : u32 -> &self -> u32
  minus n self = self.value - n
  start : u32 -> Self
  start n = Counter { value = n }
  label : &self -> String
  label self = .to_string self.value

-- A class with a parameter of its own, which is `trait From<T>`'s shape and
-- was unreachable until plan 67: the one slot a class head had was spent on
-- the implementing type, so a second lowercase name became a *method* generic
-- and rustc answered `E0049`. The implementing type is `Self`, so the slot is
-- free and the names in it are the trait's.
class Scale t
  times : &self -> t -> f64

-- Two impls for one type, differing only in the argument — the shape §1.4
-- measured as impossible. The **last** name in the head is the implementing
-- type, so this reads in the same order as the `impl Scale<f64> for Meters`
-- it becomes.
instance Scale f64 Meters
  times : &self -> f64 -> f64
  times self k = self.0 * k

instance Scale u32 Meters
  times : &self -> u32 -> f64
  times self k = self.0 * f64::from k

main : ()
main =
  -- The associated function, through the type.
  mut c = Counter::start 3
  println! \-> "#{(.current c)}"
  .bump c
  println! \-> "#{(.current c)}"
  println! \-> "#{(.plus 10 c)}"
  println! \-> "#{(.minus 1 c)}"
  -- `total : self -> u32` takes the receiver by value, so this is `c`'s last
  -- use and rustc is the one that knows it.
  println! \-> "#{(.label (&c))}"
  println! \-> "#{(.total c)}"
  m = Meters 4.0
  -- Which `Scale` impl applies is chosen by the argument's type, which is
  -- rustc's job and not Voltaic's — the ascription is what fixes it here.
  wide = 1.5 : f64
  println! \-> "#{(.times wide m)}"
  narrow = 2 : u32
  println! \-> "#{(.times narrow m)}"
  ()
