### A fenced comment,
    spanning lines. ###

## Outer doc comment.
main = ->
  # A line comment, then every literal kind.
  count = 1_000_000
  hexed = 0xDEAD_beef
  ratio = 2.5e-3
  ch = 'x'
  byte = b'\n'
  raw = r#"no \escapes here"#
  cstr = c"nul terminated"
  words = %w[get post put]
  set = #{1, 2, 3}
  greeting = "hi #{name}, you owe #{amount:.2}"
  block = """
    indented
      relative
  """
  chain = items |> map (+1) |> filter (> 0)
  maybe = lookup id ?? "none"
  guarded = parse s catch 0
  spread = [0, ...rest, 9]
  range = 1..10
  closed = 1..=10
  label = 'outer
  field = @name
  static_call = @@create
  method_ref = &:name
