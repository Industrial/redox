{- A fenced comment,
   spanning lines, and nesting: {- like this -} -}

-- | Outer doc comment.
-- ! Inner doc comment.
main : ()
main =
  -- A line comment, then every literal kind.
  count = 1_000_000
  hexed = 0xDEAD_beef
  ratio = 2.5e-3
  ch = 'x'
  byte = b'\n'
  raw = r#"no \escapes here"#
  cstr = c"nul terminated"
  repeated = [0u8; 4]
  greeting = "hi #{name}, you owe #{amount:.2}"
  block = """
    indented
      relative
  """
  chain = items |> map (+1) |> filter (> 0)
  maybe = lookup id ?? "none"
  guarded = parse s catch 0
  spread = [0, ...rest, 9]
  range = 1..10
  closed = 1..=10
  label = 'outer
  ascribed = total : u64
  -- Corrected by plan 51. These three lines previously said `\` lambdas and
  -- `$` were "specified and not yet lexed" and left them out on that basis.
  -- Both ship — doc 18 §11.1 names the commit, `0abcdf0` — so the claim was
  -- false and this file was the only thing asserting it. A construct that is
  -- implemented and unexampled is undiscoverable, which is the whole reason
  -- `construct_coverage` exists; `examples/application.sdx` exercises both
  -- for real, and they are lexed here.
  lambda = \n -> n + 1
  applied = twice $ show 7
  field = self.name
  static_call = Self::create
  method_ref = .name
