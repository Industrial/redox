{- A fenced comment,
   spanning lines, and nesting: {- like this -} -}

-- | Outer doc comment.
-- ! Inner doc comment.
main :: ()
main =
  -- A line comment, then every literal kind.
  count = 1_000_000
  hexed = 0xDEAD_beef
  ratio = 2.5e-3
  ch = 'x'
  byte = b'\n'
  raw = r#"no \escapes here"#
  cstr = c"nul terminated"
  repeated = [0u8; 4]
  greeting = "hi #{name}, you owe #{amount:.2}"
  block = """
    indented
      relative
  """
  chain = items |> map (+1) |> filter (> 0)
  maybe = lookup id ?? "none"
  guarded = parse s catch 0
  spread = [0, ...rest, 9]
  range = 1..10
  closed = 1..=10
  label = 'outer
  ascribed = total :: u64
  -- `\` lambdas and `$` are doc 18 §11.2's work, not §11.1's: they are
  -- specified and not yet lexed, so they are absent here rather than
  -- commented-out code pretending otherwise.
  field = self.name
  static_call = Self::create
  method_ref = (|> name)
