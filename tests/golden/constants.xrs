// Doc 03 §13.4's module-scope bindings and doc 18 §2.2's `const fn` — plan
// 16.
//
// §13.4 corrects doc 01 §4.3 twice over: Rust forbids `let` at module scope,
// so every top-level binding is `const` or `static`; and both require an
// explicit type, so §4.3's `PI = 3.14159` "cannot be lowered at all". The
// type goes after the same `::` every other type in Redox uses.
//
// Checked by compiling and running with **zero** rustc output, so a binding
// emitted with the wrong keyword or a missing type does not pass.

const MAX: usize = 1024;

// `static` differs from `const` by one keyword and nothing else, which is why
// one AST node carries both.
static GREETING: &'static str = "hello";

// The visibility markers are doc 03 §9.6's, unchanged — they go before the
// binding's keyword, as they do before every other declaration's.
pub const LIMIT: usize = 8;

pub(crate) const SCALE: u32 = 3;

// §13.4's "the uppercase-name convention is a lint, not semantics" cannot be
// shown here: a lowercase `const` is legal Redox and legal Rust, and rustc
// *warns* about it — and this corpus requires rustc to emit **nothing**. So
// the corpus cannot demonstrate anything whose correct behaviour is a rustc
// warning. `crates/redox-emit/tests/constants.rs` asserts it instead.

// Doc 18 §2.2's `const fn`: a marker between `::` and the spine. It has to be
// consumed there rather than left in the first type, because a type is
// verbatim text and `const u32` is not a Rust type.
const fn square(n: u32) -> u32 {
    n * n
}

// A `const fn` is an ordinary function too, so it composes with everything
// else a signature can say.
const fn scaled(n: u32) -> u32 {
    n * SCALE
}

fn main() {
    println!("{}", MAX);
    println!("{}", GREETING);
    println!("{}", LIMIT);
    println!("{}", square(7));
    println!("{}", scaled(4));
}
