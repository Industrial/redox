// Doc 18 §6's ascription, and §5.2's spaced-versus-tight `::` rule, in the
// example corpus — which is where plan 04's "the output is already
// rustfmt-clean" guarantee is actually measured. The lowering spans three
// lines, and until this file existed nothing checked that it spanned them at
// the right column.

#[derive(Debug)]
enum Oops {
    Bad(u32),
}

use Oops::*;

impl std::fmt::Display for Oops {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Oops::Bad(_0) => write!(f, "bad {}", _0),
        }
    }
}

impl std::error::Error for Oops {}

// Plan 62 leaf 3's **pattern ascription**: the error type is pinned at the arm
// that handles it, which is where an author knows it.
//
// rustc takes a type in a pattern in exactly three places — `let PAT: T = e`,
// let-else, and a function or closure parameter — and a `match` arm is not one
// of them. So this lowers to a `let` at the top of the arm body, which
// annotates the binder the pattern introduced. Plan 62 §11.3 measured both
// halves of the alternative and refuted them: annotating the **scrutinee**
// cannot express this at all, because it would need the `Ok` type named too.
//
// Read **only** in an arm, and that is a parse constraint rather than a
// preference: a pattern cannot take `: T` in general, because a typed binding
// — `total : u64 = 1 + 2` — reads its pattern through the same path and would
// lose its type to it. An arm is unambiguous because `->` ends the type.
fn explain(parsed: Result<i32, Oops>) -> String {
    match parsed {
        Ok(v) => format!("ok {}", v),
        Err(e) => {
            let e: Oops = e;
            format!("error: {}", e)
        }
    }
}

fn parse_one(raw: &str) -> Result<usize, Oops> {
    Ok(raw.len())
}

// Plan 62 leaf 4. A `try` whose `?`s widen through `From` has an ambiguous
// error type and rustc says so — `E0282: type annotations needed`. The
// ascription **at the binding** is what pins it, and §11.1 measured that the
// remedy already shipped: what this adds is the assertion that it does.
//
// Statement-level, because that is where a typed binding lives: module scope
// takes a signature and an equation, so `name : T = value` is not a thing an
// item can be.
fn widened() -> bool {
    let outcome: Result<usize, Oops> = (|| {
        let n = parse_one("ok")?;
        Ok(n + 1)
    })();
    (&outcome).is_ok()
}

fn main() {
    // `e : T` states a type without naming a path.
    let n: u64 = 1;
    println!("{}", n);
    // Ascription is the loosest thing in an expression: the sum is ascribed,
    // not the `2`.
    let total: u64 = 1 + 2;
    println!("{}", total);
    // A tight `::` is still a path, which is the half that would break every
    // existing program if it went wrong.
    println!("{}", i32::max(1, 9));
    // A generic type survives verbatim — doc 03 §14.1 — and the value is an
    // application, because `Some 1` is juxtaposition like everything else.
    let wide: Option<u8> = Some(1);
    // `wide` is `Some` by construction two lines up, so the panic is
    // unreachable — doc 03 §12.7's lint is suppressed rather than argued with,
    // and the attribute is consumed, so the `.xrs` below carries no trace of it.
    println!("{}", wide.unwrap());
    // A multi-line lowering as a macro argument: `println!` keeps the call on
    // one line and lets the block hang, which is the form rustfmt writes.
    println!("{}", {
        let __rdx_t: u64 = 1 + 1;
        __rdx_t
    });
    // Leaf 3's arm, and leaf 4's ascribed `try` block.
    println!("{}", explain(Ok(1)));
    println!("{}", explain(Err(Bad(2))));
    println!("{}", widened());
    ();
}
