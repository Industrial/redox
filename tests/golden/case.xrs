// Doc 18 §2.3's `case … of`, checked by running the generated Rust: an arm
// lowered to the wrong pattern prints the wrong word.
//
// Constructor alternation — `Teen or PreTeen` in §2.3's own example — needs
// §2.4's `data` to have constructors to alternate, so the alternation here is
// over literals. The lowering is the same `|`.

fn label(age: u32) -> &'static str {
    match age {
        n if n > 65 => "senior",
        18..=64 => "adult",
        13 | 14 | 15 => "young",
        0..13 => "child",
        _ => "teen",
    }
}

// A `case` is an expression, so it is a binding's value with no second form.
fn describe(c: char) -> &'static str {
    let kind = match c {
        'a' | 'e' | 'i' | 'o' | 'u' => "vowel",
        _ => "consonant",
    };
    kind
}

// Plan 55 leaf 3: an arm body is an expression, and an **indented block** is
// one — so an arm with statements in it needs no marker. The one-expression
// arms below it stay on one line, because that is what rustfmt does to each,
// and a block arm takes no trailing comma for the same reason.
fn grade(score: u32) -> &'static str {
    match score {
        0 => {
            // A comment inside an arm body, which a
            // collapsed arm would have nowhere to put.
            let base = "none";
            base
        }
        1..=59 => "fail",
        _ => "pass",
    }
}

// An arm body is an expression, and plan 54's assignment is one, so a
// compound assignment is a legal arm body — `RDX0101` before leaf 3, because
// `parse_expr` stops at the `+=` and only a statement read what followed.
// Every arm here is `()`, which is rustc's requirement on a `match` and not
// Redox's.
fn evens(limit: u32) -> u32 {
    let mut count = 0;
    for n in 1..limit {
        match n % 2 {
            0 => count += 1,
            _ => (),
        };
    }
    count
}

fn main() {
    println!("{}", label(80));
    println!("{}", label(30));
    println!("{}", label(14));
    println!("{}", label(5));
    println!("{}", label(17));
    println!("{}", describe('e'));
    println!("{}", describe('z'));
    println!("{}", grade(0));
    println!("{}", grade(10));
    println!("{}", grade(90));
    println!("{}", evens(10));
}
