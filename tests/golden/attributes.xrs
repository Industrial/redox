// Doc 03 §13.2's attributes — plan 18. "Any `#[...]` or `#![...]` line is
// copied through verbatim, so every present and future Rust attribute is
// reachable with no per-attribute work."
//
// Checked by compiling with **zero** rustc output, which is what makes this
// example worth more than its golden: an attribute copied through but
// attached to the *wrong* item is still valid Rust, so only its effect
// distinguishes the two. Every attribute below has an effect that rustc would
// complain about the absence of.

#![allow(clippy::needless_return)]

// `#[derive(…)]` written as an attribute rather than as doc 18 §2.4's
// `deriving` clause. §13.2 is careful that the native spelling is "not a
// replacement", so both reach the same Rust.
#[derive(Debug, Clone)]
struct Point {
    x: f64,
    y: f64,
}

// A `deriving` clause on a `newtype`, which is where plan 53's
// `#[repr(transparent)]` has to slot in. The order is fixed and this golden
// is the only thing holding it: the `deriving`-derived `#[derive(...)]`
// first, then `#[repr(transparent)]`, then the struct. The layout attribute
// sits closest to the struct it describes and the derives stay grouped above
// it; rustfmt reorders neither.
//
// **A native `#[derive(...)]` here as well would not be rustfmt-clean**, and
// that is why it is not here. Measured: rustfmt's `merge_derives` defaults to
// true, so
//
//     #[derive(PartialEq)]       becomes   #[derive(PartialEq, Debug, Clone)]
//     #[derive(Debug, Clone)]              #[repr(transparent)]
//     #[repr(transparent)]                 struct Tally(u32);
//
// and `generated_rust_is_rustfmt_clean` goes red. The combination is legal,
// compiles, and keeps a deterministic order — `crates/redox-emit/tests/attributes.rs`
// asserts all three attributes in sequence, where rustfmt does not run. It
// cannot appear in an *example*, because emitting one merged `#[derive]`
// would mean reading `derive` out of verbatim attribute trivia and splicing
// the `deriving` names into it, which is exactly the per-attribute work doc
// 03 §13.2 designed attributes to avoid. Plan 53 criterion 4 asked for this
// in a golden; the golden it gets is this one, and the native half is a unit
// test.
#[derive(Debug, Clone, PartialEq)]
#[repr(transparent)]
struct Tally(u32);

// A doc comment, an attribute and the item in that order — three trivia and
// one declaration, emitted in source order, which is the first thing plan 18
// §1.3 says trivia buys.
/// The squared magnitude of a point.
#[inline]
fn magnitude(p: &Point) -> f64 {
    p.x * p.x + p.y * p.y
}

// `#[allow(…)]` is only *proven* by a lint that would otherwise fire. A
// lowercase `const` is rustc's `non_upper_case_globals`, which doc 03 §13.4
// says is a lint and not semantics — so this attribute is the reason the
// example compiles silently, and removing it breaks the build.
#[allow(non_upper_case_globals)]
const threshold: f64 = 2.0;

// `Tally`'s derives are what make this line compile: `PartialEq` for the
// comparison, `Debug` for the formatting, and `Clone` because the comparison
// takes one by value. An attribute that reaches the `.xrs` but attaches to
// the wrong item is still valid Rust, so a *use* is the only thing that
// distinguishes the two — the same argument this file opens with.
fn counted(n: u32) -> String {
    format!("{} {:?}", Tally(n) == Tally(7), Tally(n).clone())
}

// An attribute with a string and an `=` inside it, which is the form §13.2's
// own `#[serde(rename = "id")]` example uses. `must_use` is in `core`, so
// this needs no dependency to prove the shape round-trips.
#[must_use = "a magnitude is worth looking at"]
fn scaled(p: &Point) -> f64 {
    magnitude(p) * threshold
}

fn main() {
    let p = Point { x: 3.0, y: 4.0 };
    println!("{}", magnitude(&p));
    println!("{}", scaled(&p));
    println!("{}", counted(7));
    println!("{}", counted(3));
}
