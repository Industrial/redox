// Precedence is checked by arithmetic: a wrong tree is a wrong number.
fn main() {
    // 2 + (3 * 4) = 14, not (2 + 3) * 4 = 20
    println!("{}", 2 + 3 * 4);
    // Left-associative: (10 - 3) - 2 = 5, not 10 - (3 - 2) = 9
    println!("{}", 10 - 3 - 2);
    // Parentheses override: (2 + 3) * 4 = 20
    println!("{}", (2 + 3) * 4);
    // Comparison is looser than arithmetic: (1 + 1) == 2
    println!("{}", 1 + 1 == 2);
    // `&&` is looser than `==`: (1 == 1) && (2 == 2)
    println!("{}", 1 == 1 && 2 == 2);
    // Shifts bind looser than arithmetic: 1 << (1 + 1) = 4
    println!("{}", 1 << 1 + 1);
    // Unary binds tighter than binary: (-3) + 10 = 7
    println!("{}", -3 + 10);
    // A typed binding, a method call, and a path
    let total: i32 = 40 + 2;
    println!("{}", total);
    println!("{}", "done".len());
    println!("{}", i32::max(1, 9));
    ();
}
