// Doc 18 §3.2's comprehension, with doc 30 §3.2's generator word: `in`, not
// `<-`. Doc 30 §4.2 records this as the conversion's real aesthetic loss —
// `[ x | x <- xs ]` was the one position where doc 18's borrowing of `<-` was
// faithful to Haskell, and it is given up to free the token for `await`.
//
// The comprehension and the list literal it shares its brackets
// with, checked by running the generated Rust: a guard applied to the wrong
// binder, or a generator nested the wrong way round, prints the wrong count.

fn main() {
    // A list literal is Rust's array literal, unchanged.
    let xs = [1, 2, 3, 4];
    println!("{}", xs.len());

    // An ascribed list literal is doc 18 §6's third lowering: the container is
    // named in the ascription, so the value is `C::from([…])`.
    let owned = {
        let __rdx_t: Vec<i32> = Vec::from([1, 2, 3]);
        __rdx_t
    };
    println!("{}", owned.len());

    // One generator. `collect` carries no turbofish, so the type comes from the
    // ascription — which is §3.2's own spelling.
    let doubled: Vec<i32> = xs.into_iter().map(|n| n * 2).collect();
    println!("{}", {
        let __rdx_t: i32 = doubled.iter().sum();
        __rdx_t
    });

    // A guard. `filter_map` hands the closure the *value*, so the guard reads
    // as written — §3.2's own lowering uses `filter`, whose closure receives a
    // reference and so needs a `*` Voltaic cannot know to insert.
    let odd: Vec<i32> = xs
        .into_iter()
        .filter_map(|n| if n % 2 == 1 { Some(n) } else { None })
        .collect();
    println!("{}", odd.len());

    // Two generators and a guard, which is §3.2's own example. The source is a
    // range, so the receiver needs its parentheses: `1..3.into_iter()` would
    // be `1..(3.into_iter())`.
    let pairs: Vec<i32> = (1..4)
        .into_iter()
        .flat_map(move |x| {
            (1..4)
                .into_iter()
                .filter_map(move |y| if x != y { Some(x * y) } else { None })
        })
        .collect();
    println!("{}", pairs.len());

    // A set, which is the whole of what doc 03's deleted set literal did.
    let seen: std::collections::HashSet<i32> = xs.into_iter().map(|c| c).collect();
    println!("{}", seen.len());
    ();
}
