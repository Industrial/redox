-- A macro invocation. UNREACHABLE: plan 45 §1.5, recorded in doc 03 §18.
--
-- Doc 18 §7 retired `!` as a suffix and left it meaning boolean negation, so
-- `name!` has no spelling. Measured across six forms — bare, parenthesised,
-- ascribed, as a function body, `vec![…]` and `format! "…"` — all rejected,
-- while `std::vec::Vec::new ()` is accepted, so paths work and macros do not.
--
-- `assert! true` only appears to work: it reads as the `assert` keyword
-- applied to `!true`.
--
-- The nearest working thing is inline Rust, which is how doc 01 §26's "Rust
-- macros" requirement is met rather than outstanding — and why this needs a
-- spelling decision in doc 03 rather than an implementation.

main :: ()
main =
  xs = vec![1, 2, 3]
  print (xs.len ())
