import crate::expr_text::can_drop_paren::can_drop_paren
import crate::expr_text::expr_text
import redox_ast::Expr

-- | One side of a binary expression, parenthesised only where precedence needs
-- | it.
-- |
-- | `required` is the power this side must bind at: the operator's own power on
-- | the left, one rung tighter on the right, because every binary operator in
-- | Redox is left-associative. That asymmetry is what keeps `a - (b - c)` from
-- | losing its parentheses while `(a - b) - c` loses them correctly.
export(crate) operand : &Expr -> u8 -> usize -> &str -> String
operand expr required indent source = case expr of
  -- An author's parenthesis, judged against this position.
  Expr::Paren { .. } -> expr_text expr required indent source
  -- Anything else already *is* the operand. It needs parentheses when it
  -- binds looser than the position demands — which is the same question
  -- `can_drop_paren` answers, asked of an expression that has none yet.
  --
  -- A **guard on a wildcard**, where the Rust wrote `_ if …`: Redox spells an
  -- arm guard with the bar, doc 18 §2.3's *"single highest-yield token in the
  -- redesign"*.
  _ | can_drop_paren expr required -> expr_text expr required indent source
  _ -> format! \-> "(#{(expr_text expr 0 indent source)})"
