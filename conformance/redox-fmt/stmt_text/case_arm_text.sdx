import crate::expr_text::expr_text
import crate::pattern_text::pattern_text
import crate::stmt_text::block_text::block_text
import crate::stmt_text::condition_text::condition_text
import crate::stmt_text::indent_text::indent_text
import redox_ast::{CaseArm, Expr}

-- | One `case` arm — `pattern -> body`, with an optional guard.
-- |
-- | §3 row 7: **one space after the `->`**, never padding to align several
-- | arms' bodies. The plan's reason is that alignment breaks on the next edit;
-- | the stronger one is that it makes one arm's change show up as a diff in
-- | every other arm.
-- |
-- | The guard is a full condition, so `n | n > 65 -> "senior"` and
-- | `y | Some (Some v) = y -> v` are one form with different operands.
-- |
-- | # A block body prints with no marker, which is what migrated `-> do`
-- |
-- | Plan 55 leaf 3 made an indented block an arm body, and it was the same
-- | node as `-> do` — `Expr::Block` with no label — because the two spellings
-- | meant the same thing and emitted the same Rust. The parser could not tell
-- | them apart, so this printer chose the marker-free form and `redox fmt`
-- | *was* the migration (doc 02 §4.5). Leaf 7 then retired the keyword, so
-- | there is one spelling again and this arm is simply how a block body
-- | prints.
-- |
-- | A **labelled** block prints its label, which is the one thing the marker
-- | carried that survives (§1.7) — and it is `expr_text`'s arm, not this
-- | one's, because a labelled arm body is not a shape the surface has.
export(crate) case_arm_text : &CaseArm -> usize -> &str -> String
case_arm_text arm indent source =
  r#guard = case &arm.r#guard of
    Some condition -> format! \-> " | #{(condition_text condition indent source)}"
    None -> String::new ()
  -- Plan 62 leaf 3's pattern ascription. The formatter prints it back because
  -- it reads the same tree the emitter does, and a field it ignored would be a
  -- field `redox fmt` **deleted** — plan 61 §11.6's rule about two consumers,
  -- in the direction that loses source rather than the one that rewrites it.
  ty = case &arm.ty of
    Some ty -> format! \-> " : #{ty.text}"
    None -> String::new ()
  pad = indent_text indent
  pattern = pattern_text (&arm.pattern)
  head = format! \-> "#{pad}#{pattern}#{ty}#{r#guard} ->"
  case &arm.body of
    Expr::Block { label = None, body, .. } ->
      format! \-> "#{head}\n#{(block_text body (indent + 1) source)}"
    body -> format! \-> "#{head} #{(expr_text body 0 indent source)}"
